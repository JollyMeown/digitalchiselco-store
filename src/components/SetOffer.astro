---
// Sets on the product page, from bundle_items (Admin > Bundles).
//   single design that belongs to a set -> "Complete the set": every design
//     in it for the set price, with the saving against buying them one by one.
//   the set itself -> "What's included": each design, in order, linked.
// Built for the 14 Stations of the Cross (2026-09-26); works for any bundle
// whose source designs are attached. bundle_items is admin-only under RLS, so
// this reads with the server client. Prices go through pricing() like every
// other price on the page.
import { supabaseAdmin } from '../lib/supabase';
import { pricing, money } from '../lib/pricing';
import { img } from '../lib/img';
interface Props { productId: string; isBundle: boolean; discount: number; where: 'buybox' | 'contents' }
const { productId, isBundle, discount, where } = Astro.props;
const clean = (t: string) => String(t || '').split('|')[0].trim();
type P = { id: string; slug: string; title: string; image_url: string | null; price_usd: number; active: boolean };

let set: { bundle: P; items: P[] } | null = null;
try {
  const db = supabaseAdmin();
  let bundleId: string | null = isBundle ? productId : null;
  if (!isBundle) {
    const { data: links } = await db.from('bundle_items').select('bundle_product_id').eq('source_product_id', productId);
    const ids = (links || []).map((l: any) => l.bundle_product_id);
    if (ids.length) {
      const { data: bs } = await db.from('products').select('id').in('id', ids).eq('active', true).limit(1);
      bundleId = bs?.[0]?.id || null;
    }
  }
  if (bundleId) {
    const [{ data: b }, { data: rows }] = await Promise.all([
      db.from('products').select('id, slug, title, image_url, price_usd, active').eq('id', bundleId).maybeSingle(),
      db.from('bundle_items').select('sort_order, products:source_product_id(id, slug, title, image_url, price_usd, active)').eq('bundle_product_id', bundleId).order('sort_order'),
    ]);
    const items = (rows || []).map((r: any) => r.products).filter(Boolean) as P[];
    if (b?.active && items.length >= 2) set = { bundle: b as P, items };
  }
} catch { /* optional block */ }

const show = set && ((where === 'buybox' && !isBundle) || (where === 'contents' && isBundle));
const setPrice = set ? pricing(set.bundle.price_usd, discount).price : 0;
const separately = set ? set.items.reduce((s, it) => s + pricing(it.price_usd, discount).price, 0) : 0;
const save = separately - setPrice;
const name = set ? clean(set.bundle.title) : '';
---
{show && set && where === 'buybox' && (
  <div class="mt-5 rounded-lg border border-bronze-600/30 bg-[#FAEEDA] p-4">
    <p class="text-[11px] tracking-[0.14em] uppercase text-bronze-700 font-semibold">Complete the set</p>
    <p class="mt-1 text-sm text-ink-800">
      This design is one of <strong>{set.items.length}</strong> in <a href={`/product/${set.bundle.slug}`} class="underline text-bronze-800">{name}</a>.
      Get all {set.items.length} for <strong>{money(setPrice)}</strong>
      {save > 1 && <> instead of {money(separately)} one by one, <strong>save {money(save)}</strong></>}.
    </p>
    <div class="mt-3 flex gap-1.5 overflow-x-auto pb-1" aria-hidden="true">
      {set.items.slice(0, 14).map((it) => (
        <img src={img(it.image_url, { w: 96, square: true, q: 65 })} alt="" width="48" height="48" loading="lazy" class={`w-12 h-12 rounded object-cover border ${it.id === productId ? 'border-bronze-600 ring-2 ring-bronze-600/40' : 'border-black/10'}`} />
      ))}
    </div>
    <div class="mt-3 flex gap-2">
      <button class="add-to-cart flex-1 bg-bronze-600 text-cream py-2.5 rounded-md text-sm font-medium hover:bg-bronze-700 transition"
        data-id={set.bundle.id} data-slug={set.bundle.slug} data-title={name} data-price={setPrice} data-img={set.bundle.image_url || ''} data-label="Add the set to cart">
        Add the set to cart
      </button>
      <a href={`/product/${set.bundle.slug}`} class="px-3 py-2.5 rounded-md border border-bronze-600/40 text-sm text-bronze-800 hover:bg-white">See the set</a>
    </div>
  </div>
)}
{show && set && where === 'contents' && (
  <section class="mt-12" aria-labelledby="set-contents">
    <h2 id="set-contents" class="text-xl mb-1">What's included: {set.items.length} designs</h2>
    <p class="text-sm text-ink-700/70 mb-4">
      Each design on its own adds up to {money(separately)}. In this set: {money(setPrice)}{save > 1 && <>, you save {money(save)}</>}.
    </p>
    <ol class="grid grid-cols-3 sm:grid-cols-5 lg:grid-cols-7 gap-3">
      {set.items.map((it, i) => (
        <li>
          <a href={`/product/${it.slug}`} class="block group">
            <img src={img(it.image_url, { w: 240, square: true, q: 72 })} alt={clean(it.title)} width="120" height="120" loading="lazy" class="w-full aspect-square object-cover rounded-lg border border-black/10 group-hover:shadow" />
            <span class="mt-1 block text-[11px] leading-tight text-ink-800 line-clamp-2"><span class="text-bronze-700 font-semibold">{i + 1}.</span> {clean(it.title).replace(/\s*STL$/i, '')}</span>
          </a>
        </li>
      ))}
    </ol>
  </section>
)}
