---
// One "Carved by you" entry: the maker's story on the left, the finished
// carving shown in FULL (object-contain, never cropped) on the right, on a
// warm cream panel that matches the brand. Stacks (image on top, story below)
// on mobile, sits side by side from sm+.
import { img as sized } from '../lib/img';
interface Props { creation: any; }
const { creation: c } = Astro.props;
const linkHref = c.products?.slug ? `/product/${c.products.slug}` : (c.product_url || null);
// Drop a leading "Customer Spotlight: …" line if present; keep the rest as the story.
const story = (c.description || '').replace(/^\s*customer spotlight:[^\n]*\n+/i, '').trim();
// 660px wide (the panel is 336px on desktop, 2x for sharp screens), never
// the raw customer upload.
const img = (c.gallery && c.gallery[0]) ? sized(c.gallery[0], { w: 660, q: 78 }) : null;
---
<article class="w-[300px] sm:w-[600px] flex-shrink-0 bg-white border border-black/10 rounded-xl overflow-hidden flex flex-col sm:flex-row shadow-sm">
  <!-- Story — left on desktop, below the image on mobile -->
  <div class="sm:w-[44%] p-5 flex flex-col justify-center order-2 sm:order-1">
    <div class="text-[10px] tracking-[0.18em] text-bronze-600 uppercase mb-1.5">★ Maker spotlight</div>
    <h3 class="font-serif text-lg sm:text-xl text-bronze-800 leading-tight">{c.name}</h3>
    {story && <p class="mt-2 text-xs sm:text-sm text-ink-700/85 leading-relaxed line-clamp-6">{story}</p>}
    {linkHref && (
      <a href={linkHref} class="mt-3 inline-block text-xs font-medium text-bronze-700 hover:underline whitespace-nowrap">
        Shop this design →
      </a>
    )}
  </div>
  <!-- Image — full, never cropped — right on desktop, top on mobile -->
  <div class="sm:w-[56%] bg-cream flex items-center justify-center p-2.5 order-1 sm:order-2 min-h-[180px] relative">
    {img
      ? <img src={img} alt={`Bas-relief carving by ${c.name}`} loading="lazy" class="cbv-photo w-full max-h-[320px] object-contain rounded-lg" />
      : <div class="text-bronze-600/40 font-serif text-sm">{c.name}</div>}
    {c.video_url && (
      // The maker's own clip of the carve (migration 151). Nothing loads until
      // the button is pressed; the photo stays the face of the card.
      <button type="button" class="cbv-play absolute bottom-4 left-4 inline-flex items-center gap-1.5 rounded-full bg-[#2e1d10]/85 text-[#FAEEDA] text-xs font-semibold px-3 py-1.5 hover:bg-[#2e1d10] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#FAEEDA]"
        data-video={c.video_url} aria-label={`Watch ${c.name}'s carving being cut`}>
        <span aria-hidden="true">▶</span> Watch it carve
      </button>
    )}
  </div>
</article>

<script is:inline>
  // One listener for every card (the marquee duplicates cards for its loop).
  // A pressed button swaps the photo for the video; while it plays, the
  // scrolling strip holds still so the clip does not slide away on a phone.
  (function () {
    if (window.__cbvVideo) return; window.__cbvVideo = 1;
    document.addEventListener('click', function (e) {
      var b = e.target.closest && e.target.closest('.cbv-play'); if (!b) return;
      var box = b.parentElement, photo = box.querySelector('.cbv-photo');
      var v = document.createElement('video');
      v.src = b.dataset.video; v.controls = true; v.autoplay = true; v.muted = true; v.playsInline = true; v.preload = 'auto';
      if (photo) v.poster = photo.currentSrc || photo.src;
      v.className = 'w-full max-h-[320px] object-contain rounded-lg bg-black';
      var track = box.closest('.dcc-marquee-track');
      var hold = function (on) { if (track) track.style.animationPlayState = on ? 'paused' : ''; };
      v.addEventListener('play', function () { hold(true); });
      v.addEventListener('pause', function () { hold(false); });
      v.addEventListener('ended', function () { hold(false); });
      if (photo) photo.replaceWith(v); else box.prepend(v);
      b.remove();
    });
  })();
</script>
