---
import type { ProductCard } from '../lib/queries';
import { pricing, money, DEFAULT_DISCOUNT } from '../lib/pricing';
import { img } from '../lib/img';
interface Props { product: ProductCard; discount?: number; eager?: boolean; }
const { product, discount = DEFAULT_DISCOUNT, eager = false } = Astro.props;
const { price, original, percent } = pricing(product.price_usd, discount);
const title = product.title.split('|')[0].trim();
// Right-sized card images. The catalog was serving the raw upload into a
// 400px tile: two 3 MB PNGs on one page, 12.7 MB in total, Lighthouse 66.
// The product page and the feeds already went through img(); the card, which
// every grid on the site uses, did not. Square crop so the tile is always the
// subject, three widths so a phone never downloads the desktop variant.
const src = img(product.image_url, { w: 400, square: true, q: 78 });
const srcset = [400, 600, 800].map((w) => `${img(product.image_url, { w, square: true, q: 78 })} ${w}w`).join(', ');
---
<div class="group border border-black/10 rounded-md overflow-hidden hover:shadow-md transition flex flex-col bg-white">
  <a href={`/product/${product.slug}`} class="relative block aspect-square bg-cream overflow-hidden">
    {product.image_url ? (
      <img src={src} srcset={srcset} sizes="(min-width: 1024px) 25vw, (min-width: 640px) 33vw, 50vw"
           alt={`${title} bas-relief STL design`} loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : undefined}
           decoding="async" width="400" height="400"
           class="w-full h-full object-cover group-hover:scale-[1.03] transition" />
    ) : (
      <div class="w-full h-full flex items-center justify-center text-bronze-600/40 text-xs p-3 text-center">{title}</div>
    )}
    {/* A real buyer's carving, from an approved photo review, fades in on
        hover over the render. A real carve on a real wall outsells a render,
        and this is what the 150-point photo reward exists to collect. */}
    {product.customer_photo_url && (
      <>
        <img src={img(product.customer_photo_url, { w: 400, square: true, q: 78 })} alt={`${title}, carved by a customer`} loading="lazy" decoding="async" width="400" height="400"
             class="absolute inset-0 w-full h-full object-cover opacity-0 group-hover:opacity-100 transition-opacity duration-300" />
        <span class="absolute bottom-2 left-2 text-[10px] font-medium bg-white/90 text-bronze-800 rounded px-1.5 py-0.5 shadow-sm">📷 carved by a customer</span>
      </>
    )}
    {product.is_bundle && (
      <span class="absolute top-2 left-2 inline-flex items-center gap-1 bg-[#FAC775] text-bronze-900 text-[10px] font-medium tracking-wider uppercase px-2 py-0.5 rounded shadow-sm">
        <span aria-hidden="true">🔥</span> Bundle
      </span>
    )}
    <button type="button" class="wish-btn absolute top-2 right-2 w-8 h-8 rounded-full bg-white/85 backdrop-blur flex items-center justify-center text-base shadow-sm hover:scale-110 transition"
      aria-label="Save to favorites" data-wish-id={product.id} data-wish-slug={product.slug} data-wish-title={title}
      data-wish-price={price} data-wish-img={product.image_url || ''}>
      <span class="wish-icon">🤍</span>
    </button>
  </a>
  <div class="p-3 flex flex-col flex-1">
    <a href={`/product/${product.slug}`} class="block">
      <h3 class="text-sm leading-snug line-clamp-2 text-ink-800 min-h-[2.5em]">{title}</h3>
    </a>
    {(product.rating_count ?? 0) > 0 && (
      <div class="flex items-center gap-1 mt-0.5" aria-label={`Rated ${product.rating_avg} out of 5`}>
        <span class="text-yellow-500 text-xs leading-none" aria-hidden="true">
          {'★'.repeat(Math.round(Number(product.rating_avg) || 0))}<span class="text-ink-700/25">{'★'.repeat(5 - Math.round(Number(product.rating_avg) || 0))}</span>
        </span>
        <span class="text-[11px] text-ink-700/50">({product.rating_count})</span>
      </div>
    )}
    <div class="mt-1 flex items-center gap-2 flex-wrap">
      <span class="text-bronze-600 text-sm font-medium" data-usd={price}>{money(price)}</span>
      {percent > 0 && <>
        <span class="text-ink-700/40 text-xs line-through">{money(original)}</span>
        <span class="text-[10px] text-green-700 font-medium">{percent}% off</span>
      </>}
    </div>
    <button class="add-to-cart mt-2 w-full text-xs border border-bronze-600 text-bronze-700 py-1.5 rounded hover:bg-bronze-600 hover:text-cream transition"
      data-id={product.id} data-slug={product.slug} data-title={title} data-price={price} data-img={product.image_url || ''}>
      Add to cart
    </button>
  </div>
</div>
