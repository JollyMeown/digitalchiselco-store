---
import Logo from './Logo.astro';
import SocialProof from './SocialProof.astro';
import { getCategories, getSettings } from '../lib/queries';
// desk: 'none' → mobile drawer only (the logo already links Home);
// desk: 'xl'   → desktop nav only from 1280px up (keeps the row from
//                crushing the search box on smaller desktops).
const links = [
  { href: '/', label: 'Home', desk: 'none' },
  { href: '/collections', label: 'Collections' },
  { href: '/catalog', label: 'Catalog' },
  { href: '/designs', label: 'Themes', desk: 'none' },
  { href: '/quiz', label: 'Design finder', desk: 'none' },
  { href: '/bundle-builder', label: '5 for $25' },
  { href: '/gift-cards', label: 'Gift Cards' },
  { href: '/free', label: 'Free files' },
  { href: '/laser-studio', label: 'Laser Studio', desk: 'xl' },
  { href: '/about', label: 'Our story', desk: 'xl' },
  { href: '/blog', label: 'Blog', desk: 'xl' },
  { href: '/requests', label: 'Request a design', desk: 'xl' },
  { href: '/account', label: 'User Portal' },
];
const q = Astro.url.searchParams.get('q') ?? '';
const categories = await getCategories();
// Live Etsy numbers (refreshed daily by scripts/etsy_stats_sync.mjs)
const hs = await getSettings();
---
<div class="bg-bronze-800 text-cream text-xs text-center py-1.5">
  Instant digital download · Commercial use included · {Number(hs.rating) || 4.9}★ from {Number(hs.reviews_count).toLocaleString()} reviews
</div>
<header class="sticky top-0 bg-white z-30 border-b border-black/10">
  <nav class="flex items-center gap-3 px-4 sm:px-6 py-3 max-w-7xl mx-auto">
    <!-- Hamburger: visible on mobile/tablet only -->
    <button id="dcc-menu-open" class="lg:hidden shrink-0 text-bronze-700 text-2xl leading-none w-9 h-9 -ml-1 rounded hover:bg-cream" aria-label="Open menu" aria-controls="dcc-drawer" aria-expanded="false">☰</button>
    <div class="shrink-0"><Logo /></div>
    <!-- Search flexes, but never below 190px — the guaranteed floor keeps the
         nav links (shrink-0 below) from ever overlapping it. -->
    <form action="/search" method="get" role="search" class="dcc-search relative hidden md:flex flex-1 min-w-[190px] max-w-sm xl:max-w-md mx-1">
      <input type="search" name="q" value={q} placeholder="Search STL files…" aria-label="Search STL files" autocomplete="off"
        class="min-w-0 flex-1 px-4 py-2 text-sm rounded-l-md border border-r-0 border-black/15 focus:outline-none focus:border-bronze-600" />
      <button class="shrink-0 bg-bronze-600 text-cream px-4 rounded-r-md text-sm" aria-label="Search">Search</button>
      <div class="dcc-suggest hidden absolute top-full left-0 right-0 mt-1 bg-white border border-black/10 rounded-lg shadow-xl z-50 overflow-hidden"></div>
    </form>
    <!-- Desktop nav links + cart: pinned right, never shrinks. Secondary links
         (Laser Studio / Our story / Blog) appear from xl so the row always fits. -->
    <div class="hidden lg:flex items-center gap-3 text-sm text-ink-700 ml-auto whitespace-nowrap shrink-0">
      {links.filter((l) => l.desk !== 'none').map((l) => <a href={l.href} class={`hover:text-bronze-600 ${l.href === '/free' ? 'text-bronze-600' : ''} ${l.desk === 'xl' ? 'hidden xl:inline' : ''}`}>{l.label}</a>)}
      <a href="/membership" class="hidden xl:inline-block text-bronze-600 font-medium" aria-label="Become a member">Become a member</a>
      <a href="/favorites" class="font-medium text-ink-800 hover:text-bronze-600" aria-label="Wishlist"><span class="text-red-500">❤</span><span class="wish-count text-bronze-600 font-medium"></span></a>
      <a href="/cart" class="font-medium text-ink-800 hover:text-bronze-600" aria-label="Cart">🛒 Cart <span class="cart-count text-bronze-600 font-medium"></span></a>
    </div>
    <!-- Favorites + Cart for mobile/tablet (shown when the desktop nav is hidden). -->
    <a href="/favorites" class="lg:hidden ml-auto shrink-0 font-medium text-ink-800 hover:text-bronze-600" aria-label="Favorites">❤ <span class="wish-count text-bronze-600 font-medium"></span></a>
    <a href="/cart" class="lg:hidden shrink-0 font-medium text-ink-800 hover:text-bronze-600" aria-label="Cart">🛒 <span class="cart-count text-bronze-600 font-medium"></span></a>
  </nav>
  <form action="/search" method="get" role="search" class="dcc-search relative md:hidden px-4 pb-3 flex">
    <input type="search" name="q" value={q} placeholder="Search STL files…" aria-label="Search STL files" autocomplete="off"
      class="flex-1 px-4 py-2 text-sm rounded-l-md border border-r-0 border-black/15 focus:outline-none focus:border-bronze-600" />
    <button class="bg-bronze-600 text-cream px-4 rounded-r-md text-sm">Go</button>
    <div class="dcc-suggest hidden absolute top-full left-4 right-4 mt-1 bg-white border border-black/10 rounded-lg shadow-xl z-50 overflow-hidden"></div>
  </form>
</header>

<!-- Mobile drawer: nav links + category list — same content the desktop header + sidebar show -->
<div id="dcc-drawer-overlay" class="hidden lg:hidden fixed inset-0 bg-black/40 z-40" aria-hidden="true"></div>
<aside id="dcc-drawer" class="lg:hidden fixed top-0 left-0 h-full w-[280px] max-w-[85vw] bg-white shadow-xl z-50 -translate-x-full transition-transform duration-200 overflow-y-auto" role="dialog" aria-modal="true" aria-label="Site navigation">
  <div class="flex items-center justify-between px-4 py-3 border-b border-black/10">
    <span class="font-serif text-bronze-700">Menu</span>
    <button id="dcc-menu-close" class="text-bronze-700 text-2xl leading-none w-9 h-9 rounded hover:bg-cream" aria-label="Close menu">✕</button>
  </div>
  <nav class="py-2 text-sm">
    {links.map((l) => (
      <a href={l.href} class={`block px-4 py-2.5 hover:bg-cream ${l.href === '/free' ? 'text-bronze-600 font-medium' : 'text-ink-800'}`}>{l.label}</a>
    ))}
    <a href="/membership" class="block px-4 py-2.5 text-bronze-600 font-medium hover:bg-cream">Become a member</a>
    <a href="/favorites" class="block px-4 py-2.5 text-ink-800 hover:bg-cream"><span class="text-red-500">❤</span> Wishlist</a>
    <a href="/cart" class="block px-4 py-2.5 text-ink-800 hover:bg-cream">Cart</a>
  </nav>
  <div class="border-t border-black/10 px-4 py-3">
    <h2 class="text-[11px] font-medium text-ink-700/60 uppercase tracking-wide mb-2">Categories</h2>
    <nav class="text-sm space-y-0.5">
      <a href="/catalog" class="block py-1.5 px-2 rounded text-bronze-700 font-medium hover:bg-cream">All designs</a>
      {categories.map((c) => (
        <a href={`/collections/${c.slug}`} class="block py-1.5 px-2 rounded text-ink-700 hover:bg-cream">{c.name}</a>
      ))}
    </nav>
  </div>
</aside>
<SocialProof />
<style is:global>
  /* Heartbeat for saved (red) hearts — gentle continuous pulse, plus a bigger
     pop the moment one is added. Respects reduced-motion preferences. */
  @keyframes dcc-heartbeat { 0%, 100% { transform: scale(1); } 20% { transform: scale(1.18); } 35% { transform: scale(0.94); } 50% { transform: scale(1.1); } 65% { transform: scale(1); } }
  @keyframes dcc-pop { 0% { transform: scale(1); } 40% { transform: scale(1.55); } 70% { transform: scale(0.9); } 100% { transform: scale(1); } }
  .wish-btn .wish-icon, .wish-remove { display: inline-block; transform-origin: center; }
  .wish-btn.is-wished .wish-icon, .wish-remove { animation: dcc-heartbeat 1.6s ease-in-out infinite; }
  .wish-btn.just-wished .wish-icon { animation: dcc-pop 0.6s ease-out; }
  @media (prefers-reduced-motion: reduce) { .wish-btn .wish-icon, .wish-remove { animation: none !important; } }
</style>
<script is:inline>
  function cartCount() { try { return JSON.parse(localStorage.getItem('cart') || '[]').length; } catch { return 0; } }
  function renderCartCount() { const n = cartCount(); document.querySelectorAll('.cart-count').forEach((el) => { el.textContent = n > 0 ? `(${n})` : ''; }); }
  renderCartCount();
  window.addEventListener('cart-changed', renderCartCount);
  window.addEventListener('storage', renderCartCount);

  // ── Wishlist / Favorites (localStorage, no login required) ─────────
  const WISH_KEY = 'dcc_wishlist';
  function wishList() { try { return JSON.parse(localStorage.getItem(WISH_KEY) || '[]'); } catch { return []; } }
  function wishHas(id) { return wishList().some((x) => x.id === id); }
  function wishSave(list) { localStorage.setItem(WISH_KEY, JSON.stringify(list)); window.dispatchEvent(new Event('wish-changed')); }
  function wishToggle(item) {
    const list = wishList(); const i = list.findIndex((x) => x.id === item.id);
    let added;
    if (i >= 0) { list.splice(i, 1); added = false; } else { list.unshift(item); added = true; }
    wishSave(list);
    // record affinity if we know who this is (feeds price-drop / personalization)
    if (added) { const email = localStorage.getItem('dcc_email') || ''; if (email) { try { navigator.sendBeacon('/api/favorite', new Blob([JSON.stringify({ email, product_id: item.id })], { type: 'application/json' })); } catch {} } }
    return added;
  }
  window.DCCWish = { list: wishList, has: wishHas, toggle: wishToggle };
  function renderWishCount() { const n = wishList().length; document.querySelectorAll('.wish-count').forEach((el) => { el.textContent = n > 0 ? `(${n})` : ''; }); }
  function syncWishButtons() {
    const list = wishList(); const ids = new Set(list.map((x) => x.id));
    document.querySelectorAll('.wish-btn[data-wish-id]').forEach((btn) => {
      const on = ids.has(btn.dataset.wishId);
      const icon = btn.querySelector('.wish-icon');
      if (icon) icon.textContent = on ? '❤️' : '🤍';
      btn.setAttribute('aria-pressed', on ? 'true' : 'false');
      btn.classList.toggle('is-wished', on);   // drives the heartbeat animation
    });
  }
  window.dccSyncWishButtons = syncWishButtons;
  renderWishCount();
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', syncWishButtons, { once: true }); else syncWishButtons();
  window.addEventListener('pageshow', () => { renderWishCount(); syncWishButtons(); });
  window.addEventListener('wish-changed', () => { renderWishCount(); syncWishButtons(); });
  window.addEventListener('storage', () => { renderWishCount(); syncWishButtons(); });
  document.addEventListener('click', (e) => {
    const btn = e.target.closest('.wish-btn'); if (!btn) return;
    e.preventDefault(); e.stopPropagation();
    const d = btn.dataset;
    const added = wishToggle({ id: d.wishId, slug: d.wishSlug, title: d.wishTitle, price: Number(d.wishPrice) || 0, img: d.wishImg || '' });
    if (added) { btn.classList.add('just-wished'); setTimeout(() => btn.classList.remove('just-wished'), 700); }
  });

  // ── Instant search typeahead ──────────────────────────────────────
  document.querySelectorAll('.dcc-search').forEach((form) => {
    const input = form.querySelector('input[name="q"]');
    const box = form.querySelector('.dcc-suggest');
    if (!input || !box) return;
    let t, lastQ = '';
    const hide = () => box.classList.add('hidden');
    const render = (items, q) => {
      if (!items.length) { box.innerHTML = `<div class="px-3 py-2 text-sm text-ink-700/60">No matches. Press Enter to search.</div>`; box.classList.remove('hidden'); return; }
      box.innerHTML = items.map((p) => `
        <a href="/product/${p.slug}" class="flex items-center gap-2 px-2.5 py-2 hover:bg-cream border-b border-black/5 last:border-0">
          ${p.image_url ? `<img src="${p.image_url}" width="36" height="36" class="w-9 h-9 rounded object-cover bg-cream shrink-0" alt="" />` : ''}
          <span class="text-sm text-ink-800 line-clamp-1 flex-1">${(p.title || '').replace(/</g, '&lt;')}</span>
          <span class="text-xs text-bronze-600 font-medium">$${Number(p.price || 0).toFixed(2)}</span>
        </a>`).join('') + `<a href="/search?q=${encodeURIComponent(q)}" class="block px-3 py-2 text-sm text-bronze-700 font-medium hover:bg-cream">See all results for “${q.replace(/</g, '&lt;')}” →</a>`;
      box.classList.remove('hidden');
    };
    input.addEventListener('input', () => {
      const q = input.value.trim();
      clearTimeout(t);
      if (q.length < 2) { hide(); return; }
      if (q === lastQ) return; lastQ = q;
      t = setTimeout(() => {
        fetch('/api/search-suggest?q=' + encodeURIComponent(q)).then((r) => r.json()).then((d) => render(d.items || [], q)).catch(hide);
      }, 180);
    });
    input.addEventListener('focus', () => { if (input.value.trim().length >= 2 && box.innerHTML) box.classList.remove('hidden'); });
    document.addEventListener('click', (e) => { if (!form.contains(e.target)) hide(); });
    input.addEventListener('keydown', (e) => { if (e.key === 'Escape') hide(); });
  });

  // ── Mobile drawer (nav + categories) ──────────────────────────────
  const _drawer = document.getElementById('dcc-drawer');
  const _overlay = document.getElementById('dcc-drawer-overlay');
  const _openBtn = document.getElementById('dcc-menu-open');
  const _closeBtn = document.getElementById('dcc-menu-close');
  function openDrawer() {
    _drawer?.classList.remove('-translate-x-full');
    _overlay?.classList.remove('hidden');
    _openBtn?.setAttribute('aria-expanded', 'true');
    document.documentElement.style.overflow = 'hidden';
  }
  function closeDrawer() {
    _drawer?.classList.add('-translate-x-full');
    _overlay?.classList.add('hidden');
    _openBtn?.setAttribute('aria-expanded', 'false');
    document.documentElement.style.overflow = '';
  }
  _openBtn?.addEventListener('click', openDrawer);
  _closeBtn?.addEventListener('click', closeDrawer);
  _overlay?.addEventListener('click', closeDrawer);
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeDrawer(); });

  // Reflect cart membership on every .add-to-cart button (turns green "✓ In cart").
  // Writes only when a value actually changes, so it never triggers the
  // MutationObserver below into a loop and stays cheap.
  function syncCartButtons() {
    let cart = [];
    try { cart = JSON.parse(localStorage.getItem('cart') || '[]'); } catch {}
    const ids = new Set(cart.map((x) => x.id));
    document.querySelectorAll('.add-to-cart[data-id]').forEach((btn) => {
      const inCart = ids.has(btn.dataset.id);
      btn.classList.toggle('in-cart', inCart);
      const label = inCart ? '✓ In cart' : 'Add to cart';
      if (btn.textContent !== label) btn.textContent = label;
    });
  }
  window.dccSyncCartButtons = syncCartButtons;
  // This script sits in the header (top of page), so on a fresh load the product
  // cards below haven't parsed yet — wait for DOMContentLoaded. Also re-sync on
  // bfcache back/forward restores (scripts don't re-run then) and whenever the
  // cart changes or another tab edits it.
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', syncCartButtons, { once: true });
  else syncCartButtons();
  window.addEventListener('pageshow', syncCartButtons);
  window.addEventListener('cart-changed', syncCartButtons);
  window.addEventListener('storage', syncCartButtons);
  // Catch dynamically-inserted cards (homepage marquees, cart upsell) without
  // polling — one rAF-debounced pass per batch of DOM changes.
  let _scbRaf = 0;
  const _scbObserver = new MutationObserver(() => {
    if (_scbRaf) return;
    _scbRaf = requestAnimationFrame(() => { _scbRaf = 0; syncCartButtons(); });
  });
  function _startScbObserver() { if (document.body) _scbObserver.observe(document.body, { childList: true, subtree: true }); }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', _startScbObserver, { once: true });
  else _startScbObserver();

  // Delegated "Add to cart" for any .add-to-cart button site-wide (product cards, etc.)
  document.addEventListener('click', (e) => {
    const btn = e.target.closest('.add-to-cart');
    if (!btn) return;
    e.preventDefault();
    const d = btn.dataset;
    const cart = JSON.parse(localStorage.getItem('cart') || '[]');
    if (cart.find((x) => x.id === d.id)) { window.location.href = '/cart'; return; } // already added → go to cart
    cart.push({ id: d.id, slug: d.slug, title: d.title, price: Number(d.price), img: d.img });
    localStorage.setItem('cart', JSON.stringify(cart));
    window.dispatchEvent(new Event('cart-changed'));
    syncCartButtons();
  });
</script>
