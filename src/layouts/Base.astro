---
import '../styles/global.css';
import { getSettings } from '../lib/queries';
import { jsonLd } from '../lib/jsonld';
import AnnouncementBanner from '../components/AnnouncementBanner.astro';
interface Props { title?: string; description?: string; image?: string; noindex?: boolean; ogType?: string; price?: number; currency?: string; availability?: string; }
const {
  title = 'DigitalChiselCo — Premium STL Files for CNC, Laser & 3D Printing',
  description = 'Hundreds of museum-grade bas-relief STL files for CNC routers, 3D printers and laser engravers. Instant download, commercial use included.',
  image = '/og-default.jpg',
  noindex = false,
  ogType = 'website',
  price,
  currency = 'USD',
  availability = 'in stock',
} = Astro.props;
// Product Rich Pin metadata — emitted only on product pages (ogType === 'product').
const priceAmount = typeof price === 'number' ? price.toFixed(2) : null;
const site = import.meta.env.PUBLIC_SITE_URL || 'https://digitalchiselco.com';
// GA4 — defaults to the project's measurement ID. Override per-environment via
// the Netlify env var PUBLIC_GA_MEASUREMENT_ID (e.g. a staging stream).
const gaId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID || 'G-MB5KF3D03Y';
// Google Ads conversion account (574-282-1599). Public identifier, not a
// secret: it appears in the page source of every site that advertises. Kept
// here rather than in an env var for the same reason the GA id above is, so a
// deploy from a fresh checkout measures correctly without extra setup.
const adsId = import.meta.env.PUBLIC_GOOGLE_ADS_ID || 'AW-18375026540';
// Pinterest Tag (conversion tracking for the approved merchant catalog +
// shopping campaigns). Dormant until PUBLIC_PINTEREST_TAG_ID is set in
// Netlify: get the id from Pinterest Ads -> Conversions -> Tag manager.
const pinTagId = import.meta.env.PUBLIC_PINTEREST_TAG_ID || '';
const canonical = new URL(Astro.url.pathname, site).href;
const ogImage = image.startsWith('http') ? image : new URL(image, site).href;
const settings = await getSettings();
// Active shop-wide sale (auto-applied at checkout) → countdown banner.
let sale: { name: string; percent_off: number; expires_at: string } | null = null;
try {
  const { supabaseAdmin } = await import('../lib/supabase');
  const now = new Date().toISOString();
  const { data: s } = await supabaseAdmin().from('sales')
    .select('name, percent_off, expires_at')
    .eq('active', true).eq('scope', 'all').lte('starts_at', now).gte('expires_at', now)
    .order('percent_off', { ascending: false }).limit(1);
  sale = (s?.[0] as any) ?? null;
} catch { /* banner optional */ }
const faviconUrl = settings.favicon_image_url || '/favicon.svg';
const faviconType = settings.favicon_image_url
  ? (settings.favicon_image_url.endsWith('.svg') ? 'image/svg+xml'
    : settings.favicon_image_url.endsWith('.png') ? 'image/png'
    : settings.favicon_image_url.endsWith('.ico') ? 'image/x-icon'
    : 'image/jpeg')
  : 'image/svg+xml';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    <link rel="icon" type={faviconType} href={faviconUrl} />
    {settings.favicon_image_url && <link rel="apple-touch-icon" href={settings.favicon_image_url} />}
    <meta name="theme-color" content="#854F0B" />
    <!-- Pinterest domain claim verification -->
    <meta name="p:domain_verify" content="eb94c29164f0c191df3c86dfea001abd" />
    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content="DigitalChiselCo" />
    {ogType === 'product' && priceAmount && (
      <>
        {/* Product Rich Pin tags — let Pinterest show live price + availability on organic pins */}
        <meta property="product:price:amount" content={priceAmount} />
        <meta property="product:price:currency" content={currency} />
        <meta property="product:availability" content={availability} />
        <meta property="og:price:amount" content={priceAmount} />
        <meta property="og:price:currency" content={currency} />
      </>
    )}
    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    {/* Preconnect to our image CDN (Supabase Storage) for faster product/category image loads */}
    <link rel="preconnect" href="https://tutalnieozbngrsfywes.supabase.co" crossorigin />
    {/* The font stylesheet was render-blocking: Lighthouse measured 1.3 s of
        every first paint waiting on fonts.googleapis.com before a single word
        could show. Loading it as a print stylesheet and flipping it to `all`
        once fetched lets the page paint in the fallback face immediately;
        display=swap then swaps Fraunces in without a layout jump. The
        <noscript> keeps fonts for the rare browser with scripts off. */}
    <link rel="preload" as="style"
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400..600;1,9..144,400..600&family=Instrument+Sans:wght@400;500;600&display=swap" />
    <link rel="stylesheet" media="print" onload="this.media='all'"
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400..600;1,9..144,400..600&family=Instrument+Sans:wght@400;500;600&display=swap" />
    <noscript>
      <link rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400..600;1,9..144,400..600&family=Instrument+Sans:wght@400;500;600&display=swap" />
    </noscript>
    <!-- First-party pageview beacon (no cookies, no PII — feeds admin Traffic tab) -->
    <script is:inline>
      (function () {
        function trk(o) {
          try {
            var d = JSON.stringify(o);
            if (navigator.sendBeacon) navigator.sendBeacon('/api/track', new Blob([d], { type: 'application/json' }));
            else fetch('/api/track', { method: 'POST', body: d, keepalive: true, headers: { 'content-type': 'application/json' } });
          } catch (_) {}
        }
        // Campaign tag: ?src=reddit-cnc (ours) or standard ?utm_source/utm_campaign.
        // Remembered for the session so the tag survives navigation to other pages.
        var camp = '';
        try {
          var qs = new URLSearchParams(location.search);
          camp = (qs.get('src') || qs.get('utm_campaign') || qs.get('utm_source') || '').slice(0, 60);
          if (camp) sessionStorage.setItem('dcc_camp', camp);
          else camp = sessionStorage.getItem('dcc_camp') || '';
        } catch (_) {}
        // Visitor's own timezone (IANA name) → the admin live screen can show
        // what time it is where they are. No PII beyond what geo already implies.
        var tz = '';
        try { tz = Intl.DateTimeFormat().resolvedOptions().timeZone || ''; } catch (_) {}
        trk({ p: location.pathname, r: document.referrer || '', c: camp, tz: tz });
        // Google ad click. Kept for 90 days, which matches the longest window
        // Google can claim a conversion in, so a sale can always be traced back
        // to the click that paid for it. gbraid/wbraid are the iOS variants.
        try {
          var q2 = new URLSearchParams(location.search);
          var gid = q2.get('gclid') || q2.get('gbraid') || q2.get('wbraid') || '';
          var gsrc = q2.get('gclid') ? 'gclid' : q2.get('gbraid') ? 'gbraid' : q2.get('wbraid') ? 'wbraid' : '';
          if (gid) {
            localStorage.setItem('dcc_gclid', JSON.stringify({ id: gid, src: gsrc, at: Date.now() }));
            trk({ p: location.pathname, t: 'ad_click', gclid: gid, gsrc: gsrc });
          }
        } catch (_) {}
        // Capture a referral code from a shared ?ref= link → auto-applies in cart.
        try {
          var rp = new URLSearchParams(location.search).get('ref');
          if (rp && /^REF-[A-Z0-9]{4,12}$/i.test(rp)) localStorage.setItem('dcc_ref', rp.toUpperCase());
        } catch (_) {}
        document.addEventListener('DOMContentLoaded', function () {
          if (location.pathname.indexOf('/product/') === 0) {
            var b = document.querySelector('.add-to-cart');
            var em = '';
            try { em = localStorage.getItem('buyer_email') || localStorage.getItem('dcc_email') || ''; } catch (_) {}
            trk({ p: location.pathname, t: 'view_product', pid: (b && b.dataset && b.dataset.id) || null, em: em });
          }
        });
        // NOTE: add_to_cart is beaconed by the Header's cart handler (which
        // knows whether an add really happened), not by a blind click listener
        // here — the old listener double-counted every add and also counted
        // clicks on already-in-cart buttons.
      })();
    </script>
    {gaId && (
      <>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}></script>
        <script is:inline define:vars={{ gaId, adsId }}>
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date());
          gtag('config', gaId);
          // Google Ads shares this same tag. Configuring the Ads account here
          // is what lets a click on a Shopping ad be joined to the purchase
          // that follows it; without it the campaign is unmeasurable and the
          // bidding has nothing to learn from.
          if (adsId) gtag('config', adsId);
        </script>
      </>
    )}
    {pinTagId && (
      <script is:inline define:vars={{ pinTagId }}>
        /* Pinterest Tag: base + PageVisit. AddToCart and Checkout are fired
           from the cart/checkout code via window.pintrk when it exists. */
        !function(e){if(!window.pintrk){window.pintrk=function(){window.pintrk.queue.push(Array.prototype.slice.call(arguments))};var n=window.pintrk;n.queue=[],n.version="3.0";var t=document.createElement("script");t.async=!0,t.src=e;var r=document.getElementsByTagName("script")[0];r.parentNode.insertBefore(t,r)}}("https://s.pinimg.com/ct/core.js");
        pintrk('load', pinTagId);
        pintrk('page');
      </script>
    )}
  </head>
  <body class="overflow-x-clip">
    {sale && (
      <div class="bg-[#5E380A] text-[#F5EFE3] text-center text-sm py-2 px-3">
        🔥 <strong>{sale.name}</strong> — {sale.percent_off}% off everything, applied automatically ·
        ends in <span id="dcc-sale-cd" class="font-mono font-medium" data-ends={sale.expires_at}>…</span>
      </div>
    )}
    {sale && (
      <script is:inline>
        (function () {
          var el = document.getElementById('dcc-sale-cd');
          if (!el) return;
          var end = new Date(el.dataset.ends).getTime();
          function tick() {
            var ms = end - Date.now();
            if (ms <= 0) { el.textContent = 'ended'; return; }
            var d = Math.floor(ms / 86400000), h = Math.floor(ms / 3600000) % 24,
                m = Math.floor(ms / 60000) % 60, s = Math.floor(ms / 1000) % 60;
            el.textContent = (d > 0 ? d + 'd ' : '') + h + 'h ' + m + 'm' + (d === 0 ? ' ' + s + 's' : '');
            setTimeout(tick, 1000);
          }
          tick();
        })();
      </script>
    )}
    <AnnouncementBanner />
    <slot />

    <!-- About-to-leave free-pack offer. Free-pack subscribers buy at 13.2%
         (Sep 2026 growth model), so a visitor who leaves without the pack is
         the most expensive exit on the site. Desktop: the cursor leaves the top
         of the window. Phones (never covered before 2026-09-17): a quick
         scroll back up after reading a good part of the page, shown as a
         bottom sheet. Never for known emails, buyers, signed-in users or a
         shopper holding a cart; 14 quiet days after each showing; 3 showings
         per browser at most. Feeds the double-opt-in subscriber flow. -->
    <div id="dcc-exit" role="dialog" aria-modal="true" aria-labelledby="dcc-exit-h" style="position:fixed;inset:0;background:rgba(42,26,14,.55);z-index:60;display:none;align-items:center;justify-content:center;padding:16px;">
      <div id="dcc-exit-card" style="background:#fff;border-radius:14px;max-width:420px;width:100%;padding:28px 24px 22px;text-align:center;position:relative;border:1px solid #E5DDD0;box-shadow:0 20px 50px rgba(42,26,14,.25);">
        <button id="dcc-exit-x" aria-label="Close" style="position:absolute;top:8px;right:10px;width:36px;height:36px;font-size:22px;color:#8a7a66;background:none;border:none;cursor:pointer;">×</button>
        <div style="font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:#854F0B;font-weight:600;">Before you go</div>
        <h2 id="dcc-exit-h" class="font-serif" style="color:#5E380A;font-size:24px;line-height:1.2;margin:6px 0 6px;">5 bas-relief STL files, free</h2>
        <p style="font-size:14px;color:#5b5145;margin:0 0 12px;line-height:1.5;">Full designs, not samples. CNC-tested and ready for your router, laser or 3D printer, and you can sell what you make from them.</p>
        <ul style="list-style:none;padding:0;margin:0 0 14px;font-size:12.5px;color:#5b5145;display:flex;flex-wrap:wrap;justify-content:center;gap:4px 14px;">
          <li>✓ Instant download</li><li>✓ Commercial use</li><li>✓ Unsubscribe anytime</li>
        </ul>
        <form id="dcc-exit-form" style="display:flex;gap:8px;flex-wrap:wrap;">
          <label for="dcc-exit-email" style="position:absolute;left:-9999px;">Email address</label>
          <input id="dcc-exit-email" type="email" required autocomplete="email" inputmode="email" placeholder="you@email.com" style="flex:1 1 180px;min-width:0;padding:12px;border:1px solid #d8cdbb;border-radius:8px;font-size:16px;" />
          <button type="submit" style="flex:1 1 auto;background:#854F0B;color:#F5EFE3;border:none;border-radius:8px;padding:12px 16px;font-size:15px;font-weight:600;cursor:pointer;">Send my files</button>
        </form>
        <p id="dcc-exit-msg" aria-live="polite" style="font-size:12.5px;margin:10px 0 0;color:#666;min-height:1em;"></p>
        <button id="dcc-exit-no" style="margin-top:4px;background:none;border:none;color:#8a7a66;font-size:12px;text-decoration:underline;cursor:pointer;">No thanks</button>
      </div>
    </div>
    <script is:inline>
      (function () {
        var KEY = 'dcc_exit_seen', SUB = 'dcc_exit_sub', COUNT = 'dcc_exit_n';
        if (/^\/(cart|account|free|admin|checkout|membership|m\/|maker|login|resend-downloads|unsubscribe)/.test(location.pathname)) return;
        try {
          if (localStorage.getItem(SUB)) return;                                   // already has the pack
          if (localStorage.getItem('dcc_email') || localStorage.getItem('buyer_email')) return;  // known to us
          if (JSON.parse(localStorage.getItem('cart') || '[]').length) return;     // shopping: do not distract
          if (Number(localStorage.getItem(COUNT) || 0) >= 3) return;
          if (Date.now() - Number(localStorage.getItem(KEY) || 0) < 14 * 86400000) return;
          for (var i = 0; i < localStorage.length; i++) { if (/^sb-.*-auth-token$/.test(localStorage.key(i) || '')) return; }  // signed in
        } catch (_) { return; }

        var box = document.getElementById('dcc-exit'), card = document.getElementById('dcc-exit-card');
        var start = Date.now(), shown = false;
        var phone = window.matchMedia('(max-width: 767px)').matches || window.matchMedia('(pointer: coarse)').matches;
        function track(t) { try { if (window.dccAction) window.dccAction(t); } catch (_) {} }
        function show(how) {
          if (shown || Date.now() - start < (phone ? 20000 : 8000)) return;
          try { if (JSON.parse(localStorage.getItem('cart') || '[]').length) return; } catch (_) {}
          shown = true;
          try {
            localStorage.setItem(KEY, String(Date.now()));
            localStorage.setItem(COUNT, String(Number(localStorage.getItem(COUNT) || 0) + 1));
          } catch (_) {}
          if (phone) {
            box.style.alignItems = 'flex-end'; box.style.padding = '0';
            card.style.maxWidth = '100%'; card.style.borderRadius = '16px 16px 0 0';
            card.style.paddingBottom = 'calc(20px + env(safe-area-inset-bottom))';
          }
          box.style.display = 'flex';
          track('exit_offer_shown');
          track(how === 'scroll' ? 'exit_offer_mobile' : 'exit_offer_desktop');
        }
        function hide() { box.style.display = 'none'; }
        document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && shown) hide(); });

        if (!phone) {
          document.addEventListener('mouseout', function (e) {
            if (!e.relatedTarget && e.clientY <= 0) show('mouse');
          });
        } else {
          // Reading, then flicking back up toward the address bar: the phone's
          // version of reaching for the close button.
          var maxY = 0, lastY = window.scrollY, lastT = Date.now();
          window.addEventListener('scroll', function () {
            var y = window.scrollY, t = Date.now();
            if (y > maxY) maxY = y;
            var speed = (lastY - y) / Math.max(1, t - lastT);          // px per ms, upward positive
            var readEnough = maxY > Math.max(900, (document.documentElement.scrollHeight - window.innerHeight) * 0.4);
            if (readEnough && speed > 1.2 && maxY - y > 300) show('scroll');
            lastY = y; lastT = t;
          }, { passive: true });
        }

        document.getElementById('dcc-exit-x').addEventListener('click', hide);
        document.getElementById('dcc-exit-no').addEventListener('click', hide);
        box.addEventListener('click', function (e) { if (e.target === box) hide(); });
        document.getElementById('dcc-exit-form').addEventListener('submit', async function (e) {
          e.preventDefault();
          var msg = document.getElementById('dcc-exit-msg');
          var email = document.getElementById('dcc-exit-email').value.trim();
          msg.style.color = '#666';
          msg.textContent = 'Sending...';
          try {
            var res = await fetch('/api/subscribe', { method: 'POST', headers: { 'content-type': 'application/json' },
              body: JSON.stringify({ email: email }) });
            var data = await res.json();
            msg.style.color = res.ok ? '#188038' : '#c00';
            msg.textContent = res.ok ? '✓ Sent. Check your inbox for an email from DigitalChiselCo (and the spam folder, just in case).' : (data.error || 'Something went wrong. Please try again.');
            if (res.ok) {
              track('exit_offer_signup');
              document.getElementById('dcc-exit-form').style.display = 'none';
              document.getElementById('dcc-exit-no').textContent = 'Close';
              try { localStorage.setItem(SUB, '1'); localStorage.setItem('dcc_email', email.toLowerCase()); } catch (_) {}
            }
          } catch (_) { msg.style.color = '#c00'; msg.textContent = 'Network error. Please try again.'; }
        });
      })();
    </script>
    <!-- Organization + WebSite structured data — helps Google build Knowledge Graph
         entries for the brand and enables the sitelinks search box. -->
    <script type="application/ld+json" set:html={jsonLd({
      '@context': 'https://schema.org',
      '@graph': [
        {
          '@type': 'Organization',
          '@id': site + '#org',
          name: 'DigitalChiselCo',
          url: site,
          logo: settings.logo_image_url || (site + '/og-default.jpg'),
          email: settings.admin_email || 'jolly@digitalchiselco.com',
          sameAs: [],
          description: 'Premium bas-relief STL files for CNC routers, laser engravers and 3D printers.',
          // Payment methods our Paddle checkout actually accepts. Google's Shop
          // quality scorecard grades "payment options", and these were not
          // declared anywhere machine-readable.
          paymentAccepted: 'Credit Card, Debit Card, Visa, Mastercard, American Express, PayPal, Apple Pay, Google Pay',
          currenciesAccepted: 'USD, EUR, GBP, CAD, AUD',
        },
        {
          '@type': 'WebSite',
          '@id': site + '#website',
          name: 'DigitalChiselCo',
          url: site,
          publisher: { '@id': site + '#org' },
          potentialAction: {
            '@type': 'SearchAction',
            target: { '@type': 'EntryPoint', urlTemplate: site + '/search?q={search_term_string}' },
            'query-input': 'required name=search_term_string',
          },
        },
      ],
    })} />
  </body>
</html>
