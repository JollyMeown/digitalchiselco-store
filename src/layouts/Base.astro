---
import '../styles/global.css';
import { getSettings } from '../lib/queries';
import { jsonLd } from '../lib/jsonld';
import AnnouncementBanner from '../components/AnnouncementBanner.astro';
interface Props { title?: string; description?: string; image?: string; noindex?: boolean; ogType?: string; price?: number; currency?: string; availability?: string; }
const {
  title = 'DigitalChiselCo — Premium STL Files for CNC, Laser & 3D Printing',
  description = 'Hundreds of museum-grade bas-relief STL files for CNC routers, 3D printers and laser engravers. Instant download, commercial use included.',
  image = '/og-default.jpg',
  noindex = false,
  ogType = 'website',
  price,
  currency = 'USD',
  availability = 'in stock',
} = Astro.props;
// Product Rich Pin metadata — emitted only on product pages (ogType === 'product').
const priceAmount = typeof price === 'number' ? price.toFixed(2) : null;
const site = import.meta.env.PUBLIC_SITE_URL || 'https://digitalchiselco.com';
// GA4 — defaults to the project's measurement ID. Override per-environment via
// the Netlify env var PUBLIC_GA_MEASUREMENT_ID (e.g. a staging stream).
const gaId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID || 'G-MB5KF3D03Y';
const canonical = new URL(Astro.url.pathname, site).href;
const ogImage = image.startsWith('http') ? image : new URL(image, site).href;
const settings = await getSettings();
// Active shop-wide sale (auto-applied at checkout) → countdown banner.
let sale: { name: string; percent_off: number; expires_at: string } | null = null;
try {
  const { supabaseAdmin } = await import('../lib/supabase');
  const now = new Date().toISOString();
  const { data: s } = await supabaseAdmin().from('sales')
    .select('name, percent_off, expires_at')
    .eq('active', true).eq('scope', 'all').lte('starts_at', now).gte('expires_at', now)
    .order('percent_off', { ascending: false }).limit(1);
  sale = (s?.[0] as any) ?? null;
} catch { /* banner optional */ }
const faviconUrl = settings.favicon_image_url || '/favicon.svg';
const faviconType = settings.favicon_image_url
  ? (settings.favicon_image_url.endsWith('.svg') ? 'image/svg+xml'
    : settings.favicon_image_url.endsWith('.png') ? 'image/png'
    : settings.favicon_image_url.endsWith('.ico') ? 'image/x-icon'
    : 'image/jpeg')
  : 'image/svg+xml';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    <link rel="icon" type={faviconType} href={faviconUrl} />
    {settings.favicon_image_url && <link rel="apple-touch-icon" href={settings.favicon_image_url} />}
    <meta name="theme-color" content="#854F0B" />
    <!-- Pinterest domain claim verification -->
    <meta name="p:domain_verify" content="eb94c29164f0c191df3c86dfea001abd" />
    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content="DigitalChiselCo" />
    {ogType === 'product' && priceAmount && (
      <>
        {/* Product Rich Pin tags — let Pinterest show live price + availability on organic pins */}
        <meta property="product:price:amount" content={priceAmount} />
        <meta property="product:price:currency" content={currency} />
        <meta property="product:availability" content={availability} />
        <meta property="og:price:amount" content={priceAmount} />
        <meta property="og:price:currency" content={currency} />
      </>
    )}
    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    {/* Preconnect to our image CDN (Supabase Storage) for faster product/category image loads */}
    <link rel="preconnect" href="https://tutalnieozbngrsfywes.supabase.co" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400..600;1,9..144,400..600&family=Instrument+Sans:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <!-- First-party pageview beacon (no cookies, no PII — feeds admin Traffic tab) -->
    <script is:inline>
      (function () {
        function trk(o) {
          try {
            var d = JSON.stringify(o);
            if (navigator.sendBeacon) navigator.sendBeacon('/api/track', new Blob([d], { type: 'application/json' }));
            else fetch('/api/track', { method: 'POST', body: d, keepalive: true, headers: { 'content-type': 'application/json' } });
          } catch (_) {}
        }
        // Campaign tag: ?src=reddit-cnc (ours) or standard ?utm_source/utm_campaign.
        // Remembered for the session so the tag survives navigation to other pages.
        var camp = '';
        try {
          var qs = new URLSearchParams(location.search);
          camp = (qs.get('src') || qs.get('utm_campaign') || qs.get('utm_source') || '').slice(0, 60);
          if (camp) sessionStorage.setItem('dcc_camp', camp);
          else camp = sessionStorage.getItem('dcc_camp') || '';
        } catch (_) {}
        trk({ p: location.pathname, r: document.referrer || '', c: camp });
        // Capture a referral code from a shared ?ref= link → auto-applies in cart.
        try {
          var rp = new URLSearchParams(location.search).get('ref');
          if (rp && /^REF-[A-Z0-9]{4,12}$/i.test(rp)) localStorage.setItem('dcc_ref', rp.toUpperCase());
        } catch (_) {}
        document.addEventListener('DOMContentLoaded', function () {
          if (location.pathname.indexOf('/product/') === 0) {
            var b = document.querySelector('.add-to-cart');
            var em = '';
            try { em = localStorage.getItem('buyer_email') || localStorage.getItem('dcc_email') || ''; } catch (_) {}
            trk({ p: location.pathname, t: 'view_product', pid: (b && b.dataset && b.dataset.id) || null, em: em });
          }
        });
        // NOTE: add_to_cart is beaconed by the Header's cart handler (which
        // knows whether an add really happened), not by a blind click listener
        // here — the old listener double-counted every add and also counted
        // clicks on already-in-cart buttons.
      })();
    </script>
    {gaId && (
      <>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}></script>
        <script is:inline define:vars={{ gaId }}>
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date());
          gtag('config', gaId);
        </script>
      </>
    )}
  </head>
  <body class="overflow-x-clip">
    {sale && (
      <div class="bg-[#5E380A] text-[#F5EFE3] text-center text-sm py-2 px-3">
        🔥 <strong>{sale.name}</strong> — {sale.percent_off}% off everything, applied automatically ·
        ends in <span id="dcc-sale-cd" class="font-mono font-medium" data-ends={sale.expires_at}>…</span>
      </div>
    )}
    {sale && (
      <script is:inline>
        (function () {
          var el = document.getElementById('dcc-sale-cd');
          if (!el) return;
          var end = new Date(el.dataset.ends).getTime();
          function tick() {
            var ms = end - Date.now();
            if (ms <= 0) { el.textContent = 'ended'; return; }
            var d = Math.floor(ms / 86400000), h = Math.floor(ms / 3600000) % 24,
                m = Math.floor(ms / 60000) % 60, s = Math.floor(ms / 1000) % 60;
            el.textContent = (d > 0 ? d + 'd ' : '') + h + 'h ' + m + 'm' + (d === 0 ? ' ' + s + 's' : '');
            setTimeout(tick, 1000);
          }
          tick();
        })();
      </script>
    )}
    <AnnouncementBanner />
    <slot />

    <!-- Exit-intent free-pack popup: shows once per 14 days when the cursor
         leaves the top of the viewport (desktop). Feeds the double-opt-in
         subscriber flow → nurture drip. -->
    <div id="dcc-exit" style="position:fixed;inset:0;background:rgba(42,26,14,.55);z-index:60;display:none;align-items:center;justify-content:center;padding:16px;">
      <div style="background:#fff;border-radius:14px;max-width:420px;width:100%;padding:28px;text-align:center;position:relative;border:1px solid #E5DDD0;">
        <button id="dcc-exit-x" aria-label="Close" style="position:absolute;top:10px;right:14px;font-size:20px;color:#999;background:none;border:none;cursor:pointer;">×</button>
        <div style="font-size:34px;">🎁</div>
        <h2 class="font-serif" style="color:#5E380A;font-size:22px;margin:8px 0 4px;">Wait — take 5 free STL files</h2>
        <p style="font-size:14px;color:#666;margin:0 0 14px;">Our 5 best-selling bas-relief designs, free. CNC-tested, commercial use included.</p>
        <form id="dcc-exit-form" style="display:flex;gap:8px;">
          <input id="dcc-exit-email" type="email" required placeholder="you@email.com" style="flex:1;padding:10px 12px;border:1px solid #d8cdbb;border-radius:8px;font-size:14px;" />
          <button type="submit" style="background:#854F0B;color:#F5EFE3;border:none;border-radius:8px;padding:10px 16px;font-size:14px;cursor:pointer;">Send them</button>
        </form>
        <p id="dcc-exit-msg" style="font-size:12px;margin:10px 0 0;color:#666;"></p>
      </div>
    </div>
    <script is:inline>
      (function () {
        var KEY = 'dcc_exit_seen', SUB = 'dcc_exit_sub';
        try {
          if (localStorage.getItem(SUB)) return; // already subscribed via popup — never show again
          if (Date.now() - Number(localStorage.getItem(KEY) || 0) < 14 * 86400000) return;
        } catch (_) { return; }
        if (location.pathname.startsWith('/cart') || location.pathname.startsWith('/account') || location.pathname.startsWith('/free') || location.pathname.startsWith('/admin')) return;
        var box = document.getElementById('dcc-exit');
        var shown = false;
        function show() {
          if (shown) return; shown = true;
          try { localStorage.setItem(KEY, String(Date.now())); } catch (_) {}
          box.style.display = 'flex';
        }
        document.addEventListener('mouseout', function (e) {
          if (!e.relatedTarget && e.clientY <= 0) show();
        });
        document.getElementById('dcc-exit-x').addEventListener('click', function () { box.style.display = 'none'; });
        box.addEventListener('click', function (e) { if (e.target === box) box.style.display = 'none'; });
        document.getElementById('dcc-exit-form').addEventListener('submit', async function (e) {
          e.preventDefault();
          var msg = document.getElementById('dcc-exit-msg');
          msg.textContent = 'Sending…';
          try {
            var res = await fetch('/api/subscribe', { method: 'POST', headers: { 'content-type': 'application/json' },
              body: JSON.stringify({ email: document.getElementById('dcc-exit-email').value.trim() }) });
            var data = await res.json();
            msg.style.color = res.ok ? '#188038' : '#c00';
            msg.textContent = res.ok ? '✓ Check your inbox to confirm and get the files!' : (data.error || 'Something went wrong.');
            if (res.ok) { try { localStorage.setItem(SUB, '1'); localStorage.setItem('dcc_email', document.getElementById('dcc-exit-email').value.trim().toLowerCase()); } catch (_) {} }
          } catch (_) { msg.style.color = '#c00'; msg.textContent = 'Network error — please try again.'; }
        });
      })();
    </script>
    <!-- Organization + WebSite structured data — helps Google build Knowledge Graph
         entries for the brand and enables the sitelinks search box. -->
    <script type="application/ld+json" set:html={jsonLd({
      '@context': 'https://schema.org',
      '@graph': [
        {
          '@type': 'Organization',
          '@id': site + '#org',
          name: 'DigitalChiselCo',
          url: site,
          logo: settings.logo_image_url || (site + '/og-default.jpg'),
          email: settings.admin_email || 'jolly@digitalchiselco.com',
          sameAs: [],
          description: 'Premium bas-relief STL files for CNC routers, laser engravers and 3D printers.',
        },
        {
          '@type': 'WebSite',
          '@id': site + '#website',
          name: 'DigitalChiselCo',
          url: site,
          publisher: { '@id': site + '#org' },
          potentialAction: {
            '@type': 'SearchAction',
            target: { '@type': 'EntryPoint', urlTemplate: site + '/search?q={search_term_string}' },
            'query-input': 'required name=search_term_string',
          },
        },
      ],
    })} />
  </body>
</html>
