---
// Custom design service landing page: the link every "can you copy this
// design" reply and the custom-pitch email points to. Post a picture, get a
// quote within 24 hours, pay only on approval. Originals only, never copies.
import Shell from '../layouts/Shell.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { supabaseAdmin } from '../lib/supabase';

const FROM = 30;
const { data: examples } = await supabaseAdmin()
  .from('products').select('title, slug, image_url')
  .eq('active', true).eq('is_bestseller', true).not('image_url', 'is', null).limit(6);
const shots = (examples || []).slice(0, 6);

const FAQ = [
  { q: 'What can I send?', a: 'Anything that shows what you have in mind: a photo, a sketch on paper, artwork, a logo file, or a picture that captures the feel you are after. A phone photo is fine.' },
  { q: 'What kind of picture works best?', a: 'A clear, well lit image with the subject filling most of the frame. Portraits, pets, logos, crests, landscapes and buildings all work well.' },
  { q: 'How much does it cost?', a: `Most single-subject designs start at $${FROM}. Scenes with several elements or very fine detail cost more. You get a firm quote before paying anything.` },
  { q: 'How long does it take?', a: 'Usually 3 to 5 days after you approve the quote. Say so in the form if you have a deadline.' },
  { q: 'What do I receive?', a: 'A watertight STL and a 16-bit greyscale height map, sized for your machine, plus one round of revisions. Files arrive by email and in your account.' },
  { q: 'Can I sell what I carve from it?', a: 'Yes. Custom designs carry the same commercial licence as every design in the shop. You may not resell or share the files themselves.' },
];
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: FAQ.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
const serviceLd = { '@context': 'https://schema.org', '@type': 'Service', name: 'Custom bas-relief STL from your photo', provider: { '@type': 'Organization', name: 'DigitalChiselCo', url: 'https://digitalchiselco.com' }, areaServed: 'Worldwide', offers: { '@type': 'Offer', priceCurrency: 'USD', price: FROM, priceSpecification: { '@type': 'PriceSpecification', minPrice: FROM, priceCurrency: 'USD' } }, description: 'Original bas-relief STL and greyscale modelled from your own photo for CNC carving, laser and 3D printing. Quote within 24 hours, pay on approval.' };
const inputCls = 'w-full px-4 py-2.5 rounded-md border border-bronze-600/30 focus:outline-none focus:border-bronze-600 bg-white text-sm';
---
<Shell
  title={`Custom Bas-Relief STL From Your Photo, from $${FROM} · DigitalChiselCo`}
  description={`Send a photo, get an original carve-ready bas-relief STL made for you. Portraits, pets, logos and scenes for CNC, laser and 3D printing. Quote within 24 hours, from $${FROM}, pay only when you approve.`}
  scrollPastBanner={true}
>
  <Breadcrumbs crumbs={[{ label: 'Custom design' }]} />
  <script type="application/ld+json" set:html={JSON.stringify(serviceLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />

  <article class="max-w-4xl mx-auto">
    <header class="mb-10 max-w-2xl">
      <p class="text-xs tracking-widest text-bronze-600 mb-3">★ CUSTOM DESIGN SERVICE</p>
      <h1 class="font-serif text-4xl sm:text-5xl text-bronze-800 leading-tight">Your photo, carved in relief.</h1>
      <p class="mt-4 text-ink-700 leading-relaxed text-lg">Share a concept, a sketch, artwork or a photo and we model a bas-relief STL from it, ready for your CNC, laser or 3D printer. A firm quote within 24 hours, from <strong>${FROM}</strong>, and nothing is charged until you approve it.</p>
      <div class="mt-5 flex flex-wrap gap-3 text-sm">
        <a href="#request" class="inline-flex items-center bg-bronze-600 hover:bg-bronze-700 text-cream px-5 py-2.5 rounded-md font-medium transition">Post your picture</a>
        <a href="#how" class="inline-flex items-center border border-bronze-600/40 text-bronze-700 hover:bg-cream px-5 py-2.5 rounded-md transition">How it works</a>
      </div>
    </header>

    <section id="how" class="grid sm:grid-cols-3 gap-4 mb-12">
      {[
        ['1', 'Share your idea', 'Upload a photo, sketch or artwork below and tell us the size, the material and anything you want kept or left out.'],
        ['2', 'Approve the quote', 'Within 24 hours you get a firm price and a delivery date by email. Say yes and pay through the usual secure checkout.'],
        ['3', 'Carve it', 'Usually 3 to 5 days later the STL and greyscale are in your inbox and your account, with one revision round included.'],
      ].map(([n, t, b]) => (
        <div class="bg-white border border-black/10 rounded-xl p-5">
          <div class="w-9 h-9 rounded-full bg-bronze-800 text-cream font-serif text-lg flex items-center justify-center mb-3">{n}</div>
          <h2 class="font-serif text-xl text-bronze-800 mb-1">{t}</h2>
          <p class="text-sm text-ink-700/80 leading-relaxed">{b}</p>
        </div>
      ))}
    </section>

    <section class="grid md:grid-cols-2 gap-8 mb-12">
      <div class="bg-[#FAEEDA] border border-bronze-600/25 rounded-xl p-6">
        <h2 class="font-serif text-2xl text-bronze-800 mb-3">What it costs</h2>
        <table class="w-full text-sm">
          <tbody>
            <tr class="border-t border-bronze-600/15"><td class="py-2 text-ink-700">Single subject: a pet, a face, a logo, a crest</td><td class="py-2 text-right font-semibold text-bronze-800 whitespace-nowrap">from ${FROM}</td></tr>
            <tr class="border-t border-bronze-600/15"><td class="py-2 text-ink-700">Detailed subject or two elements</td><td class="py-2 text-right font-semibold text-bronze-800 whitespace-nowrap">from ${FROM + 15}</td></tr>
            <tr class="border-t border-bronze-600/15"><td class="py-2 text-ink-700">Full scene: figures, landscape, lettering</td><td class="py-2 text-right font-semibold text-bronze-800 whitespace-nowrap">from ${FROM + 30}</td></tr>
          </tbody>
        </table>
        <p class="mt-3 text-xs text-ink-700/70">Every request gets its own firm quote before any payment. Rush delivery is possible, ask in the form.</p>
      </div>
      <div>
        <h2 class="font-serif text-2xl text-bronze-800 mb-3">What you get</h2>
        <ul class="text-sm text-ink-700 space-y-2">
          <li class="flex gap-2"><span class="text-bronze-600">✓</span> A relief modelled from your own picture, sketch or concept</li>
          <li class="flex gap-2"><span class="text-bronze-600">✓</span> Watertight STL plus 16-bit greyscale height map, sized for your machine</li>
          <li class="flex gap-2"><span class="text-bronze-600">✓</span> One revision round included</li>
          <li class="flex gap-2"><span class="text-bronze-600">✓</span> Commercial licence: carve and sell the finished pieces</li>
          <li class="flex gap-2"><span class="text-bronze-600">✓</span> Files by email and in your account, forever</li>
        </ul>
        <p class="mt-4 text-sm text-ink-700/80 leading-relaxed">Photos, artwork, sketches and rough ideas are all welcome. If you are not sure what to send, send what you have and we will tell you if we need more.</p>
      </div>
    </section>

    {shots.length > 0 && (
      <section class="mb-12">
        <h2 class="font-serif text-2xl text-bronze-800 mb-1">The kind of relief we model</h2>
        <p class="text-sm text-ink-700/70 mb-4">A few of our own designs, so you know the depth and finish to expect.</p>
        <div class="grid grid-cols-3 sm:grid-cols-6 gap-2">
          {shots.map((p) => <a href={`/product/${p.slug}`} class="block aspect-square rounded-lg overflow-hidden border border-black/10"><img src={p.image_url} alt={p.title.split('|')[0]} loading="lazy" class="w-full h-full object-cover" /></a>)}
        </div>
      </section>
    )}

    <section id="request" class="mb-12 scroll-mt-24">
      <div class="bg-white border border-bronze-600/25 rounded-xl p-6 sm:p-8">
        <h2 class="font-serif text-2xl text-bronze-800 mb-1">Post your picture</h2>
        <p class="text-sm text-ink-700/70 mb-5">Takes a minute. You will hear back within 24 hours with a quote, and nothing is charged until you approve it.</p>
        <form id="cd-form" class="space-y-4" novalidate>
          <div class="grid sm:grid-cols-2 gap-4">
            <div><label for="cd-name" class="text-xs font-medium block mb-1">Your name</label><input id="cd-name" name="name" type="text" maxlength="80" autocomplete="name" placeholder="Your name" class={inputCls} /></div>
            <div><label for="cd-email" class="text-xs font-medium block mb-1">Email for the quote *</label><input id="cd-email" name="email" type="email" required autocomplete="email" placeholder="you@email.com" class={inputCls} /></div>
          </div>
          <div>
            <label for="cd-image" class="text-xs font-medium block mb-1">Your picture, sketch or artwork * <span class="text-ink-700/50 font-normal">JPG, PNG or WebP, up to 8MB</span></label>
            <input id="cd-image" name="image" type="file" accept="image/jpeg,image/png,image/webp" required class="w-full text-sm text-ink-700" />
            <div id="cd-preview" class="mt-2 hidden"><img alt="preview" class="max-h-48 rounded-lg border border-black/10" /></div>
          </div>
          <div><label for="cd-desc" class="text-xs font-medium block mb-1">What should the relief show? *</label>
            <textarea id="cd-desc" name="description" required rows="4" maxlength="2000" placeholder="Who or what is in the picture, what to keep, what to leave out, any lettering you want added, the mood you are after." class={inputCls}></textarea></div>
          <div class="grid sm:grid-cols-3 gap-4">
            <div><label for="cd-size" class="text-xs font-medium block mb-1">Finished size</label><input id="cd-size" name="size" type="text" maxlength="120" placeholder='e.g. 8 x 10 in, 6 mm deep' class={inputCls} /></div>
            <div><label for="cd-material" class="text-xs font-medium block mb-1">Machine and material</label><input id="cd-material" name="material" type="text" maxlength="80" placeholder="e.g. CNC router, maple" class={inputCls} /></div>
            <div><label for="cd-deadline" class="text-xs font-medium block mb-1">Needed by</label><input id="cd-deadline" name="deadline" type="text" maxlength="80" placeholder="optional" class={inputCls} /></div>
          </div>
          <input type="text" name="website" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />
          <div class="flex items-center gap-3 flex-wrap">
            <button type="submit" class="bg-bronze-600 hover:bg-bronze-700 text-cream px-6 py-2.5 rounded-md text-sm font-medium transition">Send for a quote</button>
            <span id="cd-msg" class="text-xs"></span>
          </div>
          <p class="text-[11px] text-ink-700/50">By sending, you confirm the picture is yours to use. We never publish your photo.</p>
        </form>
        <div id="cd-done" class="hidden text-center py-6">
          <div class="text-3xl mb-2">🪵</div>
          <h3 class="font-serif text-2xl text-bronze-800">Got it, thank you.</h3>
          <p class="text-sm text-ink-700/80 mt-2">Your reference is <strong id="cd-ref"></strong>. A confirmation is in your inbox and the quote follows within 24 hours.</p>
          <p class="text-sm mt-4"><a href="/catalog?sort=newest" class="text-bronze-700 underline">See this week's new designs while you wait</a></p>
        </div>
      </div>
    </section>

    <section class="mb-12">
      <h2 class="font-serif text-2xl text-bronze-800 mb-4">Questions people ask</h2>
      <div class="space-y-2">
        {FAQ.map((f) => (
          <details class="bg-white border border-black/10 rounded-lg px-4 py-3">
            <summary class="cursor-pointer text-sm font-medium text-ink-800 select-none">{f.q}</summary>
            <p class="mt-2 text-sm text-ink-700/80 leading-relaxed">{f.a}</p>
          </details>
        ))}
      </div>
    </section>
  </article>

  <script is:inline>
    (function () {
      var form = document.getElementById('cd-form'), msg = document.getElementById('cd-msg');
      var fileInput = document.getElementById('cd-image'), preview = document.getElementById('cd-preview');
      fileInput.addEventListener('change', function () {
        var f = fileInput.files && fileInput.files[0];
        if (!f) { preview.classList.add('hidden'); return; }
        preview.querySelector('img').src = URL.createObjectURL(f); preview.classList.remove('hidden');
      });
      function readFile(file) {
        return new Promise(function (resolve, reject) {
          if (!file || !file.size) return reject(new Error('Please add a picture.'));
          if (file.size > 8 * 1024 * 1024) return reject(new Error('The picture is over 8MB.'));
          var fr = new FileReader(); fr.onload = function () { resolve(fr.result); }; fr.onerror = function () { reject(new Error('Could not read the picture.')); }; fr.readAsDataURL(file);
        });
      }
      form.addEventListener('submit', async function (e) {
        e.preventDefault();
        var btn = form.querySelector('button[type="submit"]');
        var fd = new FormData(form);
        if (!/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(String(fd.get('email') || ''))) { msg.textContent = 'Please enter a valid email.'; msg.className = 'text-xs text-red-600'; return; }
        if (String(fd.get('description') || '').trim().length < 10) { msg.textContent = 'Tell us a little about the design.'; msg.className = 'text-xs text-red-600'; return; }
        btn.disabled = true; msg.textContent = 'Uploading your picture…'; msg.className = 'text-xs text-ink-700/60';
        try {
          var image = await readFile(fd.get('image'));
          var res = await fetch('/api/custom-design/submit', { method: 'POST', headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ name: fd.get('name'), email: fd.get('email'), description: fd.get('description'), size: fd.get('size'), material: fd.get('material'), deadline: fd.get('deadline'), website: fd.get('website'), image: image }) });
          var data = await res.json();
          if (!res.ok || data.error) throw new Error(data.error || 'Could not send.');
          document.getElementById('cd-ref').textContent = data.ref || '';
          form.classList.add('hidden'); document.getElementById('cd-done').classList.remove('hidden');
          try { if (window.dccTrack) window.dccTrack('custom_request'); } catch (_) {}
        } catch (err) { msg.textContent = '✕ ' + (err.message || 'Error.'); msg.className = 'text-xs text-red-600'; btn.disabled = false; }
      });
    })();
  </script>
</Shell>
