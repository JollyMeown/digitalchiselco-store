---
import Shell from '../layouts/Shell.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { getSettings, designCountLabel } from '../lib/queries';
const s = await getSettings();
// Live catalogue count (products_count is the Etsy shop figure and lags the site).
const DESIGNS = await designCountLabel();
// "Studio facts" (2026-10-01, AI-search work): plain, checkable numbers an
// assistant can quote, all read live. Measured = designs whose size, relief
// depth, mesh and base were measured from the actual STL (model_specs).
let measured = 0;
try {
  const { supabaseAdmin } = await import('../lib/supabase');
  const { count } = await supabaseAdmin().from('products').select('id', { count: 'exact', head: true })
    .eq('active', true).eq('is_bundle', false).not('model_specs', 'is', null);
  measured = count || 0;
} catch { /* the block simply leaves that line out */ }
const site = 'https://digitalchiselco.com';
// The founder as a Person, so every article's "Jolly" byline points to one
// identity (blog/[slug].astro links its author here). Public name only.
const aboutLd = {
  '@context': 'https://schema.org', '@type': 'AboutPage', url: `${site}/about`, name: 'About DigitalChiselCo',
  mainEntity: {
    '@type': 'Organization', '@id': `${site}#org`, name: 'DigitalChiselCo', url: site,
    description: `Online library of ${DESIGNS} downloadable bas-relief STL files for CNC routers, 3D printers and laser engravers, for use in Aspire, VCarve, Carveco, ArtCAM and Fusion 360.`,
    email: 'jolly@digitalchiselco.com',
    founder: { '@type': 'Person', '@id': `${site}/about#jolly`, name: 'Jolly', jobTitle: 'Founder and designer', url: `${site}/about#jolly`,
      knowsAbout: ['bas-relief STL design', 'CNC relief carving', 'Vectric Aspire', 'VCarve Pro', 'ball nose toolpaths', 'rest machining', 'laser photo engraving'] },
  },
};
---
<Shell
  title="Our Story · DigitalChiselCo — Premium STL Files for CNC, Laser & 3D Printing"
  description="The story behind DigitalChiselCo — a one-person digital design studio building museum-grade bas-relief STL files for CNC routers, laser engravers, and 3D printers."
  scrollPastBanner={true}
>
  <Breadcrumbs crumbs={[{ label: 'Our Story' }]} />

  <article class="max-w-3xl mx-auto">
    <header class="text-center mb-12">
      <p class="text-xs tracking-widest text-bronze-600 mb-3">★ OUR STORY</p>
      <h1 class="font-serif text-4xl md:text-5xl text-bronze-800 leading-tight">From workshop to your machine.</h1>
      <p class="mt-5 text-lg text-ink-700/85 max-w-2xl mx-auto">
        DigitalChiselCo is a small, independent digital design studio building bas-relief STL files for the global community of CNC, laser, and 3D-print makers.
      </p>
    </header>

    <section class="prose prose-lg max-w-none text-ink-700 leading-relaxed space-y-6">
      <h2 class="font-serif text-2xl text-bronze-800">Why we started</h2>
      <p>
        Carving and 3D printing should feel like making art, not hunting for files. After years of buying patchy STL packs from random marketplaces, we built the studio we wished existed — one with hand-finished designs, honest pricing, and instant downloads that just work in Aspire, VCarve, Fusion 360, and Carveco.
      </p>

      <h2 class="font-serif text-2xl text-bronze-800">What goes into a DigitalChiselCo file</h2>
      <p>
        Every STL on this site starts as a sculpt and is validated through mesh checks, CAM simulation and representative machining tests before release. Files are watertight, sit on a flat base and are scaled to standard router beds, so your toolpaths render predictably. If a file would carve ugly, we don't ship it.
      </p>
      <ul class="not-prose grid sm:grid-cols-2 gap-3 text-sm mt-4 mb-6">
        <li class="flex gap-2"><span class="text-bronze-600">✓</span> Hand-finished bas-relief sculpts</li>
        <li class="flex gap-2"><span class="text-bronze-600">✓</span> Tested in Aspire / VCarve / Carveco / Fusion 360</li>
        <li class="flex gap-2"><span class="text-bronze-600">✓</span> Watertight, mesh-checked geometry</li>
        <li class="flex gap-2"><span class="text-bronze-600">✓</span> Standard router-bed scale, easily resized</li>
        <li class="flex gap-2"><span class="text-bronze-600">✓</span> Instant downloads — no shipping delay</li>
        <li class="flex gap-2"><span class="text-bronze-600">✓</span> Commercial-use license included</li>
      </ul>

      <h2 id="jolly" class="font-serif text-2xl text-bronze-800 scroll-mt-24">Who's behind it</h2>
      <p>
        DigitalChiselCo is a one-person studio — designer, support, and the person who checks every release. The shop is run by <strong>Jolly</strong>, its founder and only craftsman. When you email <a href="mailto:jolly@digitalchiselco.com" class="text-bronze-600">jolly@digitalchiselco.com</a>, you're emailing me. I read every message and reply within a day.
      </p>
      <p class="text-sm text-ink-700/70">
        Payments and tax compliance are handled by our Merchant of Record, <a href="https://www.paddle.com" class="text-bronze-600" rel="noopener" target="_blank">Paddle</a>, so we can deliver instant downloads to customers in over 40 countries. Paddle is the seller on every order: <strong>Paddle.com Inc.</strong> in the United States, <strong>Paddle.com (Canada) Ltd.</strong> in Canada, and <strong>Paddle.com Market Limited</strong> of London, registered in England and Wales, everywhere else.
      </p>

      <h2 class="font-serif text-2xl text-bronze-800">Studio facts</h2>
      <dl class="not-prose grid sm:grid-cols-2 gap-x-8 gap-y-3 text-sm my-4">
        <div><dt class="text-ink-700/60 text-xs uppercase tracking-wide">Designs</dt><dd class="text-ink-900">{DESIGNS} bas-relief STL files, new ones every month</dd></div>
        {measured > 0 && <div><dt class="text-ink-700/60 text-xs uppercase tracking-wide">Measured from the file</dt><dd class="text-ink-900">{measured.toLocaleString('en-US')} designs list their real size, relief depth, mesh and flat base on the product page</dd></div>}
        <div><dt class="text-ink-700/60 text-xs uppercase tracking-wide">Customer rating</dt><dd class="text-ink-900">{Number(s.rating)} out of 5 from {s.reviews_count}+ reviews</dd></div>
        <div><dt class="text-ink-700/60 text-xs uppercase tracking-wide">Software</dt><dd class="text-ink-900">Aspire, VCarve Pro, Carveco, ArtCAM, Fusion 360 and any STL-capable CAM</dd></div>
        <div><dt class="text-ink-700/60 text-xs uppercase tracking-wide">Free tools</dt><dd class="text-ink-900"><a href="/tools/will-it-cut" class="text-bronze-600">Will it cut?</a> STL checker, <a href="/lamp-studio" class="text-bronze-600">Lamp Studio</a>, <a href="/laser-studio" class="text-bronze-600">Laser Studio</a></dd></div>
        <div><dt class="text-ink-700/60 text-xs uppercase tracking-wide">Original research</dt><dd class="text-ink-900"><a href="/reports/state-of-cnc-relief-carving-2026" class="text-bronze-600">State of CNC Relief Carving 2026</a> and <a href="/blog/3mm-vs-1-5mm-ball-nose-relief-carving" class="text-bronze-600">a 3 mm vs 1.5 mm ball nose study</a></dd></div>
        <div><dt class="text-ink-700/60 text-xs uppercase tracking-wide">Custom work</dt><dd class="text-ink-900"><a href="/custom-design" class="text-bronze-600">Bas-relief STL from your own photo</a>, quoted within 24 hours</dd></div>
        <div><dt class="text-ink-700/60 text-xs uppercase tracking-wide">Contact</dt><dd class="text-ink-900"><a href="mailto:jolly@digitalchiselco.com" class="text-bronze-600">jolly@digitalchiselco.com</a>, answered by Jolly</dd></div>
      </dl>

      <h2 class="font-serif text-2xl text-bronze-800">{DESIGNS} designs and counting</h2>
      <p>
        We release new bas-relief themes every month — wildlife, patriotic, religious, vintage, seasonal, and custom commission work. Customers in over 40 countries carve our files for personal projects, craft fairs, and small woodworking businesses. To see what's coming next, drop your email on the <a href="/free" class="text-bronze-600">free pack page</a> — you'll get the first look at new collections.
      </p>

      <h2 class="font-serif text-2xl text-bronze-800">The license, in plain English</h2>
      <p>
        Buy once, download forever, sell the physical pieces you carve. The only thing you may not do is resell or share the digital files themselves. Full terms on the <a href="/terms" class="text-bronze-600">Terms of Service</a> page.
      </p>
    </section>

    <!-- CTA strip -->
    <section class="mt-16 border border-bronze-600/30 rounded-xl p-8 text-center bg-gradient-to-br from-cream to-white">
      <h3 class="font-serif text-2xl text-bronze-800">Ready to carve?</h3>
      <p class="mt-2 text-ink-700">Browse {DESIGNS} premium designs, or start with five free files on the house.</p>
      <div class="mt-5 flex flex-wrap justify-center gap-3">
        <a href="/catalog" class="bg-bronze-600 text-cream px-6 py-3 rounded-md text-sm hover:bg-bronze-700 transition shadow">Browse the catalog →</a>
        <a href="/free" class="border border-bronze-600 text-bronze-700 px-6 py-3 rounded-md text-sm hover:bg-bronze-600/10 transition">Get 5 free STL files</a>
      </div>
    </section>
  </article>
  <script type="application/ld+json" set:html={JSON.stringify(aboutLd)} />
</Shell>
