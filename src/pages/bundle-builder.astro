---
// "Pick any 5 — from $25" bundle builder. The buyer picks exactly 5 single
// designs; the selection goes into the cart as ONE special item whose id is
// 'bundle5:<id1>,<id2>,...'. ONE continuous pricing rule (src/lib/bundle5.ts):
// flat $25 while the five list prices sum to $40 or less; above that each
// extra dollar of list value adds $0.70 — premium designs raise the live
// price instead of being excluded. Enforced server-side in /api/checkout-init
// (browser numbers are never trusted); the webhook expands the line back into
// 5 order_items + entitlements.
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { img } from '../lib/img';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { supabaseAdmin } from '../lib/supabase';

export const prerender = false;

const BUNDLE_PRICE = 25;          // keep all three in sync with src/lib/bundle5.ts
const BUNDLE_VALUE_CAP = 40;      // flat $25 up to this combined list value
const BUNDLE_OVERAGE = 0.70;      // above it, each extra $1 of value adds $0.70
// (inline scripts can't import server libs — checkout-init re-computes the
// price from DB values and its number is the one actually charged)
// Eligible = active single designs. Bundles/catalogues/gift cards are excluded —
// the deal is for singles only (same filter is re-checked in checkout-init).
const eligible = (q: any) => q
  .eq('active', true)
  .gt('price_usd', 0)
  .not('slug', 'like', 'gift-card-%')
  .not('slug', 'like', 'catalogue-%')
  .not('slug', 'like', 'software-%')   // kept in sync with bundle5Eligible
  .not('title', 'ilike', '%bundle%')
  .not('title', 'ilike', '%membership%')
  .not('title', 'ilike', '%personalized%')
  .not('title', 'ilike', '%from your picture%')
  .not('title', 'ilike', '%from your photo%')
  .not('is_customizable', 'is', true);
const { data: prods } = await eligible(supabaseAdmin().from('products').select('id, slug, title, price_usd, image_url'))
  .order('created_at', { ascending: false })
  .limit(600);

// Arriving from the cart (?cart=<ids>): the designs already in the cart are
// loaded by id, so they can be picked even when they are older than the 600
// listed, and the page opens with them picked (owner, 2026-10-03, after a
// buyer put 7 designs in her cart and could not see where the 5-for-$25 went).
const cartIds = [...new Set((Astro.url.searchParams.get('cart') || '').split(',')
  .map((s) => s.trim()).filter((s) => /^[0-9a-f-]{36}$/i.test(s)))].slice(0, 40);
let fromCart: any[] = [];
if (cartIds.length) {
  const { data } = await eligible(supabaseAdmin().from('products').select('id, slug, title, price_usd, image_url')).in('id', cartIds);
  fromCart = data || [];
}
const listed = new Set((prods || []).map((p: any) => p.id));
const products = [...fromCart.filter((p) => !listed.has(p.id)), ...(prods || [])].map((p) => ({
  id: p.id,
  slug: p.slug,
  title: String(p.title || '').split('|')[0].trim(),
  price: Number(p.price_usd),
  // A 300px square thumbnail, not the upload: the grid lists up to 600
  // designs, and the raw pictures are 1 to 3 MB each (found 2026-09-25).
  img: p.image_url ? img(p.image_url, { w: 300, square: true, q: 75 }) : '',
}));
// in the cart's order; only designs that can go in a 5-pack
const PRESELECT = cartIds.filter((id) => fromCart.some((p) => p.id === id));
const avgFive = products.length
  ? (products.slice(0, 200).reduce((s, p) => s + p.price, 0) / Math.min(200, products.length)) * 5
  : 0;
---
<Base
  title="Pick Any 5 from $25 — STL Bundle Builder | DigitalChiselCo"
  description={`Build your own bas-relief STL bundle: pick any 5 designs. Five designs worth up to $40 together cost a flat $${BUNDLE_PRICE}. Instant download, commercial use included.`}
>
  <Header />
  <Breadcrumbs crumbs={[{ label: 'Bundle builder' }]} />
  <main class="px-4 sm:px-6 pb-28 max-w-6xl mx-auto">
    <div class="text-center max-w-2xl mx-auto mb-6">
      <h1 class="text-3xl sm:text-4xl">Pick any 5 — from ${BUNDLE_PRICE}</h1>
      <p class="mt-2 text-sm text-ink-700/70">
        Build your own bundle from {products.length} single designs — any five worth up to $40 together
        cost a flat <strong class="text-bronze-700">${BUNDLE_PRICE}</strong>. Premium picks simply raise
        the price bar live, and you always see exactly what you pay before adding to cart.
        Instant downloads, commercial use included.
      </p>
      <p class="mt-2 text-xs text-bronze-700">In a hurry? <a href="/bundle-of-week" class="underline font-medium">See this week's ready-made bundle →</a></p>
    </div>

    <div class="sticky top-0 z-30 -mx-4 sm:mx-0 mb-4 bg-[#FAEEDA]/95 backdrop-blur border-y sm:border sm:rounded-lg border-bronze-600/30 px-4 py-3">
      <div class="flex flex-wrap items-center gap-3">
        <div id="bb-slots" class="flex items-center gap-1.5" aria-live="polite"></div>
        <span id="bb-status" class="text-sm text-bronze-800 font-medium">Pick 5 designs to unlock the deal</span>
        <button id="bb-add" disabled
          class="ml-auto bg-bronze-600 text-cream text-sm px-5 py-2.5 rounded-md disabled:opacity-40 disabled:cursor-not-allowed hover:bg-bronze-700 transition">
          Add my 5-pack — from ${BUNDLE_PRICE}
        </button>
      </div>
    </div>

    <p id="bb-from-cart" hidden class="mb-4 rounded-md border border-[#FAC775] bg-[#FFF8EC] px-4 py-3 text-sm text-bronze-800"></p>

    <input id="bb-search" type="search" placeholder={`Search ${products.length} designs…`}
      class="w-full sm:max-w-sm px-4 py-2.5 text-sm border border-black/15 rounded-md mb-4 focus:outline-none focus:border-bronze-600" />

    <div id="bb-grid" class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-3"></div>
    <p id="bb-more" class="text-center text-xs text-ink-700/50 mt-4 hidden">Showing first 100 — search to find a specific design.</p>
  </main>
  <Footer />

  <script is:inline define:vars={{ PRODUCTS: products, BUNDLE_PRICE, BUNDLE_VALUE_CAP, BUNDLE_OVERAGE, PRESELECT }}>
    const grid = document.getElementById('bb-grid');
    const slotsEl = document.getElementById('bb-slots');
    const statusEl = document.getElementById('bb-status');
    const addBtn = document.getElementById('bb-add');
    const moreEl = document.getElementById('bb-more');
    const esc = (s) => String(s ?? '').replace(/&/g, '&amp;').replace(/"/g, '&quot;').replace(/</g, '&lt;');
    const picked = new Map(); // id -> product

    function card(p) {
      const sel = picked.has(p.id);
      return `
        <button type="button" data-id="${esc(p.id)}" aria-pressed="${sel}"
          class="bb-card text-left border rounded-md overflow-hidden transition relative ${sel ? 'border-bronze-600 ring-2 ring-bronze-600/50' : 'border-black/10 hover:shadow'}">
          <span class="absolute top-1.5 right-1.5 z-10 w-6 h-6 rounded-full text-xs flex items-center justify-center ${sel ? 'bg-bronze-600 text-cream' : 'bg-white/85 border border-black/15 text-ink-700/40'}">${sel ? '✓' : '+'}</span>
          <span class="block aspect-square bg-cream overflow-hidden">${p.img ? `<img src="${esc(p.img)}" alt="${esc(p.title)}" loading="lazy" class="w-full h-full object-cover">` : ''}</span>
          <span class="block p-2">
            <span class="block text-xs leading-snug text-ink-800 line-clamp-2 min-h-[2.4em]">${esc(p.title)}</span>
            <span class="block text-xs mt-1"><s class="text-ink-700/40">$${p.price.toFixed(2)}</s> <span class="text-bronze-700 font-medium">from $${Math.max(p.price * BUNDLE_OVERAGE, BUNDLE_PRICE / 5).toFixed(2)} in a 5-pack</span></span>
          </span>
        </button>`;
    }

    function render() {
      const q = (document.getElementById('bb-search').value || '').trim().toLowerCase();
      // with no search: what is picked first, then the rest of the cart, so a
      // swap is one tap away
      const fromCart = new Set(PRESELECT);
      const pool = q ? PRODUCTS.filter((p) => p.title.toLowerCase().includes(q))
        : [...picked.values(),
           ...PRODUCTS.filter((p) => !picked.has(p.id) && fromCart.has(p.id)),
           ...PRODUCTS.filter((p) => !picked.has(p.id) && !fromCart.has(p.id))];
      const show = pool.slice(0, 100);
      grid.innerHTML = show.map(card).join('') || '<p class="col-span-full text-sm text-ink-700/60 py-8 text-center">No designs match that search.</p>';
      moreEl.classList.toggle('hidden', pool.length <= 100);
      grid.querySelectorAll('.bb-card').forEach((b) => b.addEventListener('click', () => toggle(b.dataset.id)));
    }

    function toggle(id) {
      if (picked.has(id)) picked.delete(id);
      else {
        if (picked.size >= 5) { statusEl.textContent = 'You already have 5 — remove one to swap it.'; return; }
        const p = PRODUCTS.find((x) => x.id === id);
        if (p) picked.set(id, p);
      }
      render(); renderBar();
    }

    function renderBar() {
      const arr = [...picked.values()];
      slotsEl.innerHTML = Array.from({ length: 5 }, (_, i) => {
        const p = arr[i];
        return p
          ? `<span class="relative w-9 h-9 rounded overflow-hidden border border-bronze-600/50 bg-white" title="${esc(p.title)}">${p.img ? `<img src="${esc(p.img)}" class="w-full h-full object-cover">` : ''}</span>`
          : '<span class="w-9 h-9 rounded border border-dashed border-bronze-600/40 bg-white/50"></span>';
      }).join('');
      const value = arr.reduce((s, p) => s + p.price, 0);
      // ONE rule, mirrored from src/lib/bundle5.ts (the server re-computes it
      // and its number is what gets charged): flat $25 while the combined
      // value is $40 or less, then 70 cents per extra dollar.
      const price = Math.max(BUNDLE_PRICE, Math.round((BUNDLE_PRICE + BUNDLE_OVERAGE * (value - BUNDLE_VALUE_CAP)) * 100) / 100);
      if (arr.length === 5) {
        const save = Math.max(0, value - price);
        const pct = value > 0 ? Math.round((save / value) * 100) : 0;
        statusEl.innerHTML = price <= BUNDLE_PRICE
          ? '✓ Ready — <s>$' + value.toFixed(2) + '</s> <strong>$' + price.toFixed(2) + ' flat</strong> (you save $' + save.toFixed(2) + ')'
          : '✓ Ready — <s>$' + value.toFixed(2) + '</s> <strong>$' + price.toFixed(2) + '</strong> (premium bundle · you save $' + save.toFixed(2) + ', ' + pct + '%)';
        addBtn.textContent = 'Add my 5-pack — $' + price.toFixed(2);
        addBtn.disabled = false;
      } else {
        statusEl.textContent = arr.length ? `${arr.length} of 5 picked — add ${5 - arr.length} more` : 'Pick 5 designs to unlock the deal';
        addBtn.textContent = 'Add my 5-pack — from $' + BUNDLE_PRICE.toFixed(2);
        addBtn.disabled = true;
      }
    }

    addBtn.addEventListener('click', () => {
      const arr = [...picked.values()];
      if (arr.length !== 5) return;
      const ids = arr.map((p) => p.id);
      const value = arr.reduce((s, p) => s + p.price, 0);
      const price = Math.max(BUNDLE_PRICE, Math.round((BUNDLE_PRICE + BUNDLE_OVERAGE * (value - BUNDLE_VALUE_CAP)) * 100) / 100);
      const item = {
        id: 'bundle5:' + ids.join(','),
        slug: 'bundle-builder',
        title: 'Pick-5 Bundle: ' + arr.map((p) => p.title).join(' · ').slice(0, 160),
        price,
        qty: 1,
        img: arr[0].img || '',
      };
      let cart = JSON.parse(localStorage.getItem('cart') || '[]');
      // The picked designs that were already in the cart as single lines come
      // out of it, so nothing is paid for twice.
      const inBundle = new Set(ids);
      const before = cart.length;
      cart = cart.filter((x) => !inBundle.has(String(x.id)));
      const moved = before - cart.length;
      // one bundle per cart line; a second visit replaces nothing — it adds another
      cart.push(item);
      try { if (moved) sessionStorage.setItem('dcc-pick5-moved', String(moved)); } catch {}
      localStorage.setItem('cart', JSON.stringify(cart));
      window.dispatchEvent(new Event('cart-changed'));
      if (window.dccAction) window.dccAction('add_to_cart');
      window.location.href = '/cart';
    });

    // From the cart: pick the five that save the most. The bundle price rises
    // 70 cents per dollar of value above $40, so a dearer five always saves
    // more: the five highest-priced cart designs are the best pick.
    if (PRESELECT.length) {
      const inCart = PRESELECT.map((id) => PRODUCTS.find((p) => p.id === id)).filter(Boolean);
      const best = [...inCart].sort((a, b) => b.price - a.price).slice(0, 5);
      for (const p of best) picked.set(p.id, p);
      const note = document.getElementById('bb-from-cart');
      const n = inCart.length;
      note.innerHTML = n >= 5
        ? `<strong>We picked the ${n > 5 ? '5 designs from your cart that save you the most' : '5 designs from your cart'}.</strong> Swap any of them if you like. When you add the 5-pack, these come out of your cart as single designs, so nothing is paid twice.${n > 5 ? ` Your other ${n - 5} stay in the cart at their normal price.` : ''}`
        : `<strong>Your ${n} cart design${n === 1 ? ' is' : 's are'} picked.</strong> Add ${5 - n} more to make five. When you add the 5-pack, ${n === 1 ? 'it comes' : 'they come'} out of your cart as single designs, so nothing is paid twice.`;
      note.hidden = false;
    }
    document.getElementById('bb-search').addEventListener('input', render);
    render(); renderBar();
  </script>
</Base>
