---
// Every "Carved by you" maker on one page (2026-10-01, AI-search plan item 6:
// "real examples and case studies"). The homepage strip shows them scrolling
// past; this page is the quotable record: who carved which design, in what,
// with their own photos and clips. Only entries the owner has made visible
// (active) appear, the same rule as the homepage, so hidden drafts stay hidden.
import Shell from '../layouts/Shell.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { img } from '../lib/img';
import { jsonLd } from '../lib/jsonld';
import { supabase } from '../lib/supabase';

let rows: any[] = [];
try {
  const { data } = await supabase.from('customer_creations')
    .select('id,name,description,gallery,product_id,product_url,video_url,created_at,products(title,slug)')
    .eq('active', true).order('is_featured', { ascending: false }).order('created_at', { ascending: false }).limit(200);
  rows = data || [];
} catch { /* empty page rather than an error */ }
const site = 'https://digitalchiselco.com';
const anchor = (r: any) => `maker-${String(r.id).slice(0, 8)}`;
const design = (r: any) => r.products?.title ? String(r.products.title).split('|')[0].trim() : null;
const story = (r: any) => String(r.description || '').replace(/^\s*customer spotlight:[^\n]*\n+/i, '').trim();

const listLd = {
  '@context': 'https://schema.org', '@type': 'CollectionPage', name: 'Carved by you: finished carvings from DigitalChiselCo files', url: `${site}/carved-by-you`,
  description: 'Real carvings made by makers from DigitalChiselCo bas-relief STL files, with their own photos, videos and notes.',
  mainEntity: { '@type': 'ItemList', numberOfItems: rows.length, itemListElement: rows.map((r, i) => ({
    '@type': 'ListItem', position: i + 1, url: `${site}/carved-by-you#${anchor(r)}`,
    item: {
      '@type': 'CreativeWork', name: `${design(r) || 'Bas-relief carving'} carved by ${r.name}`, creator: { '@type': 'Person', name: r.name },
      ...(story(r) ? { description: story(r).slice(0, 500) } : {}),
      ...(r.gallery?.[0] ? { image: r.gallery[0] } : {}),
      ...(r.products?.slug ? { isBasedOn: `${site}/product/${r.products.slug}` } : {}),
      ...(r.video_url ? { video: { '@type': 'VideoObject', name: `${design(r) || 'Carving'} being cut by ${r.name}`, description: `Clip from ${r.name} of the CNC cutting this carving.`,
        thumbnailUrl: r.gallery?.[0] || `${site}/og-default.jpg`, uploadDate: r.created_at, contentUrl: r.video_url } } : {}),
    },
  })) },
};
---
<Shell
  title="Carved by You: Real CNC Carvings From Our STL Files | DigitalChiselCo"
  description={`${rows.length} finished carvings made by makers from DigitalChiselCo bas-relief STL files: their photos, clips and notes on wood, finish and setup.`}
>
  <Breadcrumbs crumbs={[{ label: 'Carved by you' }]} />
  <script type="application/ld+json" set:html={jsonLd(listLd)} />

  <div class="max-w-4xl mx-auto pb-20 text-ink-700">
    <p class="text-xs uppercase tracking-[0.18em] text-bronze-600 mb-2">The maker wall</p>
    <h1 class="font-serif text-3xl sm:text-4xl text-bronze-800 leading-tight" style="text-wrap: balance">Carved by you</h1>
    <p class="mt-4 text-[17px] leading-relaxed max-w-3xl">
      <strong>These are real pieces, carved by makers from our STL files on their own machines.</strong> The photos and clips are theirs,
      shown with their permission. Each one links to the design it was carved from.
    </p>

    {rows.length === 0 && <p class="mt-10 text-ink-700/70">The first makers' pieces will appear here soon.</p>}

    <div class="mt-10 space-y-10">
      {rows.map((r) => (
        <section id={anchor(r)} class="scroll-mt-24 grid sm:grid-cols-5 gap-5 border-t border-black/10 pt-8">
          <div class="sm:col-span-3 space-y-3">
            {r.gallery?.[0] && <img src={img(r.gallery[0], { w: 900, q: 80 })} alt={`${design(r) || 'Bas-relief carving'} carved by ${r.name}`} loading="lazy" class="w-full max-h-[520px] object-contain rounded-lg bg-cream" />}
            {r.video_url && <video src={r.video_url} poster={r.gallery?.[0] ? img(r.gallery[0], { w: 900, q: 75 }) : undefined} controls muted playsinline preload="none" class="w-full max-h-[480px] rounded-lg bg-black"></video>}
            {(r.gallery || []).length > 1 && (
              <div class="flex gap-2 flex-wrap">
                {r.gallery.slice(1, 6).map((g: string, i: number) => <img src={img(g, { w: 240, q: 72 })} alt={`${r.name}'s carving, photo ${i + 2}`} loading="lazy" class="h-24 w-24 object-cover rounded-md border border-black/10" />)}
              </div>
            )}
          </div>
          <div class="sm:col-span-2">
            <h2 class="font-serif text-2xl text-bronze-800">{r.name}</h2>
            {design(r) && <p class="mt-1 text-sm text-ink-700/70">carved <a href={`/product/${r.products.slug}`} class="text-bronze-700 underline">{design(r)}</a></p>}
            {story(r) && <p class="mt-3 leading-relaxed whitespace-pre-line">{story(r)}</p>}
            {!design(r) && r.product_url && <a href={r.product_url} class="mt-3 inline-block text-sm text-bronze-700 underline">See the design</a>}
          </div>
        </section>
      ))}
    </div>

    <p class="mt-14 text-sm text-ink-700/75 border-t border-black/10 pt-6">
      Carved one of our designs? Send a photo, and a short clip if you have one, to
      <a href="mailto:jolly@digitalchiselco.com" class="text-bronze-700 underline">jolly@digitalchiselco.com</a> and we will feature you here, with credit.
    </p>
  </div>
</Shell>
