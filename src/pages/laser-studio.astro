---
import Shell from '../layouts/Shell.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { getSettings } from '../lib/queries';
import { img } from '../lib/img';
import { designCountLabel } from '../lib/queries';
const s: any = await getSettings();
// Image slots are admin-managed (Admin → Media → Laser Studio page) with a static
// fallback; img() right-sizes admin uploads, local files are pre-sized.
//
// The HERO is fixed to the current app screenshot on purpose (2026-09-19): the admin
// hero slot held the July "11 Sellable Styles" poster, which is out of date
// (50 looks now) and not a picture of the app. ls_hero_url is left untouched in
// the database; restore `s.ls_hero_url ||` below to hand the hero back to Admin.
// Sundial and Recipe board are hidden in the customer build, so their slots
// (ls_sundial_url, ls_recipe_url) are no longer shown; the files stay.
const IMG = {
  styles:  img(s.ls_styles_url, { w: 1000 })  || '/laser-studio/styles-v26.webp',
  relief:  img(s.ls_relief_url, { w: 1100 })  || '/laser-studio/relief.webp',
  starmap: img(s.ls_starmap_url, { w: 1000 }) || '/laser-studio/starmap.webp',
  tumbler: img(s.ls_tumbler_url, { w: 700 })  || '/laser-studio/tumbler.webp',
  proof:   img(s.ls_proof_url, { w: 700 })    || '/laser-studio/proof.webp',
};
const DESIGNS = await designCountLabel();   // "1,900+", kept true by the database
const BUY = s.ls_buy_url || 'https://www.etsy.com/shop/DigitalChiselCo';

const STEPS = [
  { t: 'Load the design', p: 'The greyscale file of the relief you carved.' },
  { t: 'Photograph the piece on the laser', p: 'Straight down, or a screenshot of the laser camera view.' },
  { t: 'Make it measurable', p: 'Find the board corners and flatten the photo to true size, in millimetres or inches.' },
  { t: 'Auto-fit, then adjust', p: 'The built-in AI finds your piece in the photo and drops the design onto it, offline, and tells you how sure it is. Drag to move, corners to resize, the round handle to rotate.' },
  { t: 'Choose what to burn', p: 'Darken the background floor, scorch the raised tops, outline the relief, tonal shading of the design itself, or your own text.' },
  { t: 'Export for LightBurn', p: 'Burn files plus alignment helpers, sorted in one ZIP.' },
];
const LOOK_GROUPS = [
  { g: 'Photo', n: 2, eg: 'Engrave photo, 3D illusion' },
  { g: 'Art engines', n: 17, eg: 'Pencil sketch, stipple, word portrait, spiral, string art, crosshatch, halftone, mosaic, one-line scribble, flow silk, maze and more' },
  { g: 'Signature art styles', n: 31, eg: 'Banknote engraving, hedcut, embroidery stitch, charcoal, Turing patterns, Lichtenberg branches, guilloché rosettes, Celtic weave, circuit board, marbling, double exposure and more' },
];
---
<Shell
  title="Laser Studio · Photo to Laser File Software for Diode & CO2 | DigitalChiselCo"
  description="Laser Studio turns photos, STL 3D models and the real night sky into ready-to-burn laser files: 50 looks, star maps, coasters, tumbler wraps and a calibration test grid. New CNC Match burns text or shading exactly onto the pieces you carved. Works with LightBurn, xTool, Glowforge and LaserGRBL."
  scrollPastBanner={true}
>
  <Breadcrumbs crumbs={[{ label: 'Laser Studio' }]} />

  <article class="max-w-5xl mx-auto">

    <!-- ===== HERO ===== -->
    <header class="text-center mb-10 reveal">
      <p class="text-xs tracking-widest text-bronze-600 mb-3">★ VERSION 2.7 · CNC MATCH WITH AUTO-FIT</p>
      <h1 class="font-serif text-4xl md:text-6xl text-bronze-800 leading-tight">
        Laser <em class="italic text-bronze-600">Studio</em>
      </h1>
      <p class="mt-5 text-lg md:text-xl text-ink-700/85 max-w-3xl mx-auto">
        One app turns your photos, 3D models and even the night sky into ready-to-burn laser files.
        And now it burns straight onto the pieces you carved on your CNC.
      </p>
      <div class="mt-6 flex flex-wrap justify-center gap-3">
        <a href={BUY} target="_blank" rel="noopener"
           class="bg-bronze-600 text-cream px-8 py-3.5 rounded-md text-sm font-medium hover:bg-bronze-700 hover:shadow-lg hover:-translate-y-0.5 transition-all shadow">Get Laser Studio →</a>
        <a href="#cnc-match" class="border border-bronze-600 text-bronze-700 px-8 py-3.5 rounded-md text-sm hover:bg-bronze-600/10 transition">See CNC Match</a>
      </div>
      <p class="mt-3 text-xs text-ink-700/60">Windows 10/11 · one-time purchase · no subscription · your photos are processed on your own PC</p>
    </header>

    <figure class="rounded-xl overflow-hidden border border-bronze-600/25 shadow-lg mb-16 reveal">
      <img src="/laser-studio/app-v26.webp" srcset="/laser-studio/app-v26-800.webp 800w, /laser-studio/app-v26.webp 1600w" sizes="(max-width: 1024px) 100vw, 1024px"
           alt="Laser Studio 2.7 on the CNC Match tab: Auto-fit has locked a design onto a carved alligator relief photographed on the laser bed"
           width="1600" height="1000" loading="eager" fetchpriority="high" decoding="async" class="w-full" />
      <figcaption class="text-center text-xs text-ink-700/60 py-2 bg-cream">Laser Studio 2.7: seven workspaces, one quiet artboard. Here, CNC Match has locked a design onto a real carving.</figcaption>
    </figure>

    <!-- ===== NEW: CNC MATCH ===== -->
    <section id="cnc-match" class="mb-16 scroll-mt-24">
      <div class="text-center reveal">
        <p class="text-xs tracking-widest text-bronze-600 mb-3">CNC MATCH · NOW WITH AUTO-FIT</p>
        <h2 class="font-serif text-3xl md:text-4xl text-bronze-800">Carved it on the CNC?<br class="hidden md:block"/> Finish it on the laser.</h2>
        <p class="mt-4 text-ink-700/85 max-w-3xl mx-auto">
          Carved one of our STLs on your CNC? Put it on the laser and burn text, shading or the same picture
          exactly onto the carving. A name and a date under a pet portrait, a darkened background that makes the relief
          jump, a scorched edge on the raised tops: the finishing touches that turn a carving into a gift.
        </p>
      </div>

      <div class="mt-10 grid md:grid-cols-2 gap-8 items-center">
        <figure class="img-zoom rounded-xl overflow-hidden border border-bronze-600/25 shadow-lg max-w-sm mx-auto md:max-w-none reveal">
          <img src="/laser-studio/cnc-burn.webp" alt="Burn preview on the carved alligator: the background darkened and 'The Carters 2026' placed under the relief, with a cyan alignment outline" width="720" height="992" loading="lazy" decoding="async" class="w-full transition-transform duration-500" />
          <figcaption class="text-center text-xs text-ink-700/60 py-2 bg-cream">The burn, previewed live on the real piece before the laser fires.</figcaption>
        </figure>
        <ol class="space-y-4 reveal reveal-d1">
          {STEPS.map((st, n) => (
            <li class="flex gap-4">
              <span class="shrink-0 w-8 h-8 rounded-full bg-bronze-600 text-cream text-sm font-semibold flex items-center justify-center">{n + 1}</span>
              <div>
                <p class="font-serif text-lg text-bronze-800 leading-snug">{st.t}</p>
                <p class="text-sm text-ink-700/80">{st.p}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>

      <div class="mt-12 grid md:grid-cols-2 gap-8 items-center">
        <div class="reveal">
          <p class="text-xs tracking-widest text-bronze-600 mb-2">WHAT YOU GET</p>
          <h3 class="font-serif text-3xl text-bronze-800 leading-snug">Files LightBurn understands,<br/>and help lining them up.</h3>
          <ul class="mt-4 space-y-2 text-sm text-ink-700/85">
            <li class="flex gap-2"><span class="text-bronze-600">✓</span> Burn files in greyscale and three dithered versions, at the carving's real size</li>
            <li class="flex gap-2"><span class="text-bronze-600">✓</span> A "ghost" outline file for lining the burn up in your laser's camera view</li>
            <li class="flex gap-2"><span class="text-bronze-600">✓</span> Optional registration marks for LightBurn Print and Cut</li>
            <li class="flex gap-2"><span class="text-bronze-600">✓</span> Optional jig file, so repeat orders drop straight into place</li>
            <li class="flex gap-2"><span class="text-bronze-600">✓</span> A saved preset to reload the same job later</li>
          </ul>
          <p class="mt-4 text-sm text-ink-700/70">
            Auto-fit is a starting guess, not a promise: a clamp, a bright offcut, a sheet of paper or a hand in
            the shot can fool it, and square pieces sometimes land a quarter turn out. It says how sure it is, and
            you can nudge it by hand. Alignment is typically within about a millimetre. Always check the outline
            and test on scrap before burning the finished piece.
          </p>
        </div>
        <figure class="img-zoom rounded-xl overflow-hidden border border-bronze-600/25 shadow-lg reveal reveal-d1">
          <img src="/laser-studio/cnc-text.webp" srcset="/laser-studio/cnc-text-700.webp 700w, /laser-studio/cnc-text.webp 1200w" sizes="(max-width: 768px) 100vw, 500px"
               alt="CNC Match with an outline burn layer and the text 'The Carters 2026' placed on the carving" width="1200" height="750" loading="lazy" decoding="async" class="w-full transition-transform duration-500" />
          <figcaption class="text-center text-xs text-ink-700/60 py-2 bg-cream">Burn layers: outline, darkened floor and your own text.</figcaption>
        </figure>
      </div>

      <div class="mt-10 rounded-xl border border-bronze-600/30 bg-gradient-to-br from-cream to-white p-6 md:p-8 text-center reveal">
        <p class="font-serif text-xl md:text-2xl text-bronze-800">Our STL files, then our laser software: one finished piece.</p>
        <p class="mt-2 text-sm text-ink-700/80 max-w-2xl mx-auto">
          CNC Match was built for the <a href="/catalog" class="text-bronze-600 underline underline-offset-2">{DESIGNS} bas-relief STL files</a> in our shop.
          Carve the relief, then personalise every piece on the laser, for weddings, memorials, pets and shop signs.
        </p>
      </div>
    </section>

    <!-- ===== WHY GAME CHANGER ===== -->
    <section class="mb-16">
      <div class="text-center reveal">
        <p class="text-xs tracking-widest text-bronze-600 mb-3">WHY IT MATTERS</p>
        <h2 class="font-serif text-3xl md:text-4xl text-bronze-800">A game changer<br class="hidden md:block"/> for the laser market</h2>
        <p class="mt-4 text-ink-700/85 max-w-3xl mx-auto">
          Laser makers today juggle a photo-prep website, a dithering tool, a star-map generator, a background remover,
          a quoting spreadsheet and a settings forum, plus a subscription or two. Laser Studio puts the whole stack in one
          desktop app.
        </p>
      </div>
      <div class="mt-10 grid md:grid-cols-3 gap-5">
        {[
          { i: '🎨', t: '50 looks from one photo', p: 'Engrave, 3D illusion, pencil sketch, stipple, word portrait, string art, maze, and 31 Signature art styles from banknote engraving to Celtic weave. The same customer photo becomes a whole range of sellable products.' },
          { i: '🔒', t: 'Private. Owned. Yours.', p: "Your customers' photos are processed on your own PC and never uploaded. No monthly fee. The internet is only used to check for updates, to download optional AI models once, and when you open our shop pages." },
          { i: '🎯', t: 'Your settings, from your test burn', p: 'The number one question in laser forums is "what power and speed do I use?" Burn the built-in test grid on your own material, and Laser Studio helps you read off the setting that looks best on your machine.' },
          { i: '🌌', t: 'Whole product categories in a click', p: 'Real star maps for any date and place, coaster sets with cut lines, tumbler wraps at true circumference, chess, checkers and cribbage boards: each one a finished product, not just an image.' },
          { i: '⚡', t: 'Diode AND CO2, first-class', p: 'Every export is one organised ZIP: 1-bit dithers for diode lasers, greyscale and 16-bit depth for CO2, fibre and galvo, and real-millimetre SVG cut lines, with a read-me that says which folder your laser needs.' },
          { i: '🪪', t: 'Built for sellers', p: 'A Laser Job Card with your own logo, client proofs, quote PDFs and care cards: the paperwork of a small laser business, done in the same app that made the file.' },
        ].map((c, n) => (
          <div class={`gc-card reveal reveal-d${n % 3} group border border-bronze-600/25 rounded-xl p-6 bg-gradient-to-br from-cream to-white hover:-translate-y-1.5 hover:shadow-xl hover:border-bronze-600/50 transition-all duration-300`}>
            <div class="w-12 h-12 rounded-full bg-bronze-600/10 border border-bronze-600/25 flex items-center justify-center text-2xl group-hover:bg-bronze-600/20 group-hover:scale-110 transition-all duration-300">{c.i}</div>
            <h3 class="font-serif text-xl text-bronze-800 mt-4">{c.t}</h3>
            <p class="mt-2 text-sm text-ink-700/85 leading-relaxed">{c.p}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- ===== 50 LOOKS ===== -->
    <section class="mb-16">
      <div class="text-center reveal">
        <p class="text-xs tracking-widest text-bronze-600 mb-3">THE ART ENGINES</p>
        <h2 class="font-serif text-3xl md:text-4xl text-bronze-800">One photo. Fifty finished looks.</h2>
        <p class="mt-3 text-ink-700/85 max-w-2xl mx-auto">
          Click a style and watch the preview change; its own sliders appear right below. Pin your favourites to the top.
          Nine of the fifty below, all made from the same carving.
        </p>
      </div>
      <figure class="mt-8 rounded-xl overflow-hidden border border-bronze-600/25 shadow-lg reveal max-w-3xl mx-auto">
        <img src={IMG.styles} alt="Nine Laser Studio styles made from one relief: banknote, hedcut, halftone, flow silk, Turing, guilloché, phyllotaxis, string art and contour" width="900" height="999" loading="lazy" decoding="async" class="w-full" />
      </figure>
      <div class="mt-6 grid md:grid-cols-3 gap-4 reveal">
        {LOOK_GROUPS.map((g) => (
          <div class="rounded-xl border border-bronze-600/25 bg-cream/60 p-4">
            <p class="font-serif text-lg text-bronze-800"><span class="text-2xl tabular-nums">{g.n}</span> {g.g}</p>
            <p class="text-xs text-ink-700/75 mt-1 leading-relaxed">{g.eg}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- ===== STL + STAR MAP · editorial split rows ===== -->
    <section class="mb-16 space-y-12">
      <div class="grid md:grid-cols-2 gap-8 items-center reveal">
        <figure class="img-zoom rounded-xl overflow-hidden border border-bronze-600/25 shadow-lg">
          <img src={IMG.relief} alt="An STL 3D model converted into a hand-carved-looking laser relief engrave" width="1100" height="1093" loading="lazy" decoding="async" class="w-full transition-transform duration-500" />
        </figure>
        <div>
          <p class="text-xs tracking-widest text-bronze-600 mb-2">STL TO LASER GREY SCALE</p>
          <h3 class="font-serif text-3xl text-bronze-800 leading-snug">Drop an STL.<br/>Get a carving.</h3>
          <p class="mt-4 text-ink-700/85 leading-relaxed">
            The 3D-illusion engine relights any STL model as a hand-carved piece: swing the light around it,
            dial the depth, boost the detail. Exports flat single-pass engraves for any laser <em>and</em> true 16-bit
            depth maps for real 3D carving.
          </p>
          <p class="mt-3 text-sm text-ink-700/70">It pairs perfectly with our <a href="/catalog" class="text-bronze-600 underline underline-offset-2">{DESIGNS} bas-relief STL files</a>, with zero conversion needed.</p>
        </div>
      </div>
      <div class="grid md:grid-cols-2 gap-8 items-center reveal">
        <div class="md:order-1 order-2">
          <p class="text-xs tracking-widest text-bronze-600 mb-2">THE STAR MAP ENGINE</p>
          <h3 class="font-serif text-3xl text-bronze-800 leading-snug">The sky,<br/>that night.</h3>
          <p class="mt-4 text-ink-700/85 leading-relaxed">
            Astronomically real stars, the Moon at its true phase, the planets that were up, over any place and moment
            on Earth. Heart-shaped skies, "where we met" street-map combos, a song's soundwave ringing the sky with a
            QR that plays it.
          </p>
          <p class="mt-3 text-sm text-ink-700/70">Weddings, births, first dates, memorials: engrave it, or print it in colour and frame it.</p>
        </div>
        <figure class="img-zoom rounded-xl overflow-hidden border border-bronze-600/25 shadow-lg md:order-2 order-1 max-w-md mx-auto md:mx-0">
          <img src={IMG.starmap} alt="A heart-shaped star map of the real night sky with names in script" width="1000" height="1282" loading="lazy" decoding="async" class="w-full transition-transform duration-500" />
        </figure>
      </div>
    </section>

    <!-- ===== PRODUCT MAKERS ===== -->
    <section class="mb-16">
      <div class="text-center reveal">
        <p class="text-xs tracking-widest text-bronze-600 mb-3">BEYOND IMAGES</p>
        <h2 class="font-serif text-3xl md:text-4xl text-bronze-800">Product makers, built in</h2>
      </div>
      <div class="mt-8 grid sm:grid-cols-2 lg:grid-cols-4 gap-5">
        {[
          { img: IMG.tumbler, alt: 'A tumbler wrap previewed on a 3D cup mockup', t: 'Tumblers, done right.', p: 'True-circumference wraps with a spinnable 3D preview.' },
          { img: null, icon: '◎', alt: '', t: 'Coaster sets in minutes.', p: 'Round, square, rounded or hex, a live preview, matching sets of up to eight, and cut lines with kerf built in.' },
          { img: '/laser-studio/jobcard.webp', alt: 'A Laser Job Card with shop logo, design, material, size, resolution and the file to burn', t: 'A Job Card for every order.', p: 'Your logo, the design and every setting on one page for the shop wall.' },
          { img: IMG.proof, alt: 'A watermarked client proof card', t: 'No more spelling refunds.', p: 'Watermarked client proofs, with an optional scan-to-approve QR.' },
        ].map((c, n) => (
          <figure class={`reveal reveal-d${n} group border border-bronze-600/25 rounded-xl overflow-hidden bg-white hover:shadow-xl hover:-translate-y-1 transition-all duration-300 flex flex-col`}>
            <div class="overflow-hidden aspect-square bg-cream flex items-center justify-center">
              {c.img
                ? <img src={c.img} alt={c.alt} class="w-full h-full object-contain group-hover:scale-105 transition-transform duration-500" loading="lazy" decoding="async" />
                : <div aria-hidden="true" class="w-32 h-32 rounded-full border-[10px] border-bronze-600/30 bg-gradient-to-br from-[#E9D3B0] to-[#C9A273] shadow-inner flex items-center justify-center text-4xl text-bronze-800/70 group-hover:scale-105 transition-transform duration-500">{c.icon}</div>}
            </div>
            <figcaption class="p-4 border-t border-bronze-600/15">
              <strong class="text-bronze-800 font-serif">{c.t}</strong>
              <p class="text-sm text-ink-700/80 mt-1">{c.p}</p>
            </figcaption>
          </figure>
        ))}
      </div>
    </section>

    <!-- ===== PHOTO TOOLS + SELLER KIT + COMFORT ===== -->
    <section class="mb-16 grid md:grid-cols-3 gap-5">
      {[
        { h: 'Photo tools', items: [
          'Smart background removal, with a touch-up brush to add back or erase',
          'Region tools on the canvas: frame, keep, cut and lasso',
          'Smart Upscale ×4 rescues small phone photos',
          'Chess, checkers and cribbage boards, ready to engrave',
        ] },
        { h: 'Seller kit', items: [
          'Laser Job Card with your own logo and shop name',
          'Client proof with an optional scan-to-approve QR',
          'Branded quote PDF for every job',
          'Care cards to slip in with each order',
        ] },
        { h: 'Comfortable to use', items: [
          'Save and reopen whole projects',
          'Undo and redo, rulers on the artboard',
          'Ctrl+K command palette: find any tool by name',
          'Dark mode, and menus in English, Español, Deutsch and Français',
        ] },
      ].map((b, n) => (
        <div class={`reveal reveal-d${n} rounded-xl border border-bronze-600/25 bg-gradient-to-br from-cream to-white p-6`}>
          <h3 class="font-serif text-xl text-bronze-800">{b.h}</h3>
          <ul class="mt-3 space-y-2 text-sm text-ink-700/85">
            {b.items.map((it) => <li class="flex gap-2"><span class="text-bronze-600">✓</span><span>{it}</span></li>)}
          </ul>
        </div>
      ))}
    </section>

    <figure class="mb-16 rounded-xl overflow-hidden border border-bronze-600/25 shadow-lg reveal max-w-3xl mx-auto">
      <img src="/laser-studio/dark-mode.webp" alt="Laser Studio in dark mode, showing all six CNC Match steps beside the carving" width="1000" height="625" loading="lazy" decoding="async" class="w-full" />
      <figcaption class="text-center text-xs text-ink-700/60 py-2 bg-cream">Dark mode, for late nights at the laser.</figcaption>
    </figure>

    <!-- ===== COMPATIBILITY ===== -->
    <section class="mb-16 border border-bronze-600/30 rounded-xl p-8 bg-gradient-to-br from-cream to-white reveal">
      <h2 class="font-serif text-2xl text-bronze-800 text-center">Works with the laser you already own</h2>
      <div class="mt-6 grid md:grid-cols-2 gap-6 text-sm text-ink-700/85">
        <div>
          <p class="font-semibold text-bronze-700 mb-2">Machines</p>
          <ul class="space-y-1.5">
            <li>✓ Diode / blue-light: xTool D1, Ortur, Sculpfun, Atomstack &amp; similar</li>
            <li>✓ CO2: K40, OMTech, Glowforge &amp; other CO2 machines</li>
            <li>✓ Fibre &amp; galvo markers</li>
          </ul>
        </div>
        <div>
          <p class="font-semibold text-bronze-700 mb-2">Software it feeds</p>
          <ul class="space-y-1.5">
            <li>✓ LightBurn: greyscale, dither &amp; 16-bit depth workflows, camera and Print and Cut alignment</li>
            <li>✓ xTool Creative Space (XCS) · Glowforge app</li>
            <li>✓ LaserGRBL · RDWorks / LaserWORKS</li>
          </ul>
        </div>
      </div>
      <p class="mt-5 text-xs text-ink-700/60 text-center">
        Laser Studio creates the design files; your laser software fires the beam. Power and speed depend on your
        machine and material, so you dial them in with the built-in test grid on <em>your</em> laser.
      </p>
    </section>

    <!-- ===== FACTS + CTA ===== -->
    <section class="mb-8 text-center reveal">
      <h2 class="font-serif text-3xl text-bronze-800">The plain facts</h2>
      <ul class="not-prose mt-5 grid sm:grid-cols-2 gap-3 text-sm max-w-2xl mx-auto text-left text-ink-700/85">
        <li class="flex gap-2"><span class="text-bronze-600">✓</span> Windows 10 / 11, installs in one click</li>
        <li class="flex gap-2"><span class="text-bronze-600">✓</span> One-time purchase, no subscription</li>
        <li class="flex gap-2"><span class="text-bronze-600">✓</span> Photos processed on your PC, never uploaded</li>
        <li class="flex gap-2"><span class="text-bronze-600">✓</span> Illustrated user manual and CNC Match Guide built in</li>
        <li class="flex gap-2"><span class="text-bronze-600">✓</span> Free updates, with a notice when a new version is out</li>
        <li class="flex gap-2"><span class="text-bronze-600">✓</span> Every export sorted for diode, CO2 &amp; vector</li>
        <li class="flex gap-2"><span class="text-bronze-600">✓</span> Seven workspaces, from STL to your shop paperwork</li>
        <li class="flex gap-2"><span class="text-bronze-600">✓</span> Made by the studio behind {DESIGNS} STL designs</li>
      </ul>
    </section>

    <section class="mt-12 mb-4 border border-bronze-600/30 rounded-xl p-8 text-center bg-gradient-to-br from-cream to-white reveal">
      <h3 class="font-serif text-2xl text-bronze-800">Turn your next photo, or your next carving, into a product tonight.</h3>
      <p class="mt-2 text-ink-700">Laser Studio is available now from our shop, and every DigitalChiselCo STL file works in it with zero conversion.</p>
      <div class="mt-5 flex flex-wrap justify-center gap-3">
