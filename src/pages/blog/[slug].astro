---
import Shell from '../../layouts/Shell.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { supabaseAdmin } from '../../lib/supabase';
import { jsonLd } from '../../lib/jsonld';
import xss from 'xss';
import PriceCalculator from '../../components/PriceCalculator.tsx';

const { slug } = Astro.params;
let post: any = null;
try {
  const db = supabaseAdmin();
  const { data } = await db
    .from('posts')
    .select('slug, title, excerpt, body, cover_image_url, published_at, updated_at, author, seo_title, seo_description')
    .eq('slug', slug!).eq('status', 'published').maybeSingle();
  post = data;
} catch {}

if (!post) return Astro.rewrite('/404');

// Reading time and "updated" only when the article was materially revised
// after publishing (a same-day republish is not an update worth announcing).
const words = String(post.body || '').replace(/<[^>]+>/g, ' ').split(/\s+/).filter(Boolean).length;
const minutes = Math.max(1, Math.round(words / 220));
const fmt = (d: string) => new Date(d).toLocaleDateString('en-US', { day: 'numeric', month: 'short', year: 'numeric' });
const revised = post.updated_at && post.published_at
  && (new Date(post.updated_at).getTime() - new Date(post.published_at).getTime()) > 36 * 3600e3;

// Three more guides for the foot of the page, newest first, never this one.
// Rendered from the database so every article stays cross-linked as new
// guides are published, with nobody editing old ones.
let related: any[] = [];
try {
  const { data } = await supabaseAdmin().from('posts')
    .select('slug, title, excerpt, cover_image_url')
    .eq('status', 'published').neq('slug', slug!)
    .order('published_at', { ascending: false }).limit(3);
  related = data || [];
} catch {}

// Long guides need a contents list that jumps, so headings keep their id,
// and a small set of class names survive so an article can mark a link
// as a button. Everything else stays on the library's default allowlist.
const safeBody = xss(post.body || '', {
  whiteList: {
    ...(xss as any).whiteList,
    h2: ['id'], h3: ['id'], h4: ['id'], section: ['id', 'class'],
    a: ['target', 'href', 'title', 'class'], p: ['class'], div: ['class'], span: ['class'], figure: ['class'],
  },
});
// An article can drop an interactive widget in with one empty div (the class
// survives the sanitizer); the body is split there and the island mounted
// between the halves, since a script can never live inside stored HTML.
const CALC_MARK = '<div class="dcc-price-calc"></div>';
const bodyParts = safeBody.includes(CALC_MARK) ? safeBody.split(CALC_MARK, 2) : [safeBody];
---
<Shell
  title={`${post.seo_title || post.title} · DigitalChiselCo`}
  description={(post.seo_description || post.excerpt || '').slice(0, 155)}
  image={post.cover_image_url || undefined}
  scrollPastBanner={true}
>
  <Breadcrumbs crumbs={[{ label: 'Blog', href: '/blog' }, { label: post.title }]} />

  <article class="max-w-3xl mx-auto">
    {post.cover_image_url && (
      <img src={post.cover_image_url} alt={post.title} class="w-full aspect-[16/9] object-cover rounded-lg mb-8" />
    )}
    <header class="mb-8">
      <h1 class="font-serif text-3xl md:text-4xl text-bronze-800 leading-tight">{post.title}</h1>
      <div class="mt-3 text-sm text-ink-700/60">
        {post.author && <span>{post.author}</span>}
        {post.published_at && <span> · {fmt(post.published_at)}</span>}
        {revised && <span> · updated {fmt(post.updated_at)}</span>}
        <span> · {minutes} min read</span>
      </div>
    </header>
    <div class="post-body prose prose-lg max-w-none text-ink-700 leading-relaxed" set:html={bodyParts[0]} />
    {bodyParts.length > 1 && (
      <>
        <PriceCalculator client:load />
        <div class="post-body prose prose-lg max-w-none text-ink-700 leading-relaxed" set:html={bodyParts[1]} />
      </>
    )}
    {related.length > 0 && (
      <aside class="mt-14 pt-8 border-t border-bronze-600/20">
        <h2 class="font-serif text-xl text-bronze-800 mb-4">Keep reading</h2>
        <div class="grid sm:grid-cols-3 gap-4">
          {related.map((r) => (
            <a href={`/blog/${r.slug}`} class="block rounded-lg border border-black/10 bg-white overflow-hidden hover:shadow-md transition">
              {r.cover_image_url && <img src={r.cover_image_url} alt="" loading="lazy" class="w-full aspect-[16/9] object-cover" />}
              <div class="p-3">
                <div class="font-serif text-[15px] leading-snug text-ink-800">{r.title}</div>
              </div>
            </a>
          ))}
        </div>
      </aside>
    )}
  </article>

  <style is:global>
    /* Article body styling lives here rather than in the HTML, because the
       sanitizer strips styling from stored content. Every article, past and
       future, gets the same treatment (owner request, 2026-09-05). */
    /* Headings: serif, bronze, with a short rule under each section title so
       a long guide reads as chapters rather than one wall of text. */
    .post-body h2 { font-family: Georgia, 'Times New Roman', serif; font-weight: 600; color: #412402;
      font-size: 1.85rem; line-height: 1.2; letter-spacing: -.01em; margin: 3rem 0 1rem; padding-top: .25rem; text-wrap: balance; }
    .post-body h2::after { content: '' !important; display: block !important; display: block; width: 3.5rem; height: 3px; border-radius: 2px; background: #854F0B; margin-top: .6rem; }
    .post-body h3 { font-family: Georgia, 'Times New Roman', serif; font-weight: 600; color: #633806;
      font-size: 1.32rem; line-height: 1.3; margin: 2.2rem 0 .6rem; text-wrap: balance; }
    .post-body h3::before { content: '' !important; display: inline-block !important; display: inline-block; width: .45rem; height: .45rem; border-radius: 50%; background: #854F0B; margin: 0 .55rem .15rem 0; }
    .post-body h2 + p, .post-body h3 + p, .post-body h2 + figure { margin-top: .4rem; }
    .post-body > p:first-child { font-size: 1.18rem; line-height: 1.65; color: #2A1A0E; }
    .post-body blockquote { border-left: 4px solid #854F0B; background: #FAEEDA; padding: .9rem 1.2rem; border-radius: 0 .6rem .6rem 0; font-style: normal; color: #412402; }
    .post-body blockquote p { margin: 0; }
    .post-body hr { border: 0; height: 1px; background: linear-gradient(90deg, transparent, rgba(133, 79, 11, .5), transparent); margin: 2.5rem 0; }
    .post-body a { color: #633806; text-decoration: underline; text-decoration-color: rgba(133, 79, 11, .35); text-underline-offset: 3px; }
    .post-body a:hover { color: #412402; text-decoration-color: #854F0B; }
    /* The site's prose reset removes list bullets and padding; put them back
       for article lists (the contents box overrides this below). */
    .post-body ul { list-style: disc; padding-left: 1.4rem; margin: .6rem 0 1.2rem; }
    .post-body ol { list-style: decimal; padding-left: 1.5rem; margin: .6rem 0 1.2rem; }
    .post-body li { margin: .3rem 0; padding-left: .15rem; }
    .post-body ul > li::marker, .post-body ol > li::marker { color: #854F0B; font-weight: 600; }

    /* The contents list: the <ul> directly after the "contents" heading. */
    .post-body h2#contents { font-size: 1.05rem; letter-spacing: .04em; text-transform: uppercase; color: #854F0B; margin-bottom: .5rem; }
    .post-body h2#contents + ul { list-style: none; padding: .9rem 1.1rem; margin: 0 0 2rem;
      background: #FAEEDA; border: 1px solid rgba(133, 79, 11, .18); border-radius: .75rem;
      display: grid; grid-template-columns: repeat(auto-fill, minmax(17rem, 1fr)); gap: .15rem 1.5rem; }
    .post-body h2#contents + ul > li { margin: 0; padding: .2rem 0 .2rem 1.1rem; position: relative; font-size: .95rem; line-height: 1.5; }
    .post-body h2#contents + ul > li::before { content: '▸'; position: absolute; left: 0; top: .2rem; color: #854F0B; }
    .post-body h2#contents + ul > li a { text-decoration: none; color: #633806; }
    .post-body h2#contents + ul > li a:hover { text-decoration: underline; }

    /* Download button under a featured design. */
    .post-body a.dl-btn { display: inline-block; margin: .1rem 0 1.4rem; padding: .6rem 1.1rem; border-radius: .6rem;
      background: #633806; color: #FAEEDA; font-weight: 600; font-size: .95rem; text-decoration: none; line-height: 1.2;
      box-shadow: 0 1px 2px rgba(65, 36, 2, .25); transition: background .15s, transform .15s; }
    .post-body a.dl-btn:hover { background: #412402; color: #FAEEDA; transform: translateY(-1px); }
    .post-body a.dl-btn::after { content: ' →'; }

    /* Pictures: a linked product picture should read as clickable. */
    .post-body figure { margin: 1.6rem 0; }
    .post-body figure img { border-radius: .75rem; width: 100%; box-shadow: 0 6px 24px rgba(65, 36, 2, .12); }
    .post-body figure a img { transition: transform .2s; }
    .post-body figure a:hover img { transform: scale(1.01); }
    .post-body figcaption { font-size: .85rem; color: rgba(42, 26, 14, .6); margin-top: .5rem; text-align: center; }
    /* Tables: a proper ruled table with a shaded header and zebra rows, so a
       price or comparison table reads as data rather than run-on text. On a
       narrow screen it scrolls sideways inside its own box instead of
       squeezing the columns (owner request, 2026-09-05). */
    .post-body table { font-size: .92rem; width: 100%; border-collapse: separate; border-spacing: 0; margin: 1.4rem 0 1.8rem;
      border: 1px solid rgba(133, 79, 11, .28); border-radius: .6rem; overflow: hidden; line-height: 1.4;
      box-shadow: 0 2px 10px rgba(65, 36, 2, .06); }
    @media (max-width: 640px) { .post-body table { display: block; overflow-x: auto; white-space: nowrap; } }
    .post-body thead th { background: #633806; color: #FAEEDA; font-weight: 600; font-size: .8rem; letter-spacing: .04em; text-transform: uppercase;
      padding: .7rem .8rem; text-align: left; border-bottom: 2px solid #412402; }
    .post-body tbody td { padding: .6rem .8rem; border-bottom: 1px solid rgba(133, 79, 11, .15); vertical-align: top; color: #2A1A0E; }
    .post-body tbody tr:nth-child(even) td { background: #FBF5EA; }
    .post-body tbody tr:last-child td { border-bottom: 0; }
    .post-body tbody tr:hover td { background: #F6E9D2; }
    .post-body td:not(:first-child), .post-body th:not(:first-child) { white-space: nowrap; font-variant-numeric: tabular-nums; }
    .post-body td:last-child strong { color: #633806; font-size: 1.02em; }
  </style>

  <script type="application/ld+json" set:html={jsonLd({
    '@context': 'https://schema.org', '@type': 'BlogPosting',
    headline: post.title, description: (post.excerpt || '').slice(0, 300),
    image: post.cover_image_url || undefined,
    datePublished: post.published_at,
    dateModified: post.updated_at || post.published_at,
    wordCount: words,
    url: `https://digitalchiselco.com/blog/${post.slug}`,
    mainEntityOfPage: { '@type': 'WebPage', '@id': `https://digitalchiselco.com/blog/${post.slug}` },
    author: { '@type': 'Person', name: post.author || 'DigitalChiselCo' },
    publisher: { '@type': 'Organization', name: 'DigitalChiselCo', logo: { '@type': 'ImageObject', url: 'https://digitalchiselco.com/og-default.jpg' } },
  })} />
</Shell>
