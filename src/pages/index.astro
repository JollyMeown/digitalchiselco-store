---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import MakerMap from '../components/MakerMap.tsx';
import Footer from '../components/Footer.astro';
import RecentlyViewed from '../components/RecentlyViewed.astro';
import CarvedByYou from '../components/CarvedByYou.astro';
import SideMenu from '../components/SideMenu.astro';
import SiteBanner from '../components/SiteBanner.astro';
import ProductCard from '../components/ProductCard.astro';
import Marquee from '../components/Marquee.astro';
import {
  getCategories, getProducts, getSettings,
  getBestSellers, getLatestProducts, getReviews, getFaqs, getMembershipPlans,
  getPremiumBundles, MARQUEE_DEFAULTS,
} from '../lib/queries';
import { jsonLd } from '../lib/jsonld';

const s = await getSettings();
// Cut Local marketplace promo (shown on the homepage only when live).
let marketplaceOn = false;
let makerCount = 0;
let topMakers: any[] = [];
try {
  const { supabaseAdmin } = await import('../lib/supabase');
  const { data: gs } = await supabaseAdmin().from('growth_settings').select('marketplace_enabled').eq('id', 1).maybeSingle();
  marketplaceOn = !!gs?.marketplace_enabled;
  if (marketplaceOn) {
    const [{ count }, { data: mk }] = await Promise.all([
      supabaseAdmin().from('makers').select('id', { count: 'exact', head: true }).eq('status', 'approved'),
      supabaseAdmin().from('makers').select('id, maker_name, city, region, rating_avg, rating_count, jobs_completed, machine_types').eq('status', 'approved').order('rating_count', { ascending: false }).limit(3),
    ]);
    makerCount = count || 0;
    topMakers = mk || [];
  }
} catch {}
const starStr = (n: number) => '★★★★★'.slice(0, Math.max(0, Math.round(n || 0)));
const categories = await getCategories();
const [bestsellers, latest, reviews, faqs, plans, { products }, premiumBundles] = await Promise.all([
  getBestSellers(12),
  getLatestProducts(12),
  getReviews(12),
  getFaqs(20),
  getMembershipPlans(),
  getProducts(1, 24),
  getPremiumBundles(12),
]);

// fallback bestsellers if admin hasn't flagged any yet — use first 8 with images
const showBest = bestsellers.length > 0 ? bestsellers : products.filter((p) => p.image_url).slice(0, 8);
const featuredPlan = plans.find((p) => p.highlight) || plans[0];

// Per-section homepage motion config (admin → Settings → Homepage motion),
// each falling back to the built-in defaults if a key is missing.
const mq = (k: keyof typeof MARQUEE_DEFAULTS) => {
  const d = MARQUEE_DEFAULTS[k];
  const v = ((s.marquee_settings || {}) as any)[k] || {};
  return {
    enabled: v.enabled ?? d.enabled,
    speed: Number(v.speed ?? d.speed) || d.speed,
    direction: (v.direction ?? d.direction) as 'left' | 'right',
  };
};
---
<Base>
  <Header />

  <!-- Stats row (moved up — sits right below the announcement + nav, above the hero) -->
  <div class="bg-white border-b border-black/5">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 py-6 grid grid-cols-2 md:grid-cols-5 gap-4 text-center">
      <div>
        <div class="font-serif text-2xl md:text-3xl text-bronze-700">{Number(s.sales_count).toLocaleString()}+</div>
        <div class="text-[11px] uppercase tracking-widest text-ink-700/70 mt-1">STL Files Sold</div>
      </div>
      <div>
        <div class="font-serif text-2xl md:text-3xl text-bronze-700">{Number(s.rating)} <span class="text-yellow-500">★</span></div>
        <div class="text-[11px] uppercase tracking-widest text-ink-700/70 mt-1">Avg. Rating · {s.reviews_count}+ Reviews</div>
      </div>
      <div>
        <div class="font-serif text-2xl md:text-3xl text-bronze-700">{Number(s.admirers_count).toLocaleString()}+</div>
        <div class="text-[11px] uppercase tracking-widest text-ink-700/70 mt-1">Design Favorites</div>
      </div>
      <div>
        <div class="font-serif text-2xl md:text-3xl text-bronze-700">{Number(s.products_count).toLocaleString()}+</div>
        <div class="text-[11px] uppercase tracking-widest text-ink-700/70 mt-1">Unique Designs</div>
      </div>
      <div>
        <div class="font-serif text-2xl md:text-3xl text-bronze-700">{Number(s.experience_years)}+</div>
        <div class="text-[11px] uppercase tracking-widest text-ink-700/70 mt-1">Years of Craftsmanship</div>
      </div>
    </div>
    {(s as any).etsy_link_enabled && (s as any).etsy_store_url && (
      <!-- Etsy provenance link — these stats come from our Etsy shop; toggled in Admin → Settings -->
      <div class="max-w-6xl mx-auto px-4 sm:px-6 pb-4 -mt-1 flex justify-center">
        <a href={(s as any).etsy_store_url} target="_blank" rel="noopener noreferrer"
          class="group inline-flex items-center gap-2 rounded-full border border-[#F1641E]/30 bg-[#FFF3EC] pl-1.5 pr-3.5 py-1 text-xs text-ink-700 hover:border-[#F1641E] hover:bg-[#FFE9DC] transition shadow-sm"
          aria-label="Visit our Etsy store">
          <span class="inline-flex items-center justify-center w-6 h-6 rounded-full bg-[#F1641E] text-white font-serif font-bold text-[13px] leading-none select-none" aria-hidden="true">E</span>
          <span>Stats verified on our <strong class="text-[#F1641E]">Etsy</strong> store</span>
          <span class="text-[#F1641E] group-hover:translate-x-0.5 transition" aria-hidden="true">→</span>
        </a>
      </div>
    )}
  </div>

  <SiteBanner />

  <!-- Trust strip — horizontal scroll on mobile (one line, no wrap), grid on tablet+ -->
  <div class="bg-cream/40 border-y border-black/5">
    <div class="dcc-trust max-w-7xl mx-auto md:px-6 md:py-3 md:grid md:grid-cols-5 md:gap-3 text-center text-xs text-ink-700
                flex md:block overflow-x-auto md:overflow-visible whitespace-nowrap md:whitespace-normal">
      {s.trust_badges.map((b: any) => {
        const cls = 'flex items-center justify-center gap-1.5 md:gap-2 py-2 md:py-1 px-3 md:px-0 flex-shrink-0';
        return b.href ? (
          <a href={b.href} class={cls + ' hover:text-bronze-700 transition'}>
            <span class="text-base md:text-lg leading-none text-bronze-600">{b.icon}</span>
            <span class="font-medium underline-offset-2 hover:underline">{b.label}</span>
          </a>
        ) : (
          <div class={cls}>
            <span class="text-base md:text-lg leading-none text-bronze-600">{b.icon}</span>
            <span class="font-medium">{b.label}</span>
          </div>
        );
      })}
    </div>
  </div>
  <style>
    /* Hide scrollbar on the trust strip — looks cleaner on mobile */
    .dcc-trust { scrollbar-width: none; -ms-overflow-style: none; }
    .dcc-trust::-webkit-scrollbar { display: none; }
  </style>

  <!-- Main grid: side menu + content -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 py-8 flex gap-8">
    <SideMenu />
    <div class="flex-1 min-w-0 space-y-14">

      <!-- Cut Local — turn any design into a real object via a local maker -->
      {marketplaceOn && (
        <section class="cl-banner relative overflow-hidden rounded-3xl border border-white/10 shadow-xl">
          <div class="cl-grid" aria-hidden="true"></div>
          <div class="cl-glow cl-glow-a" aria-hidden="true"></div>
          <div class="cl-glow cl-glow-b" aria-hidden="true"></div>
          <div class="relative grid lg:grid-cols-[1.25fr_1fr] gap-5 lg:gap-8 items-center p-6 sm:p-8">
            <div>
              <span class="cl-in cl-in-1 cl-eyebrow inline-flex items-center gap-2.5 text-[13px] sm:text-[14px] tracking-[0.16em] uppercase text-[#a8e5dd] font-semibold px-4.5 py-2 rounded-full border border-[#2c6a67]/60 bg-[#2c6a67]/20">
                <span class="cl-live"></span> New · Cut Local maker network
              </span>
              <h2 class="cl-in cl-in-2 font-serif text-[30px] sm:text-[36px] xl:text-[40px] text-white leading-[1.08] mt-4 tracking-tight">Love a design?<br/>Get it made near you.</h2>
              <p class="cl-in cl-in-3 mt-3 text-cream/75 text-[14.5px] leading-relaxed max-w-lg">No CNC or 3D printer? No problem. Post any design and a <strong class="text-white">vetted maker near you</strong> builds it, ready for local pickup. You compare quotes and star ratings, they do the making.</p>

              <!-- mini flow -->
              <div class="cl-in cl-in-4 mt-4 hidden sm:flex items-center gap-2.5 text-cream/85 text-[13px] font-medium flex-wrap">
                <span class="cl-step">1 · Request</span>
                <svg width="16" height="8" viewBox="0 0 16 8" class="opacity-50"><path class="cl-arrow" d="M0 4h13M10 1l4 3-4 3" stroke="#f6e6cf" stroke-width="1.3" fill="none"/></svg>
                <span class="cl-step">2 · Compare quotes</span>
                <svg width="16" height="8" viewBox="0 0 16 8" class="opacity-50"><path class="cl-arrow" d="M0 4h13M10 1l4 3-4 3" stroke="#f6e6cf" stroke-width="1.3" fill="none"/></svg>
                <span class="cl-step">3 · It’s made</span>
              </div>

              <div class="cl-in cl-in-5 mt-5 flex flex-wrap gap-2.5">
                <a href="/makers" class="cl-shine group relative overflow-hidden inline-flex items-center gap-2 bg-white text-[#1c4a48] font-bold text-[14px] px-4 py-3 sm:py-2.5 rounded-xl hover:shadow-lg hover:-translate-y-0.5 transition-all shadow">
                  🛠️ See makers near you <span class="group-hover:translate-x-0.5 transition-transform">→</span>
                </a>
                <a href="/become-a-maker" class="inline-flex items-center gap-2 border border-cream/30 text-cream text-[14px] px-4 py-3 sm:py-2.5 rounded-xl hover:bg-white/10 transition backdrop-blur-sm">Own a machine? Get paid to build</a>
              </div>

              <div class="cl-in cl-in-6 mt-4 flex flex-wrap items-center gap-x-3.5 gap-y-1 text-[11px] text-cream/60">
                {makerCount > 0
                  ? <span class="inline-flex items-center gap-1.5 text-[#9fe0d9] font-medium"><span class="cl-live"></span> {makerCount} maker{makerCount === 1 ? '' : 's'} ready to build</span>
                  : <span class="inline-flex items-center gap-1.5 text-[#9fe0d9] font-medium"><span class="cl-live"></span> Now accepting founding makers</span>}
                <span>✓ Free to request</span><span>✓ Pay the maker directly</span><span>✓ Just 3% to us on completion</span>
              </div>
            </div>

            <!-- right: the LIVE maker map. Real dots at real workshops beats
                 invented cards: hover any dot for that maker's name, rating,
                 city and machines, click to open their profile. Loaded only
                 when scrolled into view so the homepage stays fast. -->
            <div class="hidden lg:block relative self-center lg:-mr-6">
              <MakerMap client:visible compact />
              <div class="mt-2 text-center text-[11px] text-cream/45">
                {makerCount > 0
                  ? <span>Hover any glowing dot to see that workshop</span>
                  : <span>The first workshops are joining now</span>}
              </div>
            </div>
            </div>
          </div>

          <style>
            .cl-banner{background:linear-gradient(135deg,#14100a 0%,#1a2321 55%,#14100a 100%)}
            .cl-eyebrow{padding-left:18px;padding-right:18px;box-shadow:inset 0 1px 0 rgba(159,224,217,.18),0 2px 14px rgba(44,106,103,.35);text-shadow:0 1px 8px rgba(159,224,217,.25)}
            .cl-grid{position:absolute;inset:0;opacity:.5;background-image:radial-gradient(rgba(246,178,90,.10) 1px,transparent 1px);background-size:26px 26px;-webkit-mask-image:radial-gradient(120% 120% at 70% 30%,#000 30%,transparent 75%);mask-image:radial-gradient(120% 120% at 70% 30%,#000 30%,transparent 75%)}
            .cl-glow{position:absolute;border-radius:50%;filter:blur(60px);opacity:.55;pointer-events:none}
            .cl-glow-a{width:340px;height:340px;top:-120px;right:-60px;background:#2c6a67}
            .cl-glow-b{width:300px;height:300px;bottom:-140px;left:-80px;background:#854F0B;opacity:.45}
            .cl-live{width:8px;height:8px;border-radius:50%;background:#39d98a;box-shadow:0 0 0 0 rgba(57,217,138,.6);animation:clLive 2s infinite}
            @keyframes clLive{0%{box-shadow:0 0 0 0 rgba(57,217,138,.55)}70%{box-shadow:0 0 0 7px rgba(57,217,138,0)}100%{box-shadow:0 0 0 0 rgba(57,217,138,0)}}
            .cl-step{background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.12);padding:5px 11px;border-radius:100px}
            .cl-nodes span{position:absolute;width:9px;height:9px;border-radius:50%;background:#f6b25a;box-shadow:0 0 12px 3px rgba(246,178,90,.6);animation:clPulse 3s ease-in-out infinite}
            @keyframes clPulse{0%,100%{transform:scale(.6);opacity:.45}50%{transform:scale(1.1);opacity:1}}
            .cl-card{position:absolute;background:rgba(28,22,14,.72);backdrop-filter:blur(10px);border:1px solid rgba(255,255,255,.14);border-radius:14px;padding:11px 13px;min-width:190px;box-shadow:0 16px 40px rgba(0,0,0,.45);animation:clFloat 6s ease-in-out infinite}
            .cl-card-0{left:2%;top:12%}
            .cl-card-1{right:0%;top:42%;animation-delay:1.2s}
            .cl-card-2{left:16%;top:70%;animation-delay:2.1s}
            @keyframes clFloat{0%,100%{transform:translateY(0)}50%{transform:translateY(-9px)}}
            .cl-ava{width:34px;height:34px;border-radius:50%;flex-shrink:0;display:grid;place-items:center;font-family:Fraunces,serif;font-weight:600;font-size:13px;color:#fff;background:linear-gradient(135deg,#2c6a67,#1c4a48)}
            .cl-grid{animation:clDrift 26s linear infinite}
            @keyframes clDrift{from{background-position:0 0}to{background-position:52px 26px}}
            .cl-in{opacity:0;transform:translateY(14px);animation:clIn .7s cubic-bezier(.2,.7,.3,1) forwards}
            .cl-in-1{animation-delay:.05s}.cl-in-2{animation-delay:.15s}.cl-in-3{animation-delay:.28s}.cl-in-4{animation-delay:.4s}.cl-in-5{animation-delay:.52s}.cl-in-6{animation-delay:.66s}
            @keyframes clIn{to{opacity:1;transform:none}}
            .cl-shine::after{content:'';position:absolute;top:0;left:-80%;width:50%;height:100%;background:linear-gradient(105deg,transparent,rgba(133,79,11,.14),transparent);transform:skewX(-20deg);animation:clShine 4.5s ease-in-out infinite}
            @keyframes clShine{0%,55%{left:-80%}75%,100%{left:140%}}
            .cl-arrow{stroke-dasharray:4 3;animation:clFlow 1.4s linear infinite}
            @keyframes clFlow{to{stroke-dashoffset:-7}}
            .cl-glow-a{animation:clBreatheA 9s ease-in-out infinite}
            .cl-glow-b{animation:clBreatheB 11s ease-in-out infinite}
            @keyframes clBreatheA{0%,100%{opacity:.55;transform:scale(1)}50%{opacity:.75;transform:scale(1.12)}}
            @keyframes clBreatheB{0%,100%{opacity:.45;transform:scale(1)}50%{opacity:.62;transform:scale(1.1)}}
            @media (prefers-reduced-motion:reduce){.cl-live,.cl-nodes span,.cl-card,.cl-grid,.cl-shine::after,.cl-arrow,.cl-glow-a,.cl-glow-b{animation:none}.cl-in{opacity:1;transform:none;animation:none}}
          </style>
        </section>
      )}

      <!-- Shop by collection -->
      <section>
        <div class="flex justify-between items-baseline mb-5">
          <h2 class="font-serif text-2xl text-ink-800">Shop by collection</h2>
          <a href="/collections" class="text-sm text-bronze-600 hover:underline">View all →</a>
        </div>
        {mq('collections').enabled ? (
          <Marquee duration={mq('collections').speed} direction={mq('collections').direction}>
            {categories.filter((c) => c.image_url).map((c) => (
              <a href={`/collections/${c.slug}`} class="block w-[260px] sm:w-[300px] border border-black/10 rounded-lg overflow-hidden hover:shadow-md transition group">
                <div class="aspect-[16/9] bg-cream overflow-hidden">
                  <img src={c.image_url} alt={c.name} loading="lazy" class="w-full h-full object-cover group-hover:scale-[1.04] transition duration-500" />
                </div>
              </a>
            ))}
          </Marquee>
        ) : (
          <div class="grid grid-cols-2 md:grid-cols-3 gap-4">
            {categories.slice(0, 6).map((c) => (
              <a href={`/collections/${c.slug}`} class="block border border-black/10 rounded-lg overflow-hidden hover:shadow-md transition group">
                <div class="aspect-[16/9] bg-cream overflow-hidden">
                  {c.image_url
                    ? <img src={c.image_url} alt={c.name} loading="lazy" class="w-full h-full object-cover group-hover:scale-[1.04] transition duration-500" />
                    : <div class="w-full h-full flex items-center justify-center font-serif text-bronze-600/50 text-center px-3">{c.name}</div>}
                </div>
                {!c.image_url && <div class="p-3 text-sm">{c.name}</div>}
              </a>
            ))}
          </div>
        )}
      </section>

      <!-- Premium Bundles — slow marquee. Curated savings, top of the homepage stack. -->
      {premiumBundles.length > 0 && (
        <section class="relative">
          <div class="absolute inset-0 -mx-4 sm:-mx-6 rounded-2xl bg-gradient-to-br from-[#FAEEDA] via-[#fbf4e6] to-[#FAC775]/40 -z-10" aria-hidden="true"></div>
          <div class="py-6">
            <div class="flex justify-between items-end flex-wrap gap-2 mb-4 px-1">
              <div class="min-w-0">
                <div class="text-[11px] tracking-[0.18em] uppercase text-bronze-700/80 font-medium">🔥 Limited-time savings</div>
                <h2 class="font-serif text-xl sm:text-2xl md:text-3xl text-bronze-800 mt-0.5">PREMIUM BUNDLES</h2>
              </div>
              <a href="/collections/premium-bundle-offer" class="text-sm text-bronze-700 hover:underline whitespace-nowrap">See all bundles →</a>
            </div>
            <Marquee duration={mq('premium').speed} direction={mq('premium').direction}>
              {premiumBundles.map((p) => (
                <div class="w-[220px] sm:w-[240px]"><ProductCard product={p} discount={s.discount_percent} /></div>
              ))}
            </Marquee>
            <p class="text-xs text-bronze-700/60 mt-2 px-1 text-right italic">Hover to pause · slow-roll curated savings</p>
          </div>
        </section>
      )}

      <!-- Best Sellers (admin-selected) — animated marquee -->
      {showBest.length > 0 && (
        <section>
          <div class="flex justify-between items-baseline mb-4">
            <h2 class="font-serif text-2xl text-ink-800">★ Best Sellers</h2>
            <a href="/catalog" class="text-sm text-bronze-600 hover:underline">Shop all →</a>
          </div>
          <Marquee duration={mq('bestsellers').speed} direction={mq('bestsellers').direction}>
            {showBest.map((p) => (
              <div class="w-[200px] sm:w-[220px]"><ProductCard product={p} discount={s.discount_percent} /></div>
            ))}
          </Marquee>
          <p class="text-xs text-ink-700/50 mt-2 text-right">Hover to pause · set bestsellers in admin → Products → "★ Best seller"</p>
        </section>
      )}

      <!-- Latest 3D Designs -->
      {latest.length > 0 && (
        <section>
          <div class="flex justify-between items-baseline mb-4">
            <h2 class="font-serif text-2xl text-ink-800">Latest 3D Designs</h2>
            <a href="/catalog" class="text-sm text-bronze-600 hover:underline">Browse catalog →</a>
          </div>
          <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4">
            {latest.slice(0, 12).map((p) => <ProductCard product={p} discount={s.discount_percent} />)}
          </div>
        </section>
      )}
    </div>
  </div>

  <!-- Loved by makers — DB-driven, scrolling marquee -->
  {reviews.length > 0 && (
    <section class="bg-cream/60 py-12">
      <div class="max-w-6xl mx-auto px-4 sm:px-6">
        <div class="text-center mb-7">
          <h2 class="font-serif text-3xl md:text-4xl text-bronze-800">Loved by makers</h2>
          <p class="text-sm text-bronze-700 mt-2">★★★★★ {Number(s.rating)} average · {s.reviews_count}+ verified reviews</p>
        </div>
        <Marquee duration={mq('reviews').speed} direction={mq('reviews').direction}>
          {reviews.map((r) => (
            <figure class="w-[300px] md:w-[340px] bg-white border border-black/10 rounded-lg p-5">
              <div class="text-bronze-600 mb-2 text-sm">{'★'.repeat(r.rating)}{'☆'.repeat(5 - r.rating)}</div>
              <blockquote class="text-sm text-ink-700 leading-relaxed">"{r.text}"</blockquote>
              <figcaption class="mt-3 text-sm font-medium text-ink-800">— {r.name}{r.source ? <span class="text-ink-700/50 font-normal"> · {r.source}</span> : null}</figcaption>
            </figure>
          ))}
        </Marquee>
      </div>
    </section>
  )}

  <!-- Carved by you — customer creations (social proof, placed with reviews) -->
  <CarvedByYou enabled={mq('creations').enabled} speed={mq('creations').speed} direction={mq('creations').direction} />


  <!-- Become a member CTA — placed just above FAQ -->
  {featuredPlan && (
    <section class="max-w-6xl mx-auto px-4 sm:px-6 py-10">
      <div class="border border-bronze-600/20 rounded-2xl bg-gradient-to-br from-cream to-white p-6 md:p-8">
        <div class="grid md:grid-cols-2 gap-6 items-center">
          <div>
            <p class="text-xs tracking-widest text-bronze-600 mb-2">★ MOST POPULAR PLAN</p>
            <h2 class="font-serif text-3xl text-bronze-800 leading-tight">{s.membership_title}</h2>
            <p class="mt-3 text-ink-700/85 leading-relaxed">{s.membership_subtitle}</p>
            <ul class="mt-4 text-sm text-ink-700 space-y-1.5">
              {featuredPlan.features.slice(0, 4).map((f) => (
                <li class="flex gap-2"><span class="text-bronze-600">✓</span>{f}</li>
              ))}
            </ul>
            <div class="mt-6 flex flex-wrap gap-3">
              <a href="/membership" class="bg-bronze-600 text-cream px-6 py-3 rounded-md text-sm hover:bg-bronze-700 transition shadow-sm">
                Become a member — ${Number(featuredPlan.price_usd).toFixed(2)}
              </a>
              <a href="/membership" class="border border-bronze-600 text-bronze-700 px-6 py-3 rounded-md text-sm hover:bg-bronze-600/10 transition">
                Lock in your low price →
              </a>
            </div>
          </div>
          <div class="order-first md:order-last">
            {s.membership_image_url
              ? <img src={s.membership_image_url} alt="Premium Membership poster" class="w-full h-auto rounded-lg shadow-md max-h-[440px] object-contain bg-cream" />
              : <div class="aspect-[3/4] bg-cream rounded-lg flex items-center justify-center text-bronze-600/40 font-serif text-center px-6 max-h-[440px]">
                  Upload the Premium Membership poster in admin → Media & Hero → "Membership card"
                </div>}
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- Free files lead magnet -->
  <section class="bg-cream/40">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 py-12 grid md:grid-cols-2 gap-8 items-center">
      <div class="dcc-free-img-wrap bg-cream rounded-lg overflow-hidden border border-black/10">
        {s.free_image_url
          ? <img src={s.free_image_url} alt="Free STL files pack" class="w-full h-auto block dcc-free-img" />
          : <div class="aspect-[4/3] flex items-center justify-center text-bronze-600/40 font-serif text-center px-6">Upload a "free pack" image in admin → Media & Hero</div>}
      </div>
      <div>
        <p class="text-xs tracking-widest text-bronze-600 mb-2">★ FREE FROM OUR STUDIO</p>
        <h2 class="font-serif text-3xl text-bronze-800 leading-tight">Try five of our <em class="italic">most carved</em> files, on the house.</h2>
        <p class="mt-4 text-ink-700">Drop your email and we'll send five hand-picked premium bas-relief STL files, plus a short PDF on scaling and finishing — everything tested on real CNC routers, 3D printers and laser engravers.</p>
        <a href="/free" class="mt-6 inline-block bg-bronze-600 text-cream px-6 py-3 rounded-md text-sm hover:bg-bronze-700 transition">Send me the pack →</a>
        <p class="text-xs text-ink-700/50 mt-2">No spam. Unsubscribe anytime.</p>
      </div>
    </div>
  </section>
  <style>
    .dcc-free-img { transition: transform 0.6s ease; }
    .dcc-free-img-wrap:hover .dcc-free-img { transform: scale(1.05); }
  </style>

  <!-- FAQ -->
  {faqs.length > 0 && (
    <section class="max-w-3xl mx-auto px-4 sm:px-6 py-14">
      <h2 class="font-serif text-2xl text-center mb-2">Frequently asked questions</h2>
      <p class="text-center text-sm text-ink-700/60 mb-8">
        The four we are asked most. <a href="/faq" class="text-bronze-700 font-medium hover:underline">See every question answered →</a>
      </p>
      <div class="space-y-3">
        {faqs.map((f) => (
          <details class="dcc-faq border border-black/10 rounded-lg overflow-hidden bg-white">
            <summary class="cursor-pointer font-medium text-ink-800 list-none flex justify-between items-center p-4 hover:bg-cream/50 transition">
              <span>{f.question}</span>
              <span class="text-bronze-600 text-xl leading-none transition-transform">+</span>
            </summary>
            <div class="px-4 pb-4 text-sm text-ink-700 leading-relaxed whitespace-pre-line">{f.answer}</div>
          </details>
        ))}
      </div>
    </section>
  )}
  <style>
    .dcc-faq[open] summary > span:last-child { transform: rotate(45deg); }
    .dcc-faq > div { animation: dcc-fade 0.25s ease-out; }
    @keyframes dcc-fade { from { opacity: 0; transform: translateY(-4px); } to { opacity: 1; transform: translateY(0); } }
  </style>

  <!-- Closing brand strip (product-focused) -->
  <section class="bg-bronze-800 text-cream">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 py-10 text-center">
      <p class="text-xs tracking-widest text-[#FAC775] mb-2">★ DIGITALCHISELCO STUDIO</p>
      <p class="font-serif text-2xl md:text-3xl leading-snug max-w-3xl mx-auto">Hand-finished bas-relief STL designs built for serious CNC, laser, and 3D-print makers.</p>
      <p class="mt-4 text-sm text-cream/80 max-w-2xl mx-auto">Every file is tested on real machines before it ships. Commercial use is included on every purchase — sell the pieces you carve.</p>
      <a href="/catalog" class="mt-6 inline-block bg-cream text-bronze-800 px-6 py-3 rounded-md text-sm font-medium hover:bg-white transition shadow-sm">Browse the catalog →</a>
    </div>
  </section>

  <RecentlyViewed title="Recently viewed" />
  <Footer />
  <script type="application/ld+json" set:html={jsonLd({
    '@context': 'https://schema.org', '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.question, acceptedAnswer: { '@type': 'Answer', text: f.answer } })),
  })} />
</Base>
