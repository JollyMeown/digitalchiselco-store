---
// Seasonal collection landing page — auto-populated from keyword matches, and
// auto-hidden outside its date window. Managed in admin → Seasonal. Great for
// "Christmas Carvings 2026", "Halloween Reliefs", etc. cross-linked from the
// weekly digest and homepage in the run-up to each holiday.
import Shell from '../../layouts/Shell.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ProductCard from '../../components/ProductCard.astro';
import { getSettings } from '../../lib/queries';
import { supabaseAdmin } from '../../lib/supabase';

const { slug } = Astro.params;
const db = supabaseAdmin();
const nowIso = new Date().toISOString();

const { data: col } = await db.from('seasonal_collections').select('*').eq('slug', slug!).eq('active', true).maybeSingle();
// respect the date window (null edges = open-ended)
const inWindow = col && (!col.starts_at || col.starts_at <= nowIso) && (!col.ends_at || col.ends_at >= nowIso);
if (!col || !inWindow) return Astro.redirect('/collections');

const settings = await getSettings();
const keywords: string[] = Array.isArray(col.keywords) ? col.keywords.filter(Boolean) : [];
let products: any[] = [];
if (keywords.length) {
  const orExpr = keywords.slice(0, 12).map((k) => `title.ilike.*${String(k).replace(/[,()*]/g, '')}*`).join(',');
  const { data } = await db.from('products')
    .select('id, title, slug, price_usd, image_url, is_bundle, link_status')
    .eq('active', true).not('image_url', 'is', null).or(orExpr)
    .order('created_at', { ascending: false }).limit(60);
  products = data || [];
}
const meta = (col.subtitle || `Seasonal bas-relief STL designs: ${col.title}.`).slice(0, 155);
---
<Shell title={`${col.title} | DigitalChiselCo`} description={meta} scrollPastBanner={true}>
  <Breadcrumbs crumbs={[{ label: 'Collections', href: '/collections' }, { label: col.title }]} />
  {col.hero_image_url ? (
    <div class="mb-5 overflow-hidden rounded-lg"><img src={col.hero_image_url} alt={col.title} class="w-full h-auto block" loading="eager" /></div>
  ) : (
    <section class="mb-6 -mx-4 sm:-mx-6 px-5 sm:px-6 py-8 bg-gradient-to-br from-[#FAEEDA] via-[#fbf4e6] to-[#FAC775]/40 rounded-2xl border border-[#FAC775]/30">
      <div class="text-[11px] tracking-[0.18em] uppercase text-bronze-700/80 font-medium mb-2">✨ Seasonal collection</div>
      <h1 class="font-serif text-2xl sm:text-3xl md:text-4xl text-bronze-800 leading-tight">{col.title}</h1>
      {col.subtitle && <p class="mt-2 max-w-3xl text-sm md:text-[15px] text-ink-800 leading-relaxed">{col.subtitle}</p>}
    </section>
  )}
  <p class="text-ink-700/70 text-sm mb-6">{products.length} handpicked designs</p>
  {products.length ? (
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4">
      {products.map((p) => <ProductCard product={p} discount={settings.discount_percent} />)}
    </div>
  ) : (
    <p class="text-ink-700/60 text-sm">New designs are being added to this collection — check back soon.</p>
  )}
</Shell>
