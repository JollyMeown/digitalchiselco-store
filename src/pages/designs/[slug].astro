---
import Shell from '../../layouts/Shell.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ProductCard from '../../components/ProductCard.astro';
import { getSettings } from '../../lib/queries';
import { supabase } from '../../lib/supabase';
import { jsonLd } from '../../lib/jsonld';
import { topicBySlug } from '../../lib/landing';

const { slug } = Astro.params;
const topic = topicBySlug(slug!);
if (!topic) return Astro.rewrite('/404');

const settings = await getSettings();
const SITE = 'https://digitalchiselco.com';

let q = supabase.from('products')
  .select('id, slug, title, price_usd, image_url, is_bundle, rating_avg, rating_count')
  .eq('active', true).not('image_url', 'is', null);
if (topic.keywords.length) {
  q = q.or(topic.keywords.map((k) => `title.ilike.%${k}%`).join(','));
  q = q.order('is_bestseller', { ascending: false });
} else {
  q = q.order('is_bestseller', { ascending: false }).order('created_at', { ascending: false });
}
const { data: products } = await q.limit(48);
const list = products || [];

const itemListLd = {
  '@context': 'https://schema.org', '@type': 'CollectionPage', name: topic.h1, description: topic.intro,
  url: `${SITE}/designs/${topic.slug}`,
  mainEntity: {
    '@type': 'ItemList', numberOfItems: list.length,
    itemListElement: list.slice(0, 24).map((p, i) => ({
      '@type': 'ListItem', position: i + 1, url: `${SITE}/product/${p.slug}`, name: String(p.title || '').split('|')[0].trim(),
    })),
  },
};
const faqLd = topic.faqs?.length ? {
  '@context': 'https://schema.org', '@type': 'FAQPage',
  mainEntity: topic.faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
} : null;
---
<Shell title={topic.title + ' | DigitalChiselCo'} description={topic.intro.slice(0, 155)} scrollPastBanner={true}>
  <Breadcrumbs crumbs={[{ label: 'Designs', href: '/designs' }, { label: topic.h1 }]} />
  <h1 class="text-2xl md:text-3xl mb-2">{topic.h1}</h1>
  <p class="text-ink-700/80 text-sm md:text-[15px] mb-6 max-w-3xl leading-relaxed">{topic.intro}</p>

  {list.length ? (
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4">
      {list.map((p) => <ProductCard product={p} discount={settings.discount_percent} />)}
    </div>
  ) : (
    <p class="text-ink-700/70">New designs in this theme are on the way. <a href="/catalog" class="text-bronze-700">Browse the full catalog →</a></p>
  )}

  {topic.faqs?.length && (
    <section class="mt-12 max-w-3xl">
      <h2 class="text-xl mb-4">Frequently asked</h2>
      {topic.faqs.map((f) => (
        <div class="mb-4">
          <h3 class="font-medium text-ink-800">{f.q}</h3>
          <p class="text-sm text-ink-700/80 mt-1">{f.a}</p>
        </div>
      ))}
    </section>
  )}

  <section class="mt-12 border-t border-black/10 pt-6">
    <p class="text-sm text-ink-700/70">Looking for something specific? <a href="/catalog" class="text-bronze-700 font-medium">Browse all designs</a> or <a href="/designs" class="text-bronze-700 font-medium">explore more themes</a>.</p>
  </section>

  <script type="application/ld+json" set:html={jsonLd(itemListLd)} />
  {faqLd && <script type="application/ld+json" set:html={jsonLd(faqLd)} />}
</Shell>
