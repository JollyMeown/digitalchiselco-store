---
import Shell from '../layouts/Shell.astro';
import CutLocalStrip from '../components/CutLocalStrip.astro';
---
<Shell title="Get 5 Free Premium STL Files | DigitalChiselCo" description="Join our list and get 5 premium bas-relief STL files free, plus the CNC woodcarving guide. For CNC routers, 3D printers and laser engravers." scrollPastBanner={true}>
  <main class="bg-cream rounded-lg">
    <section class="max-w-2xl mx-auto px-6 py-14 text-center">
      <p class="text-xs tracking-widest text-bronze-600 mb-3">FREE STARTER PACK</p>
      <h1 class="text-3xl md:text-4xl text-bronze-800 leading-tight">Get <em class="italic">5 premium STL files</em> — free</h1>
      <p class="mt-4 text-bronze-700">Plus our CNC woodcarving guide. Drop your email and we'll send your free bas-relief pack, ready for CNC routers, 3D printers and laser engravers.</p>

      <form id="sub" class="mt-8 grid gap-3 max-w-md mx-auto">
        <input id="name" type="text" required placeholder="Your name"
          class="px-4 py-3 rounded-md border border-bronze-600/30 focus:outline-none focus:border-bronze-600 bg-white" />
        <input id="email" type="email" required placeholder="you@email.com"
          class="px-4 py-3 rounded-md border border-bronze-600/30 focus:outline-none focus:border-bronze-600 bg-white" />
        <button type="submit" class="bg-bronze-600 text-cream px-6 py-3 rounded-md hover:bg-bronze-700 transition">Send my files</button>
      </form>
      <p id="msg" class="mt-4 text-sm hidden"></p>

      <ul class="mt-10 text-sm text-bronze-700 space-y-2 text-left max-w-sm mx-auto">
        <li>✅ 5 hand-picked premium bas-relief STL files</li>
        <li>✅ CNC woodcarving guide (PDF)</li>
        <li>✅ Tested in Aspire, VCarve Pro, Carveco, ArtCAM, Fusion 360</li>
        <li>✅ No spam — unsubscribe anytime</li>
      </ul>

      {/* The commonest email the shop receives is "I cannot find the original
          e-mail with the download link, please send again." Answering it used
          to be a manual job; now the person who lost it can help themselves. */}
      <div class="mt-6 pt-5 border-t border-bronze-600/15 text-left">
        <p class="text-sm text-ink-700/70">
          Already signed up and lost the email?
          <button id="resend-open" type="button" class="text-bronze-700 underline">Get your download link again</button>.
        </p>
        <form id="resend" class="hidden mt-3 flex flex-col sm:flex-row gap-2">
          <input id="remail" type="email" required placeholder="The email you signed up with"
                 class="flex-1 border border-black/15 rounded-lg px-4 py-2.5 text-sm focus:outline-none focus:border-bronze-600" />
          <button class="bg-bronze-600 text-cream px-5 py-2.5 rounded-lg text-sm hover:bg-bronze-700 transition">Send my link</button>
        </form>
        <p id="rmsg" class="mt-2 text-sm text-ink-700/70"></p>
      </div>

      <div class="text-left"><CutLocalStrip /></div>
    </section>
  </main>
  <script is:inline>
    const form = document.getElementById('sub');
    const msg = document.getElementById('msg');
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const name = document.getElementById('name').value.trim();
      const email = document.getElementById('email').value.trim();
      msg.className = 'mt-4 text-sm text-bronze-700';
      msg.textContent = 'Sending…';
      try {
        const res = await fetch('/api/subscribe', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ name, email }) });
        const data = await res.json();
        if (res.ok) {
          msg.className = 'mt-4 text-sm text-green-700';
          msg.textContent = '✓ Check your inbox! We sent a confirmation email — click the link inside to receive your free STL pack.';
          form.reset();
        } else {
          msg.className = 'mt-4 text-sm text-red-600';
          msg.textContent = data.error || 'Something went wrong.';
        }
      } catch {
        msg.className = 'mt-4 text-sm text-red-600';
        msg.textContent = 'Network error. Please try again.';
      }
    });

    // "send it again" for people who already subscribed
    const rform = document.getElementById('resend');
    const rmsg = document.getElementById('rmsg');
    document.getElementById('resend-open').addEventListener('click', () => {
      rform.classList.remove('hidden');
      document.getElementById('remail').focus();
    });
    rform.addEventListener('submit', async (e) => {
      e.preventDefault();
      rmsg.className = 'mt-2 text-sm text-bronze-700';
      rmsg.textContent = 'Sending…';
      try {
        const res = await fetch('/api/free-resend', {
          method: 'POST', headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ email: document.getElementById('remail').value.trim() }),
        });
        const data = await res.json();
        rmsg.className = 'mt-2 text-sm ' + (res.ok ? 'text-green-700' : 'text-red-600');
        rmsg.textContent = data.message || data.error || 'Something went wrong.';
        if (res.ok) rform.reset();
      } catch {
        rmsg.className = 'mt-2 text-sm text-red-600';
        rmsg.textContent = 'Network error. Please try again.';
      }
    });
  </script>
</Shell>
