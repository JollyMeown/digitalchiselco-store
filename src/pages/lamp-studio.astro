        {[
          { img: '/lamp-studio/ui-1.jpg', t: 'Step 1 · Profile', p: 'Presets, size and orientation, plus the 105-shape library with live silhouette thumbnails.' },
          { img: '/lamp-studio/ui-2.jpg', t: 'Step 2 · Detail', p: 'Two-tone blends, lithophane photos, curved text and 11 stackable modifiers.' },
          { img: '/lamp-studio/ui-3.jpg', t: 'Step 3 · Fitter', p: 'E27/E14/B22/GU10 holder with 8 spoke styles — auto-sized to the shade opening.' },
          { img: '/lamp-studio/ui-4.jpg', t: 'Step 4 · Export', p: 'Computed vase-mode slicer settings, printer-bed check and watertight STL/OBJ/3MF export.' },
        ].map((c, n) => (
          <a href={c.img} target="_blank" rel="noopener" class={`reveal reveal-d${n % 2} group border border-bronze-600/25 rounded-xl overflow-hidden bg-white hover:shadow-xl hover:-translate-y-1 transition-all duration-300 block`}>
            <div class="overflow-hidden bg-[#0b0f17]">
              <img src={c.img} alt={`${c.t} of the 3D printable lampshade generator — annotated interface screenshot`} width="1600" height="943" loading="lazy" decoding="async" class="w-full group-hover:scale-[1.02] transition-transform duration-500" />
            </div>
            <div class="p-4 border-t border-bronze-600/15">
              <strong class="text-bronze-800 font-serif">{c.t}</strong>
              <p class="text-sm text-ink-700/80 mt-1">{c.p}</p>
            </div>
          </a>
        ))}
      </div>
      <p class="mt-3 text-xs text-ink-700/60 text-center">Numbered balloons on each screenshot match the legends in the included manual.</p>
    </section>

    <!-- ===== SAMPLE PRINT GUIDE ===== -->
    <section class="mb-16">
      <div class="grid md:grid-cols-2 gap-8 items-center reveal">
        <div>
          <p class="text-xs tracking-widest text-bronze-600 mb-2">NO GUESSWORK PRINTING</p>
          <h3 class="font-serif text-3xl text-bronze-800 leading-snug">A print guide,<br/>computed per lamp.</h3>
          <p class="mt-4 text-ink-700/85 leading-relaxed">
            One click in the Studio writes a professional PDF tailored to <em>your exact design</em> — including the
            one-piece vase-mode recipe: <strong>Bottom shell layers = ring height ÷ layer height</strong>, so the slicer
            prints the bulb holder solid and spiralizes the shade above it automatically.
          </p>
          <ul class="mt-4 space-y-2 text-sm text-ink-700/85">
            <li class="flex gap-2"><span class="text-bronze-600">✓</span> Your model's exact dimensions, ring height and layer counts</li>
            <li class="flex gap-2"><span class="text-bronze-600">✓</span> Combined one-piece settings <em>and</em> separate-parts settings</li>
            <li class="flex gap-2"><span class="text-bronze-600">✓</span> Assembly steps and LED-bulb safety notes</li>
          </ul>
          <a href="/lamp-studio/sample-print-guide.pdf" download
             class="mt-6 inline-flex items-center gap-2 bg-bronze-600 text-cream px-6 py-3 rounded-md text-sm font-medium hover:bg-bronze-700 hover:shadow-lg hover:-translate-y-0.5 transition-all shadow">
            📄 Download a sample print guide (PDF)
          </a>
        </div>
        <a href="/lamp-studio/sample-print-guide.pdf" target="_blank" rel="noopener" class="img-zoom rounded-xl overflow-hidden border border-bronze-600/25 shadow-lg max-w-sm mx-auto md:mx-0 block">
          <img src="/lamp-studio/guide-preview.jpg" alt="Sample per-design PDF print guide with computed vase mode slicer settings for a 3D printed lampshade with E27 fitter" width="953" height="1348" loading="lazy" decoding="async" class="w-full transition-transform duration-500" />
        </a>
      </div>
    </section>

    <!-- ===== POSTER / EVERYTHING INSIDE ===== -->
    <section class="mb-16">
      <div class="grid md:grid-cols-2 gap-8 items-center reveal">
        <figure class="img-zoom rounded-xl overflow-hidden border border-bronze-600/25 shadow-lg max-w-md mx-auto md:mx-0">
          <img src={IMG.poster} alt="Vase Lampshade Studio feature overview — 105 parametric 3D printing lamp shade shapes, lithophane maker, custom text emboss, profile editor, printer bed fit check and auto-calculated vase mode slicer settings" width="1024" height="1536" loading="lazy" decoding="async" class="w-full transition-transform duration-500" />
        </figure>
        <div>
          <p class="text-xs tracking-widest text-bronze-600 mb-2">EVERYTHING INSIDE</p>
          <h3 class="font-serif text-3xl text-bronze-800 leading-snug">A complete lamp<br/>design studio.</h3>
          <ul class="mt-5 space-y-2.5 text-sm text-ink-700/85">
            <li class="flex gap-2"><span class="text-bronze-600">✓</span> 105 parametric shapes in 7 families, each with live silhouette previews</li>
            <li class="flex gap-2"><span class="text-bronze-600">✓</span> E27 · E14 · B22 · GU10 fitters — 8 spoke styles, auto-sized to the opening</li>
            <li class="flex gap-2"><span class="text-bronze-600">✓</span> Lithophane photo embossing (wrap, tile or front-panel)</li>
            <li class="flex gap-2"><span class="text-bronze-600">✓</span> Curved text — glowing, raised or engraved</li>
            <li class="flex gap-2"><span class="text-bronze-600">✓</span> Draw-your-own profile editor + trace-from-image</li>
            <li class="flex gap-2"><span class="text-bronze-600">✓</span> 11 stackable modifiers: twist, weave, ribs, facet & more</li>
            <li class="flex gap-2"><span class="text-bronze-600">✓</span> Lit preview — see the lamp glowing before you print</li>
            <li class="flex gap-2"><span class="text-bronze-600">✓</span> Printer-bed fit check, bulb clearance, material estimates</li>
            <li class="flex gap-2"><span class="text-bronze-600">✓</span> Watertight STL / OBJ / 3MF + per-design PDF print guide</li>
          </ul>
          <p class="mt-5 text-sm text-ink-700/85 border-t border-bronze-600/20 pt-4">
            All of it, with every v1.x update free, for <strong class="font-serif text-xl text-bronze-800">one payment of {P}</strong>.
            <a href={BUY} class="text-bronze-700 underline underline-offset-2 hover:text-bronze-800 font-medium">Get the Studio →</a>
          </p>
        </div>
      </div>
    </section>

    <!-- ===== FACTS ===== -->
    <section class="mb-8 text-center reveal">
      <h2 class="font-serif text-3xl text-bronze-800">The plain facts</h2>
      <ul class="not-prose mt-5 grid sm:grid-cols-2 gap-3 text-sm max-w-2xl mx-auto text-left text-ink-700/85">
        <li class="flex gap-2"><span class="text-bronze-600">✓</span> Windows 10 / 11 installer — desktop, start-menu &amp; startup shortcuts</li>
        <li class="flex gap-2"><span class="text-bronze-600">✓</span> <strong class="text-bronze-800">{P}, one time.</strong>&nbsp;No subscription, ever</li>
        <li class="flex gap-2"><span class="text-bronze-600">✓</span> 100% offline — your photos never leave your PC</li>
        <li class="flex gap-2"><span class="text-bronze-600">✓</span> Illustrated user manual + per-lamp PDF print guides</li>
        <li class="flex gap-2"><span class="text-bronze-600">✓</span> Sell what you print — your designs are yours, commercially</li>
        <li class="flex gap-2"><span class="text-bronze-600">✓</span> Made by the studio behind {DESIGNS} STL designs</li>
      </ul>
    </section>

    <section class="mt-12 mb-4 border border-bronze-600/30 rounded-xl p-8 text-center bg-gradient-to-br from-cream to-white reveal">
      <h3 class="font-serif text-2xl text-bronze-800">Design tonight. Print tonight. Glow tonight.</h3>
      <p class="mt-2 text-ink-700">Own the Studio forever — and turn every bulb in the house into something you made.</p>
      <p class="mt-4">
        <strong class="font-serif text-4xl text-bronze-800 align-middle">{P}</strong>
        <span class="text-sm text-ink-700/70 align-middle ml-2">one-time</span>
      </p>
      <div class="mt-5 flex flex-wrap justify-center gap-3">
        <a href={BUY} class="bg-bronze-600 text-cream px-7 py-3 rounded-md text-sm font-medium hover:bg-bronze-700 hover:shadow-lg hover:-translate-y-0.5 transition-all shadow">Get Vase Lampshade Studio for {P} →</a>
        <a href="#playground" class="border border-bronze-600 text-bronze-700 px-7 py-3 rounded-md text-sm hover:bg-bronze-600/10 transition">Keep playing first</a>
      </div>
    </section>

  </article>

  <!-- Sticky buy bar. Someone who has spent five minutes designing a lamp
       should never have to hunt for the price. Appears once the playground is
       behind them, hides again at the price card so it never covers it. -->
  <div id="vls-bar" class="fixed inset-x-0 bottom-0 z-40 translate-y-full transition-transform duration-300 print:hidden">
    <div class="mx-auto max-w-5xl m-3 rounded-xl border border-bronze-600/35 bg-white/96 backdrop-blur shadow-2xl px-4 py-3 flex items-center gap-3 flex-wrap justify-center sm:justify-between">
      <div class="text-sm text-ink-700/85 text-center sm:text-left">
        <b class="text-bronze-800">Like what you designed?</b>
        <span class="hidden sm:inline"> Export it, print it, keep it. </span>
        <b class="text-bronze-800">{P}</b> once.
      </div>
      <a href={BUY} class="bg-bronze-600 text-cream px-6 py-2.5 rounded-md text-sm font-semibold hover:bg-bronze-700 transition shadow">Unlock the full Studio →</a>
    </div>
  </div>
</Shell>

<style is:global>
  .js-anim .reveal { opacity: 0; transform: translateY(22px); transition: opacity .7s ease, transform .7s ease; }
  .js-anim .reveal.in { opacity: 1; transform: none; }
  .js-anim .reveal.now { transition: none !important; }
  .js-anim .reveal-d1 { transition-delay: .12s; }
  .js-anim .reveal-d2 { transition-delay: .24s; }
  .js-anim .reveal-d3 { transition-delay: .36s; }
  .img-zoom:hover img { transform: scale(1.03); }
  @media (prefers-reduced-motion: reduce) { .js-anim .reveal { opacity: 1; transform: none; transition: none; } }
</style>

<script is:inline>
  // Sticky buy bar: show it once the playground has scrolled past, hide it
  // again while the big price card is on screen so the two never fight.
  (function () {
    var bar = document.getElementById('vls-bar');
    var play = document.getElementById('playground');
    if (!bar || !play) return;
    var card = document.querySelector('a[href][class*="px-10"]');
    function tick() {
      var pastTool = play.getBoundingClientRect().bottom < 60;
      var cardVisible = false;
      if (card) { var r = card.getBoundingClientRect(); cardVisible = r.top < (window.innerHeight || 800) && r.bottom > 0; }
      bar.classList.toggle('translate-y-full', !pastTool || cardVisible);
    }
    var t = 0;
    window.addEventListener('scroll', function () {
      var n = Date.now(); if (n - t < 120) return; t = n; tick();
    }, { passive: true });
    window.addEventListener('resize', tick, { passive: true });
    tick();
  })();
</script>

<script is:inline>
  (function () {
    var els = Array.prototype.slice.call(document.querySelectorAll('.reveal'));
    if (!els.length) return;
    document.documentElement.classList.add('js-anim');
    function pass() {
      var vh = window.innerHeight || 800;
      els = els.filter(function (el) {
        var r = el.getBoundingClientRect();
        if (r.top < vh * 0.92 && r.bottom > 0) { el.classList.add('in'); return false; }
        return true;
      });
      if (!els.length) {
        window.removeEventListener('scroll', onScroll);
        window.removeEventListener('resize', onScroll);
      }
    }
    var last = 0;
    function onScroll() {
      var now = Date.now();
      if (now - last < 80) return;
      last = now; pass();
    }
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll, { passive: true });
    pass();
    setTimeout(pass, 300);
    setTimeout(function () {
      document.querySelectorAll('.reveal').forEach(function (el) { el.classList.add('now', 'in'); });
      els = [];
      window.removeEventListener('scroll', onScroll);
      window.removeEventListener('resize', onScroll);
    }, 2500);
  })();

  // ── Playground engagement beacon ──────────────────────────────────────
  // Fire ONE 'lamp_try' event the first time the live playground iframe is
  // actually scrolled into view (≥40% visible) — a much stronger "used the
  // app" signal than a bare landing-page view. Feeds Admin → Traffic.
  (function () {
    var frame = document.querySelector('#playground iframe');
    if (!frame || !('IntersectionObserver' in window)) return;
    var fired = false;
    function beacon() {
      if (fired) return; fired = true;
      try {
        var d = JSON.stringify({ t: 'lamp_try', p: '/lamp-studio' });
        if (navigator.sendBeacon) navigator.sendBeacon('/api/track', new Blob([d], { type: 'application/json' }));
        else fetch('/api/track', { method: 'POST', body: d, keepalive: true, headers: { 'content-type': 'application/json' } });
      } catch (_) {}
    }
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (e) { if (e.isIntersecting && e.intersectionRatio >= 0.4) { beacon(); io.disconnect(); } });
    }, { threshold: [0, 0.4] });
    io.observe(frame);
    // Also count a click into the iframe (it steals focus on interaction).
    window.addEventListener('blur', function () {
      if (document.activeElement === frame) beacon();
    });
  })();
</script>
