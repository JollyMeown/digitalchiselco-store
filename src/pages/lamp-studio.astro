---
import Shell from '../layouts/Shell.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { getSettings, designCountLabel } from '../lib/queries';
import { supabaseAdmin } from '../lib/supabase';
const s: any = await getSettings();
const DESIGNS = await designCountLabel();   // "1,900+", kept true by the database
// Image slots are admin-manageable (Admin → Media) with static fallbacks.
const IMG = {
  hero:   s.vls_hero_url   || '/lamp-studio/hero.jpg',
  poster: s.vls_poster_url || '/lamp-studio/poster.jpg',
};
// Buy = the store's own product page → existing checkout, emails & delivery all
// run through the normal DigitalChiselCo order flow. Admin-overridable.
const BUY = s.vls_buy_url || '/product/vase-lampshade-studio';
// Price comes from the product row, so the page and the checkout can never
// disagree and nobody has to hunt thirteen hardcoded strings again.
// Owner, 2026-09-21: raised 14.99 -> 39 and the permanent "was 19.99" strike
// removed. The catalogue median is $6.39, so at $14.99 this read as an
// expensive FILE rather than cheap SOFTWARE; $39 puts it in the category
// buyers actually compare it against, and leaves room to advertise it.
let PRICE = 39;
try {
  const { data: prod } = await supabaseAdmin()
    .from('products').select('price_usd').eq('slug', 'vase-lampshade-studio').maybeSingle();
  if (prod?.price_usd) PRICE = Number(prod.price_usd);
} catch {}
const P = '$' + (PRICE % 1 === 0 ? PRICE.toFixed(0) : PRICE.toFixed(2));
const DEMO_URL = '/lamp-studio-app/index.html?demo=1&buy=' + encodeURIComponent('https://www.digitalchiselco.com' + (BUY.startsWith('/') ? BUY : '/lamp-studio'));
---
<Shell
  title="Vase Lampshade Studio — 3D Printable Lampshade Generator with Built-in E27/E14 Fitters | Vase Mode STL Software"
  description="Design watertight 3D-printable lampshade STL files in minutes — 105 parametric lamp shade designs, lithophane photo embossing, custom text, and a built-in E27/E14 bulb holder that prints in ONE piece in vase mode. Free browser playground, one-time purchase, no supports."
  image={IMG.hero}
  ogType="product"
  price={PRICE}
  currency="USD"
  availability="in stock"
  hideBanner={true}
  fullWidth={true}
>
  <!-- This page sells a piece of software, so it drops the storefront
       furniture: no elk banner, no category sidebar. Owner, 2026-09-21:
       "keep full page webapp so that everybody sees the controls". The live
       Studio now sits directly under the headline, edge to edge, above the
       fold on a laptop, instead of six feature cards down the page. -->
  <div class="max-w-5xl mx-auto px-4 sm:px-6 pt-5">
    <Breadcrumbs crumbs={[{ label: 'Lampshade Studio' }]} />
  </div>

  <article class="max-w-5xl mx-auto px-4 sm:px-6 pb-2">

    <!-- ===== HERO ===== -->
    <header class="text-center mb-7 reveal">
      <p class="text-xs tracking-widest text-bronze-600 mb-3">★ NEW FROM DIGITALCHISELCO · DESKTOP + WEB SOFTWARE</p>
      <h1 class="font-serif text-4xl md:text-6xl text-bronze-800 leading-tight">
        Vase Lampshade <em class="italic text-bronze-600">Studio</em>
      </h1>
      <p class="mt-5 text-lg md:text-xl text-ink-700/85 max-w-3xl mx-auto">
        Design a designer lampshade in minutes — with the bulb holder <em>built in</em> —
        and print the whole lamp in one continuous vase-mode piece. No CAD. No supports. No mesh repairs, ever.
      </p>
      <div class="mt-6 flex flex-wrap justify-center gap-3">
        <a href={BUY} class="bg-bronze-600 text-cream px-8 py-3.5 rounded-md text-sm font-medium hover:bg-bronze-700 hover:shadow-lg hover:-translate-y-0.5 transition-all shadow">Get the full Studio · <strong>{P}</strong> →</a>
        <a href="#playground" class="border border-bronze-600 text-bronze-700 px-8 py-3.5 rounded-md text-sm hover:bg-bronze-600/10 transition">Try it free, right here ↓</a>
      </div>
      <p class="mt-3 text-xs text-ink-700/60">Windows 10/11 desktop app + browser playground · <strong class="text-bronze-700">{P} one-time</strong> · 100% offline · nothing uploaded, ever</p>
    </header>
  </article>

  <!-- ===== LIVE PLAYGROUND, edge to edge, before anything else ===== -->
  <!-- Measured before this change: 100 people reached the page in 60 days and
       59 of them tried the tool, but it sat below six feature cards, so the
       controls were never the first thing anyone saw. -->
  <section id="playground" class="mb-14">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 text-center reveal mb-5">
      <p class="text-xs tracking-widest text-bronze-600 mb-2">THIS IS THE REAL SOFTWARE, RUNNING RIGHT HERE</p>
      <h2 class="font-serif text-2xl md:text-3xl text-bronze-800">Design a lamp before you buy anything</h2>
      <p class="mt-2 text-sm text-ink-700/80 max-w-2xl mx-auto">
        Every shape, modifier, photo and text tool is live below. Nothing to install, nothing uploaded.
        The full version adds STL / OBJ / 3MF export, the bulb fitter and your per-lamp PDF print guide.
      </p>
    </div>
    <div class="border-y-2 border-bronze-600/30 shadow-xl bg-[#0b0f17]">
      <iframe
        src={DEMO_URL}
        title="Vase Lampshade Studio — free playground"
        class="w-full block"
        style="height: min(86vh, 1100px); min-height: 560px; border: 0;"
        allow="fullscreen"
      ></iframe>
    </div>
    <p class="mt-3 text-xs text-ink-700/60 text-center px-4">Runs entirely in your browser, nothing is uploaded. Works best on a desktop or laptop.</p>
  </section>

  <article class="max-w-5xl mx-auto px-4 sm:px-6">

    <!-- Price hook, right where the "I want this" moment happens -->
    <div class="mb-16 max-w-2xl mx-auto border-2 border-bronze-600/40 rounded-xl p-8 text-center bg-gradient-to-br from-cream to-white shadow-lg reveal">
      <p class="text-xs tracking-widest text-bronze-600 mb-2">LOVE WHAT YOU JUST MADE?</p>
      <h3 class="font-serif text-2xl md:text-3xl text-bronze-800">Take it off the screen and onto your printer.</h3>
      <p class="mt-3 text-ink-700/85 max-w-lg mx-auto">The full Studio unlocks watertight STL / OBJ / 3MF export, the built-in fitter and your per-lamp PDF print guide.</p>
      <p class="mt-6">
        <strong class="font-serif text-5xl md:text-6xl text-bronze-800 align-middle">{P}</strong>
        <span class="text-sm text-ink-700/70 align-middle ml-2">once.<br class="hidden md:block"/> Yours forever.</span>
      </p>
      <p class="mt-2 text-sm text-ink-700/75">
        One payment, no subscription, commercial licence included. A single custom lampshade sells for more than this,
        and modelling one to order costs an hour of CAD you will never get back.
      </p>
      <a href={BUY} class="mt-6 inline-block bg-bronze-600 text-cream px-10 py-4 rounded-md text-base font-semibold hover:bg-bronze-700 hover:shadow-xl hover:-translate-y-0.5 transition-all shadow">Unlock the full Studio for {P} →</a>
      <p class="mt-3 text-xs text-ink-700/60">Instant download · free v1.x updates · commercial licence included · no subscription, ever</p>
    </div>

    <figure class="rounded-xl overflow-hidden border border-bronze-600/25 shadow-lg mb-16 reveal max-w-3xl mx-auto">
      <img src={IMG.hero} alt="3D printable lampshade designed in Vase Lampshade Studio — glowing vase-mode table lamp with built-in E27 fitter, printed in one piece with no supports" width="1254" height="1254" loading="eager" fetchpriority="high" decoding="async" class="w-full" />
      <figcaption class="text-center text-xs text-ink-700/60 py-2 bg-cream">Every lamp here was designed in the Studio and 3D-printed in one continuous vase-mode piece.</figcaption>
    </figure>

    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'SoftwareApplication',
      name: 'Vase Lampshade Studio',
      operatingSystem: 'Windows 10, Windows 11, Web',
      applicationCategory: 'DesignApplication',
      description: 'Parametric 3D-printable lampshade generator: 105 lamp shade designs with built-in E27/E14 fitters, lithophane photo embossing, custom text, one-piece vase-mode printing and watertight STL, OBJ and 3MF export.',
      image: 'https://www.digitalchiselco.com' + IMG.hero,
