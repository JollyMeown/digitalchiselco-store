      offers: { '@type': 'Offer', price: String(PRICE), priceCurrency: 'USD', availability: 'https://schema.org/InStock', url: 'https://www.digitalchiselco.com' + (BUY.startsWith('/') ? BUY : '/lamp-studio') },
      publisher: { '@type': 'Organization', name: 'DigitalChiselCo', url: 'https://www.digitalchiselco.com' },
