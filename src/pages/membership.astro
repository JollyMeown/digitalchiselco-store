---
import Shell from '../layouts/Shell.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { getMembershipPlans } from '../lib/queries';
import { MEMBER_FAQ } from '../lib/membership-faq';
import { planFacts, planFeatureLines, isDiamond, DIAMOND_CREDITS_PER_MONTH } from '../lib/membership-facts';
import MembershipPlanDetails from '../components/MembershipPlanDetails.astro';
const faqGroups = [...new Set(MEMBER_FAQ.map((x) => x.group))];
// ?preview=1 shows plans whose launch date has not arrived (owner testing).
const preview = Astro.url.searchParams.get('preview') === '1';
const plans = await getMembershipPlans({ preview });
const featured = plans.find((p) => p.highlight) || plans[0];
// Every number on this page comes from the featured plan row (Admin > Membership),
// so a price change there changes the page. Nothing below is typed by hand.
const F = featured ? planFacts(featured) : planFacts({ months: 3, files_per_month: 8, price_usd: 0 });
// The parts below the picker follow the SELECTED plan: one version per plan,
// only the selected one visible (the script swaps them on click).
const sel = featured?.slug || '';
const lines = (p: any) => {
  const f = planFacts(p);
  if (isDiamond(p)) return { form: `Tell us where to send your first ${DIAMOND_CREDITS_PER_MONTH} credits.`, note: `One ${f.priceLabel} order covers the full ${f.monthsLabel}. No recurring charge. No surprise payment later.`,
    cta: `${f.months * DIAMOND_CREDITS_PER_MONTH} designs you choose. Only ${f.priceLabel}.`, ctaSub: 'Add to cart now: your first credits are waiting.' };
  const starter = p.slug.startsWith('starter') || f.months === 1;
  return { form: `Tell us where to send your ${starter ? '' : 'first '}${f.files}-file pack.`, note: `One ${f.priceLabel} order covers ${starter ? 'the whole bundle' : `the full ${f.monthsLabel}`}. No recurring charge. No surprise payment later.`,
    cta: `${f.totalFiles} files. ${f.retailLabel} value. Only ${f.priceLabel}.`, ctaSub: 'Add to cart now: your first CNC carving pack is waiting.' };
};
---
<Shell title="Become a Member · DigitalChiselCo" description={`CNC STL membership — ${F.files} fresh bas-relief STL designs every month, ${F.totalFiles} carving files for ${F.priceLabel}. Instant first pack, commercial use, no recurring charge.`} scrollPastBanner={true}>
  <Breadcrumbs crumbs={[{ label: 'Membership' }]} />

  <!-- HERO -->
  <section class="mb-10">
    <p class="text-xs tracking-widest text-bronze-600 mb-3">★ DIGITALCHISELCO MEMBERSHIP</p>
    <h1 class="font-serif text-3xl md:text-5xl text-bronze-800 leading-tight max-w-3xl">
      🔥 Stop wasting your weekends searching for CNC files.
    </h1>
    <p class="mt-4 text-lg text-ink-700 max-w-2xl leading-relaxed">
      Your next {F.monthsLabel} of carving projects are already waiting. Get the {featured?.name || 'CNC STL Membership'} with <strong>{F.files} fresh bas-relief STL designs delivered every month</strong> — {F.totalFiles} total carving files for only <span class="text-bronze-700 font-semibold">{F.priceLabel}</span>.
    </p>
    <p class="mt-2 text-bronze-700">That's roughly <strong>{F.retailLabel} worth of CNC STL files for just {F.priceLabel}</strong> — about <strong>{F.pctOff}% off retail</strong>. ✅</p>
  </section>

  <!-- PLAN PICKER -->
  <section id="plans" class="mb-12">
    <h2 class="font-serif text-2xl mb-5">Pick your plan</h2>
    <div class="grid md:grid-cols-2 gap-5">
      {plans.map((p) => (
        <label class={`plan-card cursor-pointer block border-2 rounded-xl p-6 transition ${p.highlight ? 'border-bronze-600 bg-cream/40' : 'border-black/10 bg-white hover:border-bronze-600/60'}`} data-slug={p.slug} data-name={p.name} data-price={p.price_usd}>
          <div class="flex justify-between items-start mb-3">
            <div>
              <input type="radio" name="plan" value={p.slug} checked={p.highlight} class="mr-2 plan-radio" />
              <span class="font-medium text-lg text-ink-800">{p.name}</span>
              {p.highlight && <span class="ml-2 text-xs bg-bronze-600 text-cream px-2 py-0.5 rounded">★ MOST POPULAR</span>}
              {isDiamond(p) && <span class="ml-2 text-xs bg-[#2B4A7A] text-white px-2 py-0.5 rounded">&#9670; YOU CHOOSE</span>}
            </div>
            <div class="text-right">
              <div class="font-serif text-3xl text-bronze-700">${Number(p.price_usd).toFixed(2)}</div>
              {p.original_price_usd && <div class="text-xs text-ink-700/40 line-through">${Number(p.original_price_usd).toFixed(2)} value</div>}
            </div>
          </div>
          <ul class="text-sm text-ink-700 space-y-1.5 mt-3">
            {planFeatureLines(p).map((f) => <li class="flex gap-2"><span class="text-bronze-600">✓</span>{f}</li>)}
          </ul>
        </label>
      ))}
    </div>
  </section>

  <!-- SIGN-UP FORM -->
  <section class="mb-14 border border-black/10 rounded-xl p-6 md:p-8 bg-cream/30">
    <h2 class="font-serif text-2xl mb-1">Reserve your spot</h2>
    <p class="text-sm text-ink-700/70 mb-5">{plans.map((p) => <span data-plan-show={p.slug} hidden={p.slug !== sel}>{lines(p).form}</span>)}</p>
    <form id="member-form" class="grid sm:grid-cols-2 gap-3 max-w-xl">
      <div>
        <label class="text-xs block mb-1 font-medium" for="m-name">Name</label>
        <input id="m-name" required type="text" placeholder="Your name" class="w-full px-4 py-3 rounded-md border border-bronze-600/30 focus:outline-none focus:border-bronze-600 bg-white" />
      </div>
      <div>
        <label class="text-xs block mb-1 font-medium" for="m-email">Email</label>
        <input id="m-email" required type="email" placeholder="you@email.com" class="w-full px-4 py-3 rounded-md border border-bronze-600/30 focus:outline-none focus:border-bronze-600 bg-white" />
      </div>
      <label class="sm:col-span-2 flex items-start gap-2.5 bg-[#FAEEDA] border border-bronze-600/30 rounded-md px-3 py-2.5 cursor-pointer">
        <input id="m-gift" type="checkbox" class="accent-[#854F0B] mt-1" />
        <span class="text-sm text-ink-800">
          🎁 <strong>Give it as a gift.</strong>
          <span class="text-ink-700/75">Enter your friend's email at checkout and add a note. They get the membership and a welcome email that says it is from you. You pay, they carve.</span>
        </span>
      </label>
      <div class="sm:col-span-2 flex flex-wrap gap-3 mt-2">
        <button type="submit" data-action="add" class="bg-bronze-600 text-cream px-6 py-3 rounded-md text-sm hover:bg-bronze-700 transition shadow-sm">Add to cart →</button>
        <button type="submit" data-action="checkout" class="border border-bronze-600 text-bronze-700 px-6 py-3 rounded-md text-sm hover:bg-bronze-600/10 transition">Add &amp; checkout now →</button>
      </div>
      <p id="m-msg" class="sm:col-span-2 text-sm hidden"></p>
    </form>
    <p class="text-xs text-ink-700/50 mt-3">{plans.map((p) => <span data-plan-show={p.slug} hidden={p.slug !== sel}>{lines(p).note}</span>)}</p>
  </section>

  <!-- WHY / HOW / WHAT / FOR WHOM: one version per plan, the selected one shown -->
  {plans.map((p) => (
    <div data-plan-show={p.slug} hidden={p.slug !== sel}>
      <MembershipPlanDetails plan={p} />
    </div>
  ))}

  <!-- LICENSE -->
  <section class="mb-14 border-l-4 border-bronze-600 bg-cream/40 p-5 rounded-r-lg">
    <h3 class="font-medium text-bronze-700 mb-2">✅ Commercial use included</h3>
    <p class="text-sm text-ink-700">You may sell the physical carved pieces you create from these files.</p>
    <p class="text-sm text-ink-700 mt-2"><strong>🚫 Not allowed:</strong> reselling, sharing, uploading, copying, or redistributing the digital STL files themselves.</p>
    <p class="text-sm text-ink-700 mt-2"><strong>⚠️ Digital download only.</strong> No physical item will be shipped. This listing is for digital CNC STL files only.</p>
  </section>

  <!-- MEMBERSHIP QUESTIONS: the same answers as the FAQ hub, written from the rules the system runs on -->
  <section id="membership-faq" class="mb-14">
    <h2 class="font-serif text-2xl mb-1">Questions members ask</h2>
    <p class="text-sm text-ink-700/60 mb-5">Reminders, renewing early, upgrading, coming back, lost emails: how each one actually works.</p>
    {faqGroups.map((g) => (
      <div class="mb-6">
        <h3 class="text-[11px] uppercase tracking-[0.16em] text-bronze-700 font-semibold mb-2">{g}</h3>
        <div class="space-y-2">
          {MEMBER_FAQ.filter((x) => x.group === g).map((x) => (
            <details class="group bg-cream/40 border border-bronze-600/15 rounded-xl px-4 py-3 open:bg-cream/70 transition-colors">
              <summary class="cursor-pointer list-none flex items-start justify-between gap-3 font-semibold text-ink-900 text-[15px]">
                <span>{x.q}</span>
                <span class="text-bronze-600 shrink-0 mt-0.5 transition-transform group-open:rotate-45 text-xl leading-none">+</span>
              </summary>
              <p class="mt-2.5 text-sm text-ink-700/85 leading-relaxed">{x.a}</p>
            </details>
          ))}
        </div>
      </div>
    ))}
    <p class="text-xs text-ink-700/55">All membership questions, with the buying and maker questions, are also on the <a href="/faq#membership" class="text-bronze-700 underline">FAQ page</a>.</p>
  </section>

  <!-- FINAL CTA -->
  <section class="mb-12 text-center border border-bronze-600/30 rounded-xl p-8 bg-gradient-to-br from-cream to-white">
    {plans.map((p) => (
      <div data-plan-show={p.slug} hidden={p.slug !== sel}>
        <p class="font-serif text-2xl md:text-3xl text-bronze-800">👉 {lines(p).cta}</p>
        <p class="mt-3 text-ink-700">{lines(p).ctaSub}</p>
      </div>
    ))}
    <a href="#plans" class="mt-5 inline-block bg-bronze-600 text-cream px-8 py-3 rounded-md text-sm hover:bg-bronze-700 transition shadow">Choose my plan ↑</a>
    <p class="text-xs text-ink-700/60 mt-5">💬 Questions first? <a href="mailto:jolly@digitalchiselco.com" class="text-bronze-600">Send a message anytime</a>. A real person reads and replies.</p>
  </section>

  <script is:inline>
    const form = document.getElementById('member-form');
    const msg  = document.getElementById('m-msg');
    let action = 'add';
    form.querySelectorAll('button[type=submit]').forEach((b) => b.addEventListener('click', () => { action = b.dataset.action; }));

    // visual select-on-click for plan cards
    document.querySelectorAll('.plan-card').forEach((card) => {
      card.addEventListener('click', () => {
        document.querySelectorAll('.plan-radio').forEach((r) => r.checked = false);
        const radio = card.querySelector('.plan-radio');
        if (radio) radio.checked = true;
        document.querySelectorAll('.plan-card').forEach((c) => c.classList.remove('border-bronze-600', 'bg-cream/40'));
        card.classList.add('border-bronze-600', 'bg-cream/40');
        showPlan(card.dataset.slug);
      });
    });
    // Everything below the picker describes the selected plan.
    function showPlan(slug) {
      document.querySelectorAll('[data-plan-show]').forEach((el) => { el.hidden = el.dataset.planShow !== slug; });
    }
    document.querySelectorAll('.plan-radio').forEach((r) => r.addEventListener('change', () => { if (r.checked) showPlan(r.value); }));
    // a plan named in the link (?plan=diamond-select) opens selected
    try {
      const want = new URLSearchParams(location.search).get('plan');
      const card = want && document.querySelector('.plan-card[data-slug="' + CSS.escape(want) + '"]');
      if (card) card.click();
    } catch (_) {}

    // ?gift=1 (a Christmas campaign link) arrives with the gift box ticked.
    try { if (new URLSearchParams(location.search).get('gift') === '1') document.getElementById('m-gift').checked = true; } catch (_) {}
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const name  = document.getElementById('m-name').value.trim();
      const email = document.getElementById('m-email').value.trim();
      const picked = document.querySelector('.plan-radio:checked');
      const card = picked?.closest('.plan-card');
      const planSlug  = card?.dataset.slug;
      const planName  = card?.dataset.name;
      const planPrice = Number(card?.dataset.price || 0);
      if (!planSlug) { msg.className = 'sm:col-span-2 text-sm text-red-600'; msg.textContent = 'Please choose a plan above.'; return; }
      msg.className = 'sm:col-span-2 text-sm text-ink-700'; msg.textContent = 'Saving…';
      try {
        const res = await fetch('/api/membership-lead', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ name, email, plan_slug: planSlug }) });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || 'Network error');
        const cart = JSON.parse(localStorage.getItem('cart') || '[]');
        const cartId = 'membership:' + planSlug;
        if (!cart.find((x) => x.id === cartId)) {
          cart.push({ id: cartId, slug: 'membership', title: planName, price: planPrice, img: '' });
          localStorage.setItem('cart', JSON.stringify(cart));
          if (window.dccAction) window.dccAction('add_to_cart');
        }
        // Gift: the cart opens with "this order is a gift" already ticked.
        try {
          if (document.getElementById('m-gift')?.checked) localStorage.setItem('dcc_gift_intent', '1');
          else localStorage.removeItem('dcc_gift_intent');
        } catch (_) {}
        window.dispatchEvent(new Event('cart-changed'));
        msg.className = 'sm:col-span-2 text-sm text-green-700';
        msg.textContent = '✓ Saved! Redirecting to cart…';
        setTimeout(() => { window.location.href = '/cart'; }, 700);
      } catch (err) {
        msg.className = 'sm:col-span-2 text-sm text-red-600';
        msg.textContent = err.message || 'Something went wrong. Try again.';
      }
    });
  </script>
</Shell>
