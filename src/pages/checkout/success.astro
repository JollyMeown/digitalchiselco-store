---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { supabaseAdmin } from '../../lib/supabase';

const txnId = Astro.url.searchParams.get('txn') || '';

// Try to look up the order (may not exist yet if the webhook hasn't fired —
// the page falls back to a "We're processing your order" state in that case).
let order: any = null;
if (txnId) {
  const db = supabaseAdmin();
  const { data } = await db
    .from('orders')
    .select('id, email, total, currency, created_at, order_items(title, qty, price_usd, product_id)')
    .eq('paddle_transaction_id', txnId)
    .maybeSingle();
  order = data;
}

// Post-purchase upsell: same-collection designs they don't own yet + membership.
// Trust is at its highest right now — one gentle, relevant offer.
let moreLikeThese: any[] = [];
let plan: any = null;
if (order) {
  try {
    const db = supabaseAdmin();
    const boughtIds = (order.order_items || []).map((i: any) => i.product_id).filter(Boolean);
    if (boughtIds.length) {
      const { data: pcs } = await db.from('product_categories').select('category_id').in('product_id', boughtIds).limit(6);
      const catIds = [...new Set((pcs || []).map((r: any) => r.category_id))];
      if (catIds.length) {
        const { data: pool } = await db.from('product_categories')
          .select('product_id, products!inner(id, slug, title, price_usd, image_url, active)')
          .in('category_id', catIds).limit(40);
        const seen = new Set(boughtIds);
        for (const r of (pool || []) as any[]) {
          const pr = r.products;
          if (!pr?.active || seen.has(pr.id)) continue;
          seen.add(pr.id);
          moreLikeThese.push(pr);
          if (moreLikeThese.length >= 3) break;
        }
      }
    }
    const { data: mp } = await db.from('membership_plans').select('slug, name, months, files_per_month, price_usd').eq('active', true).order('sort_order').limit(1).maybeSingle();
    plan = mp;
  } catch { /* upsell is optional */ }
}

// One-click add-on: the single most-relevant design, offered with an express
// checkout (email pre-filled, ADDON15 = 15% off) so it's genuinely one more tap.
const addon = moreLikeThese[0] || null;
const addonRest = moreLikeThese.slice(1);
const paddleEnv = ((process.env.PADDLE_ENV ?? import.meta.env.PADDLE_ENV) === 'production' ? 'production' : 'sandbox');
const paddleToken = import.meta.env.PUBLIC_PADDLE_CLIENT_TOKEN || '';
const addonPrice = addon ? +(Number(addon.price_usd) * 0.85).toFixed(2) : 0;
---
<Base title="Order confirmed · DigitalChiselCo" noindex>
  <Header />
  <main class="max-w-3xl mx-auto px-4 sm:px-6 py-12 min-h-[50vh]">
    {order ? (
      <>
        <div class="text-center mb-8">
          <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-green-100 text-green-700 text-3xl mb-4">✓</div>
          <h1 class="font-serif text-3xl text-bronze-800">Thank you for your order!</h1>
          <p class="text-ink-700/70 mt-2">Order #{String(order.id).slice(0, 8)} · {new Date(order.created_at).toLocaleDateString()}</p>
        </div>
        <div class="bg-white border border-black/10 rounded-xl p-6">
          <h2 class="font-medium text-ink-800 mb-3">Your downloads</h2>
          <ul class="divide-y divide-black/10">
            {(order.order_items || []).map((it: any) => (
              <li class="py-3 flex justify-between items-center text-sm">
                <span class="text-ink-800">{it.title}</span>
                <span class="text-ink-700/60">{it.qty}×  ${Number(it.price_usd).toFixed(2)}</span>
              </li>
            ))}
          </ul>
          <div class="border-t border-black/10 mt-3 pt-3 flex justify-between text-base font-medium">
            <span>Total paid</span>
            <span>${Number(order.total).toFixed(2)} {order.currency}</span>
          </div>
        </div>
        <div class="mt-6 bg-cream/40 border border-bronze-600/20 rounded-lg p-5 text-sm text-ink-700">
          <p>📧 A copy of your receipt and download links has been sent to <strong>{order.email}</strong>.</p>
          <p class="mt-2">Need help? Reach us at <a href="mailto:jolly@digitalchiselco.com" class="text-bronze-600">jolly@digitalchiselco.com</a> — a real person reads every message.</p>
        </div>
        <div class="mt-6 text-center">
          <a href="/account" class="inline-block bg-bronze-600 text-cream px-6 py-3 rounded-md text-sm hover:bg-bronze-700 transition">Go to my account</a>
          <a href="/catalog" class="ml-3 inline-block text-bronze-700 px-6 py-3 rounded-md text-sm hover:bg-bronze-600/10 transition">Continue shopping</a>
        </div>

        {addon && (
          <section class="mt-10">
            <h2 class="font-serif text-2xl text-bronze-800 mb-1">Add one more — one click, no re-typing 🎁</h2>
            <p class="text-sm text-ink-700/70 mb-4">A carver favourite from the same collection, <span class="font-medium text-bronze-700">15% off</span> for the next few minutes. It goes to the same email &amp; account.</p>
            <div class="bg-white border-2 border-bronze-600/40 rounded-xl p-4 flex items-center gap-4">
              {addon.image_url && <img src={addon.image_url} alt={addon.title} class="w-24 h-24 rounded-lg object-cover flex-shrink-0" loading="lazy" />}
              <div class="flex-1 min-w-0">
                <div class="text-sm text-ink-800 font-medium line-clamp-2">{addon.title.split('|')[0].trim()}</div>
                <div class="mt-1"><span class="text-bronze-700 font-medium">${addonPrice.toFixed(2)}</span> <span class="text-ink-700/40 line-through text-xs ml-1">${Number(addon.price_usd).toFixed(2)}</span></div>
              </div>
              <button id="addon-btn" data-id={addon.id} data-price={Number(addon.price_usd)}
                class="flex-shrink-0 bg-bronze-600 text-cream px-5 py-3 rounded-md text-sm hover:bg-bronze-700 transition disabled:opacity-50">
                + Add for ${addonPrice.toFixed(2)}
              </button>
            </div>
            <p id="addon-msg" class="text-xs mt-2"></p>
          </section>
        )}

        {(addonRest.length > 0) && (
          <section class="mt-8">
            <h3 class="font-serif text-xl text-bronze-800 mb-1">More from your collections</h3>
            <p class="text-sm text-ink-700/70 mb-4">Your next order gets <span class="font-medium text-bronze-700">10% off</span> with code <code class="font-mono text-xs bg-cream border border-bronze-600/20 rounded px-1.5 py-0.5">THANKYOU10</code>.</p>
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
              {addonRest.map((r: any) => (
                <a href={`/product/${r.slug}`} class="bg-white border border-black/10 rounded-xl overflow-hidden hover:border-bronze-600/40 transition">
                  {r.image_url && <img src={r.image_url} alt={r.title} class="w-full aspect-square object-cover" loading="lazy" />}
                  <div class="p-3">
                    <div class="text-sm text-ink-800 line-clamp-2">{r.title.split('|')[0].trim()}</div>
                    <div class="text-bronze-700 font-medium text-sm mt-1">${Number(r.price_usd).toFixed(2)}</div>
                  </div>
                </a>
              ))}
            </div>
          </section>
        )}

        {plan && (
          <div class="mt-8 bg-[#5E380A] text-[#F5EFE3] rounded-xl p-6 text-center">
            <div class="font-serif text-xl">Love carving? Get {plan.files_per_month} fresh designs every month.</div>
            <p class="text-sm opacity-80 mt-1">The {plan.name} works out under ${(Number(plan.price_usd) / (plan.months * plan.files_per_month)).toFixed(2)} per design.</p>
            <a href="/#membership" class="inline-block mt-4 bg-[#FAC775] text-[#5E380A] font-medium px-6 py-2.5 rounded-md text-sm">Explore the membership →</a>
          </div>
        )}
      </>
    ) : (
      <>
        <div class="text-center">
          <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-cream text-bronze-700 text-3xl mb-4">⌛</div>
          <h1 class="font-serif text-3xl text-bronze-800">We're processing your order…</h1>
          <p class="text-ink-700/70 mt-3 max-w-lg mx-auto">
            Payment confirmed. We're preparing your downloads now — this usually takes a few seconds.
            <span id="auto-refresh-note">This page will refresh automatically.</span>
          </p>
          <button id="refresh-btn" onclick="location.reload()" class="mt-6 bg-bronze-600 text-cream px-6 py-3 rounded-md text-sm hover:bg-bronze-700 transition">Refresh now</button>
          <p class="mt-4 text-xs text-ink-700/50">Still nothing? Your receipt with download links has also been emailed to you.</p>
        </div>
        <script is:inline>
          (function () {
            var url = new URL(location.href);
            var retry = parseInt(url.searchParams.get('retry') || '0', 10);
            // Cap at ~50s so a stuck webhook doesn't pin the tab forever.
            if (retry < 20) {
              url.searchParams.set('retry', String(retry + 1));
              setTimeout(function () { location.replace(url.toString()); }, 2500);
            } else {
              var note = document.getElementById('auto-refresh-note');
              if (note) note.textContent = 'Click refresh when ready — or just check your email.';
            }
          })();
        </script>
      </>
    )}
  </main>
  <Footer />

  {addon && paddleToken && order && (
    <>
      <script src="https://cdn.paddle.com/paddle/v2/paddle.js"></script>
      <script is:inline define:vars={{ PADDLE_TOKEN: paddleToken, PADDLE_ENV: paddleEnv, EMAIL: order.email }}>
        (function () {
          var btn = document.getElementById('addon-btn');
          var msg = document.getElementById('addon-msg');
          if (!btn) return;
          function initPaddle() {
            if (typeof Paddle === 'undefined' || !PADDLE_TOKEN) return false;
            try {
              if (PADDLE_ENV === 'sandbox') Paddle.Environment.set('sandbox');
              Paddle.Initialize({
                token: PADDLE_TOKEN,
                eventCallback: function (e) {
                  if (e.name === 'checkout.completed') {
                    msg.textContent = '✓ Added! Your new download is on its way to your email.';
                    msg.className = 'text-xs mt-2 text-green-700';
                    btn.textContent = 'Added ✓'; btn.disabled = true;
                  }
                },
              });
              return true;
            } catch (_) { return false; }
          }
          var tries = 0;
          var t = setInterval(function () { if (typeof Paddle !== 'undefined') { clearInterval(t); initPaddle(); } else if (++tries > 50) clearInterval(t); }, 100);
          btn.addEventListener('click', async function () {
            btn.disabled = true; msg.textContent = 'Starting…'; msg.className = 'text-xs mt-2 text-ink-700/60';
            try {
              var res = await fetch('/api/checkout-init', {
                method: 'POST', headers: { 'content-type': 'application/json' },
                body: JSON.stringify({ items: [{ id: btn.dataset.id, price: Number(btn.dataset.price), qty: 1 }], email: EMAIL, coupon_code: 'ADDON15' }),
              });
              var data = await res.json();
              if (!res.ok || !data.transaction_id) throw new Error(data.error || 'Could not start.');
              Paddle.Checkout.open({ transactionId: data.transaction_id, customer: { email: EMAIL } });
              btn.disabled = false;
            } catch (err) {
              msg.textContent = '✕ ' + (err.message || 'Something went wrong.'); msg.className = 'text-xs mt-2 text-red-600';
              btn.disabled = false;
            }
          });
        })();
      </script>
    </>
  )}
</Base>
