---
import Shell from '../../layouts/Shell.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ProductCard from '../../components/ProductCard.astro';
import RecentlyViewed from '../../components/RecentlyViewed.astro';
import TrustBadges from '../../components/TrustBadges.astro';
import { getProductBySlug, getRelatedProducts, getSettings, getSoldCount } from '../../lib/queries';
import { pricing, money } from '../../lib/pricing';
import { jsonLd } from '../../lib/jsonld';
import { img } from '../../lib/img';

const { slug } = Astro.params;
const p = await getProductBySlug(slug!);
if (!p) return Astro.rewrite('/404');

const settings = await getSettings();
const { price, original, percent } = pricing(p.price_usd, settings.discount_percent);
// Cut Local "Make it real" — gated by growth_settings.marketplace_enabled so it
// stays hidden from customers until launch.
let marketplaceOn = false;
try {
  const { supabaseAdmin } = await import('../../lib/supabase');
  const { data: gs } = await supabaseAdmin().from('growth_settings').select('marketplace_enabled').eq('id', 1).maybeSingle();
  marketplaceOn = !!gs?.marketplace_enabled;
} catch {}
const cats = (p.product_categories ?? []).map((pc: any) => pc.categories).filter(Boolean);
const cat = cats[0];
const cleanTitle = p.title.split('|')[0].trim();
const gallery: string[] = (Array.isArray(p.gallery) && p.gallery.length ? p.gallery : [p.image_url]).filter(Boolean);
const related = await getRelatedProducts(p.id, 5);
const soldCount = await getSoldCount(p.id);

// Social proof: two CURATED reviews (generic=true — English, 5★, never naming a
// specific design so they read true under any product), rotated per product via
// slug hash. Count badge still reflects ALL active 5★ reviews.
let reviews: { name: string; text: string; rating: number }[] = [];
let reviewCount = 0;
// Active shop-wide sale → ticking countdown near the price (the product page
// hides the site banner, so it carries its own clock like the big stores do).
let sale: { name: string; percent_off: number; expires_at: string } | null = null;
try {
  const { supabaseAdmin } = await import('../../lib/supabase');
  const nowIso = new Date().toISOString();
  const [{ data: revs }, { count }, { data: saleRows }] = await Promise.all([
    supabaseAdmin().from('reviews').select('name, text, rating')
      .eq('active', true).eq('generic', true).order('sort_order').limit(60),
    supabaseAdmin().from('reviews').select('id', { count: 'exact', head: true })
      .eq('active', true).eq('status', 'approved').eq('rating', 5),
    supabaseAdmin().from('sales').select('name, percent_off, expires_at')
      .eq('active', true).eq('scope', 'all').lte('starts_at', nowIso).gte('expires_at', nowIso)
      .order('percent_off', { ascending: false }).limit(1),
  ]);
  reviewCount = count || 0;
  sale = (saleRows?.[0] as any) ?? null;
  if (revs?.length) {
    // two independent hashes → wider pair spread across products
    let h1 = 0, h2 = 5381;
    for (const ch of p.slug) { h1 = (h1 * 31 + ch.charCodeAt(0)) >>> 0; h2 = ((h2 * 33) ^ ch.charCodeAt(0)) >>> 0; }
    const i = h1 % revs.length;
    let j = h2 % revs.length;
    if (j === i) j = (j + 1) % revs.length;
    reviews = revs.length > 1 ? [revs[i], revs[j]] : [revs[i]];
  }
} catch { /* reviews + sale are optional */ }

// Real customer reviews for THIS design (approved on-site submissions, photos first).
let productReviews: { name: string; title: string | null; text: string; rating: number; photo_url: string | null; created_at: string }[] = [];
try {
  const { supabaseAdmin } = await import('../../lib/supabase');
  const { data: pr } = await supabaseAdmin().from('reviews')
    .select('name, title, text, rating, photo_url, created_at')
    .eq('product_id', p.id).eq('status', 'approved').eq('active', true)
    .order('photo_url', { ascending: false, nullsFirst: false }).order('created_at', { ascending: false }).limit(12);
  productReviews = (pr || []) as any;
} catch { /* optional */ }
const prAvg = productReviews.length ? (productReviews.reduce((s, r) => s + Number(r.rating || 5), 0) / productReviews.length) : 0;
// "Verified Buyer" is the imported-name placeholder — don't print it twice.
const reviewerLabel = (name: string) =>
  /^\s*verified\s*buyer\s*$/i.test(name || '') ? 'Verified buyer' : `${name}, verified buyer`;

const desc = p.description || `${cleanTitle} is a high-detail 3D relief STL designed for clean carving on CNC routers, laser engravers and 3D printers. After checkout you'll receive an instant download link by email and in your account.`;

const pageTitle = p.seo_title || `${cleanTitle.slice(0, 60)} · DigitalChiselCo`;
const pageDesc = (p.seo_description || desc).slice(0, 160);
// Keyword-rich image alt (Google Images / Lens is a major channel for makers).
const mainAlt = p.image_alt || `${cleanTitle} bas-relief STL file for CNC router, laser engraver & 3D printing`;
const site = (import.meta.env.PUBLIC_SITE_URL || 'https://digitalchiselco.com').replace(/\/$/, '');

const jsonld: any = {
  '@context': 'https://schema.org', '@type': 'Product',
  name: cleanTitle, description: (p.seo_description || desc).slice(0, 300),
  image: gallery.length ? gallery : undefined,
  sku: p.etsy_listing_id, brand: { '@type': 'Brand', name: 'DigitalChiselCo' },
  offers: { '@type': 'Offer', price, priceCurrency: 'USD', availability: 'https://schema.org/InStock', url: Astro.url.href },
};
// Star-rating rich snippet — ONLY from genuine on-site reviews for THIS product
// (Google-safe: reviews are visible on the page and product-specific). Stars
// appear in search results as reviews accumulate.
if (productReviews.length) {
  jsonld.aggregateRating = { '@type': 'AggregateRating', ratingValue: prAvg.toFixed(1), reviewCount: productReviews.length, bestRating: 5, worstRating: 1 };
  jsonld.review = productReviews.slice(0, 5).map((r) => ({
    '@type': 'Review',
    reviewRating: { '@type': 'Rating', ratingValue: Math.max(1, Math.min(5, Number(r.rating) || 5)), bestRating: 5, worstRating: 1 },
    author: { '@type': 'Person', name: /^\s*verified\s*buyer\s*$/i.test(r.name) ? 'Verified buyer' : r.name },
    reviewBody: r.text,
    ...(r.created_at ? { datePublished: new Date(r.created_at).toISOString().slice(0, 10) } : {}),
  }));
}
// Breadcrumb trail in search results (Home › Collection › Product).
const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: site + '/' },
    { '@type': 'ListItem', position: 2, name: cat ? cat.name : 'Catalog', item: site + (cat ? `/collections/${cat.slug}` : '/catalog') },
    { '@type': 'ListItem', position: 3, name: cleanTitle, item: Astro.url.href },
  ],
};
---
<Shell title={pageTitle} description={pageDesc} image={gallery[0]} hideBanner={true} ogType="product" price={price} currency="USD" availability="in stock">
  <Breadcrumbs crumbs={[cat ? { label: cat.name, href: `/collections/${cat.slug}` } : { label: 'Catalog', href: '/catalog' }, { label: cleanTitle }]} />

  <div class="grid md:grid-cols-2 gap-8 lg:gap-12">
    <!-- gallery -->
    <div>
      <div class="aspect-square bg-cream rounded-lg overflow-hidden">
        {gallery[0]
          ? <img id="main-img" src={img(gallery[0], { w: 1000, q: 82, square: true })} alt={mainAlt} width="800" height="800" fetchpriority="high" loading="eager" class="w-full h-full object-cover cursor-zoom-in" />
          : <div class="w-full h-full flex items-center justify-center text-bronze-600/40 p-6 text-center font-serif">{cleanTitle}</div>}
      </div>
      {gallery.length > 1 && (
        <div class="mt-3 grid grid-cols-3 sm:grid-cols-4 md:grid-cols-5 gap-2">
          {gallery.slice(0, 20).map((g, i) => (
            <button class="thumb aspect-square bg-cream rounded overflow-hidden border-2 border-transparent" data-src={img(g, { w: 1000, q: 82, square: true })} aria-label={`View image ${i + 1}`}>
              <img src={img(g, { w: 200, q: 75, square: true })} alt={`${cleanTitle} bas-relief STL — view ${i + 1}`} loading="lazy" width="200" height="200" class="w-full h-full object-cover" />
            </button>
          ))}
        </div>
      )}
      {p.video_url && (
        <div class="mt-3">
          <div class="text-xs font-medium text-ink-700/60 mb-1">🎬 Watch it in motion</div>
          <video src={p.video_url} poster={p.video_thumb} controls muted loop autoplay playsinline preload="none"
            class="w-full rounded-lg bg-black aspect-square object-cover"></video>
        </div>
      )}
    </div>

    <!-- details -->
    <div>
      {cat && <a href={`/collections/${cat.slug}`} class="text-xs text-ink-700/60">{cat.name}</a>}
      <h1 class="text-2xl md:text-3xl leading-snug mt-1">{cleanTitle}</h1>

      <div class="mt-3 flex items-center gap-3 flex-wrap">
        <span class="text-2xl text-bronze-600 font-medium" data-usd={price}>{money(price)}</span>
        <span class="text-ink-700/40 line-through">{money(original)}</span>
        <span class="text-xs bg-green-100 text-green-800 px-2 py-0.5 rounded">{percent}% off</span>
      </div>

      {sale && (
        <div class="mt-3 flex items-center gap-2.5 bg-[#5E380A] text-[#F5EFE3] rounded-md px-3 py-2.5 text-sm">
          <span aria-hidden="true">🔥</span>
          <span><strong>{sale.name}</strong> — extra {sale.percent_off}% off at checkout</span>
          <span class="ml-auto font-mono font-medium whitespace-nowrap" id="dcc-p-sale-cd" data-ends={sale.expires_at}>…</span>
        </div>
      )}
      {sale && (
        <script is:inline>
          (function () {
            var el = document.getElementById('dcc-p-sale-cd');
            if (!el) return;
            var end = new Date(el.dataset.ends).getTime();
            function tick() {
              var ms = end - Date.now();
              if (ms <= 0) { el.textContent = 'ended'; return; }
              var d = Math.floor(ms / 86400000), h = Math.floor(ms / 3600000) % 24,
                  m = Math.floor(ms / 60000) % 60, s = Math.floor(ms / 1000) % 60;
              el.textContent = (d > 0 ? d + 'd ' : '') + h + 'h ' + m + 'm ' + s + 's';
              setTimeout(tick, 1000);
            }
            tick();
          })();
        </script>
      )}

      <button class="add-to-cart mt-5 w-full bg-bronze-600 text-cream py-3 rounded-md hover:bg-bronze-700 transition"
        data-id={p.id} data-slug={p.slug} data-title={cleanTitle} data-price={price} data-img={gallery[0] || ''}>
        Add to cart
      </button>
      <button class="buy-now mt-2 w-full bg-ink-800 text-cream py-3 rounded-md hover:bg-black transition font-medium flex items-center justify-center gap-2"
        data-id={p.id} data-slug={p.slug} data-title={cleanTitle} data-price={price} data-img={gallery[0] || ''}>
        <span aria-hidden="true">⚡</span> Buy it now
      </button>
      <div class="mt-2 flex items-center justify-center gap-1.5 flex-wrap text-[11px] text-ink-700/60">
        <span>Express checkout with</span>
        <span class="px-1.5 py-0.5 rounded bg-black text-white font-medium leading-none"> Pay</span>
        <span class="px-1.5 py-0.5 rounded border border-black/15 bg-white font-medium leading-none">G Pay</span>
        <span class="px-1.5 py-0.5 rounded bg-[#003087] text-white font-medium leading-none">PayPal</span>
      </div>
      <a href="/cart" class="mt-2 block text-center text-sm text-bronze-600">View cart →</a>
      <button type="button" class="wish-btn mt-2 w-full border border-black/15 text-ink-700 py-2 rounded-md text-sm hover:border-bronze-600 hover:text-bronze-700 transition flex items-center justify-center gap-1.5"
        data-wish-id={p.id} data-wish-slug={p.slug} data-wish-title={cleanTitle} data-wish-price={price} data-wish-img={gallery[0] || ''}>
        <span class="wish-icon">🤍</span> Save to favorites
      </button>
      {marketplaceOn && (
        <div class="mt-3 group relative">
          <a href={`/make/${p.slug}`}
            class="w-full flex items-center justify-center gap-2 text-center bg-[#2c6a67] text-white py-3 rounded-md text-sm font-bold shadow-sm hover:bg-[#235450] hover:shadow-md transition"
            title="No CNC or 3D printer? Post a free request and a vetted maker near you will build this and hand it to you — often local pickup.">
            <span>🛠️</span> No machine? Get it made by a maker near you <span aria-hidden="true">→</span>
          </a>
          <div role="tooltip" class="pointer-events-none absolute left-1/2 -translate-x-1/2 bottom-full mb-2 w-64 bg-ink-800 text-cream text-xs rounded-lg px-3 py-2 opacity-0 group-hover:opacity-100 transition shadow-lg z-20">
            Post a free request and vetted CNC, laser or 3D-print makers near you send quotes. You pick one, they build it, you get the real piece — often local pickup.
            <span class="absolute left-1/2 -translate-x-1/2 top-full border-4 border-transparent border-t-ink-800"></span>
          </div>
        </div>
      )}

      {/* Save to Pinterest — hands Pinterest our purpose-built 2:3 Pin art
          (/pin/<slug>.jpg) instead of letting it grab a landscape photo off
          the page. Plain share URL, no Pinterest script, nothing to track. */}
      <button type="button" id="pin-save"
        class="mt-2 w-full border border-black/15 text-ink-700 py-2 rounded-md text-sm hover:border-[#e60023] hover:text-[#e60023] transition flex items-center justify-center gap-1.5"
        data-pin-media={`${Astro.site?.origin || 'https://digitalchiselco.com'}/pin/${p.slug}.jpg`}
        data-pin-url={`${Astro.site?.origin || 'https://digitalchiselco.com'}/product/${p.slug}`}
        data-pin-desc={`${cleanTitle}. 3D relief STL for CNC, laser and 3D printing. Commercial use included.${marketplaceOn ? ' No machine? A local maker can build it for you.' : ''}`}>
        <svg viewBox="0 0 24 24" width="15" height="15" fill="#e60023" aria-hidden="true"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.08 3.16 9.42 7.62 11.17-.1-.95-.2-2.4.04-3.44.22-.93 1.4-5.94 1.4-5.94s-.36-.72-.36-1.78c0-1.67.97-2.92 2.17-2.92 1.02 0 1.52.77 1.52 1.69 0 1.03-.66 2.57-1 4-.28 1.2.6 2.17 1.78 2.17 2.13 0 3.77-2.25 3.77-5.5 0-2.87-2.06-4.88-5.01-4.88-3.41 0-5.42 2.56-5.42 5.21 0 1.03.4 2.14.9 2.74.1.12.11.22.08.34l-.33 1.36c-.05.22-.17.27-.4.16-1.5-.7-2.44-2.89-2.44-4.65 0-3.79 2.75-7.27 7.94-7.27 4.17 0 7.41 2.97 7.41 6.94 0 4.14-2.61 7.47-6.23 7.47-1.22 0-2.36-.63-2.75-1.38l-.75 2.85c-.27 1.04-1 2.35-1.49 3.15 1.12.35 2.31.53 3.55.53 6.63 0 12-5.37 12-12S18.63 0 12 0z"/></svg>
        Save to Pinterest
      </button>

      {soldCount >= 5 && (
        <p class="mt-3 text-sm text-green-700 flex items-center gap-1.5">
          <span aria-hidden="true">🔥</span> <span><strong>{soldCount.toLocaleString()}</strong> makers already own this design</span>
        </p>
      )}

      {p.slug === 'vase-lampshade-studio' ? (
        <>
          <ul class="mt-6 text-sm text-ink-700 space-y-1.5">
            <li>💻 Instant digital download — Windows 10/11 installer + illustrated PDF manual</li>
            <li>🖨️ Prints on any FDM printer — works with Orca, Cura, PrusaSlicer &amp; Bambu Studio</li>
            <li>💡 105 lamp designs · built-in E27/E14 fitter · one-piece vase-mode printing</li>
            <li>♾ Unlimited re-downloads · free v1.x updates · no subscription</li>
            <li>✅ Commercial-use license — sell every lamp and STL you design</li>
          </ul>
          <a href="/lamp-studio#playground"
             class="mt-4 inline-flex items-center gap-2 border border-bronze-600 text-bronze-700 px-5 py-2.5 rounded-md text-sm font-medium hover:bg-bronze-600/10 transition">
            ▶ Try the live demo in your browser first
          </a>
        </>
      ) : (
        <ul class="mt-6 text-sm text-ink-700 space-y-1.5">
          <li>📦 Instant digital download (STL file)</li>
          <li>🛠️ Tested in Aspire, VCarve Pro, Carveco, ArtCAM, Fusion 360</li>
          <li>♾ Unlimited re-downloads</li>
          <li>✅ Personal &amp; commercial-use license</li>
        </ul>
      )}

      {reviews.length > 0 && (
        <div class="mt-6 border-t border-black/10 pt-4">
          <div class="flex items-center gap-2 mb-2">
            <span class="text-yellow-500 text-sm" aria-hidden="true">★★★★★</span>
            <span class="text-xs text-ink-700/70">{reviewCount} five-star reviews from carvers</span>
          </div>
          {reviews.map((r) => (
            <blockquote class="text-sm text-ink-700/90 bg-cream/40 border-l-2 border-bronze-600/40 pl-3 py-2 rounded-r mb-2">
              "{r.text.length > 180 ? r.text.slice(0, 178) + '…' : r.text}"
              <footer class="text-xs text-ink-700/50 mt-1">— {reviewerLabel(r.name)}</footer>
            </blockquote>
          ))}
        </div>
      )}

      <div class="mt-6 border-t border-black/10 pt-4">
        <h2 class="text-sm font-medium mb-2">About this design</h2>
        <div class="text-sm text-ink-700/90 leading-relaxed whitespace-pre-line">{desc}</div>
      </div>
    </div>
  </div>

  <section class="mt-10">
    <TrustBadges />
  </section>

  {related.length > 0 && (
    <section class="mt-14">
      <h2 class="text-xl mb-1">Complete the set</h2>
      <p class="text-sm text-ink-700/70 mb-4">
        From the same collection — <span class="font-medium text-bronze-700">buy any 2+ designs and save an extra 10%</span> (code <code class="font-mono text-xs bg-cream border border-bronze-600/20 rounded px-1.5 py-0.5">SET10</code>, shown in your cart).
      </p>
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-4">
        {related.map((r) => <ProductCard product={r} discount={settings.discount_percent} />)}
      </div>
    </section>
  )}

  <!-- ── Customer reviews & carve photos (on-site submissions) ─────────── -->
  <section class="mt-14 border-t border-black/10 pt-8" id="reviews" data-product-id={p.id}>
    <div class="flex items-baseline gap-3 mb-4">
      <h2 class="text-xl">Customer reviews & carves</h2>
      {productReviews.length > 0 && (
        <span class="text-sm text-ink-700/70"><span class="text-yellow-500">★</span> {prAvg.toFixed(1)} · {productReviews.length} review{productReviews.length === 1 ? '' : 's'}</span>
      )}
    </div>

    {productReviews.length > 0 ? (
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-8">
        {productReviews.map((r) => (
          <div class="border border-black/10 rounded-lg overflow-hidden bg-white flex flex-col">
            {r.photo_url && <img src={r.photo_url} alt={`Carve by ${r.name}`} loading="lazy" class="w-full aspect-[4/3] object-cover" />}
            <div class="p-3">
              <div class="text-yellow-500 text-sm" aria-hidden="true">{'★'.repeat(Math.max(1, Math.min(5, Number(r.rating) || 5)))}</div>
              {r.title && <div class="font-medium text-sm text-ink-800 mt-1">{r.title}</div>}
              <p class="text-sm text-ink-700/90 mt-1">{r.text}</p>
              <div class="text-xs text-ink-700/50 mt-2">— {r.name}, verified carver</div>
            </div>
          </div>
        ))}
      </div>
    ) : (
      <p class="text-sm text-ink-700/60 mb-6">No carves shared yet for this design — be the first! Bought it? Show us how it turned out. 🪵</p>
    )}

    <details class="bg-cream/40 border border-bronze-600/20 rounded-lg p-4">
      <summary class="cursor-pointer text-sm font-medium text-bronze-800 select-none">✍️ Write a review / share your carve photo</summary>
      <form id="review-form" class="mt-4 space-y-3">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <label class="block"><span class="text-xs text-ink-700/70 block mb-1">Your name</span>
            <input name="name" required maxlength="60" class="w-full px-3 py-2 text-sm border border-black/15 rounded-md focus:outline-none focus:border-bronze-600" /></label>
          <label class="block"><span class="text-xs text-ink-700/70 block mb-1">Email (for verification, never shown)</span>
            <input name="email" type="email" required class="w-full px-3 py-2 text-sm border border-black/15 rounded-md focus:outline-none focus:border-bronze-600" /></label>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <label class="block"><span class="text-xs text-ink-700/70 block mb-1">Rating</span>
            <select name="rating" class="w-full px-3 py-2 text-sm border border-black/15 rounded-md focus:outline-none focus:border-bronze-600">
              <option value="5">★★★★★ Love it</option><option value="4">★★★★ Great</option><option value="3">★★★ Good</option><option value="2">★★ Okay</option><option value="1">★ Poor</option>
            </select></label>
          <label class="block"><span class="text-xs text-ink-700/70 block mb-1">Headline (optional)</span>
            <input name="title" maxlength="80" class="w-full px-3 py-2 text-sm border border-black/15 rounded-md focus:outline-none focus:border-bronze-600" /></label>
        </div>
        <label class="block"><span class="text-xs text-ink-700/70 block mb-1">Your review</span>
          <textarea name="text" required rows={3} maxlength="800" class="w-full px-3 py-2 text-sm border border-black/15 rounded-md focus:outline-none focus:border-bronze-600"></textarea></label>
        <label class="block"><span class="text-xs text-ink-700/70 block mb-1">Photo of your carve (optional, JPG/PNG, max 5MB)</span>
          <input name="photo" type="file" accept="image/jpeg,image/png,image/webp" class="w-full text-sm text-ink-700" /></label>
        <div class="flex items-center gap-3">
          <button type="submit" class="bg-bronze-600 text-cream px-5 py-2.5 rounded-md text-sm hover:bg-bronze-700 transition">Submit review</button>
          <span id="review-msg" class="text-xs"></span>
        </div>
        <p class="text-[11px] text-ink-700/50">Reviews are checked before they appear, to keep this section genuine.</p>
      </form>
    </details>
  </section>

  <RecentlyViewed currentSlug={p.slug} title="Recently viewed" />

  <!-- Sticky buy bar (mobile): appears when the main Add-to-cart scrolls away -->
  <div id="sticky-buy" class="lg:hidden fixed left-0 right-0 bottom-14 z-30 bg-white/95 backdrop-blur border-t border-black/10 px-4 py-2 flex items-center gap-3 translate-y-[150%] transition-transform duration-200">
    <span class="text-bronze-600 font-medium whitespace-nowrap" data-usd={price}>{money(price)}</span>
    <button class="add-to-cart flex-1 bg-bronze-600 text-cream py-2.5 rounded-md text-sm font-medium"
      data-id={p.id} data-slug={p.slug} data-title={cleanTitle} data-price={price} data-img={gallery[0] || ''}>Add to cart</button>
  </div>

  <!-- Image lightbox -->
  <div id="lightbox" class="fixed inset-0 z-50 bg-black/90 hidden items-center justify-center p-4" role="dialog" aria-modal="true" aria-label="Enlarged image">
    <button id="lb-close" class="absolute top-3 right-4 text-white/90 text-4xl leading-none" aria-label="Close">×</button>
    <img id="lb-img" src="" alt={mainAlt} class="max-w-full max-h-full object-contain cursor-zoom-in transition-transform duration-150" />
  </div>

  <script is:inline>
    // ── Image lightbox (click main image to enlarge; click to toggle zoom) ──
    (function () {
      var main = document.getElementById('main-img');
      var lb = document.getElementById('lightbox'), lbImg = document.getElementById('lb-img');
      if (!main || !lb || !lbImg) return;
      function open() { lbImg.src = main.src; lbImg.classList.remove('scale-[1.8]'); lb.classList.remove('hidden'); lb.classList.add('flex'); document.documentElement.style.overflow = 'hidden'; }
      function close() { lb.classList.add('hidden'); lb.classList.remove('flex'); document.documentElement.style.overflow = ''; }
      main.addEventListener('click', open);
      document.getElementById('lb-close').addEventListener('click', close);
      lb.addEventListener('click', function (e) { if (e.target === lb) close(); });
      lbImg.addEventListener('click', function () { lbImg.classList.toggle('scale-[1.8]'); lbImg.classList.toggle('cursor-zoom-out'); });
      document.addEventListener('keydown', function (e) { if (e.key === 'Escape') close(); });
    })();

    // ── Sticky mobile buy bar ──────────────────────────────────────────
    (function () {
      var bar = document.getElementById('sticky-buy');
      var mainBtn = document.querySelector('.grid .add-to-cart[data-id]');
      if (!bar || !mainBtn || !('IntersectionObserver' in window)) return;
      var io = new IntersectionObserver(function (entries) {
        var visible = entries[0].isIntersecting;
        bar.classList.toggle('translate-y-[150%]', visible);
      }, { rootMargin: '0px 0px -40px 0px' });
      io.observe(mainBtn);
    })();
  </script>

  <script type="application/ld+json" set:html={jsonLd(jsonld)} />
  <script type="application/ld+json" set:html={jsonLd(breadcrumbLd)} />
  <script is:inline define:vars={{ slug: p.slug }}>
    // Record this product in the "recently viewed" list (most-recent-first, max 12).
    try {
      var rv = JSON.parse(localStorage.getItem('dcc_recent') || '[]');
      rv = [slug].concat(rv.filter(function (s) { return s !== slug; })).slice(0, 12);
      localStorage.setItem('dcc_recent', JSON.stringify(rv));
    } catch (_) {}
  </script>
  <script is:inline>
    // ── Save to Pinterest ───────────────────────────────────────────
    // Opens Pinterest's own share dialog pre-loaded with our vertical Pin
    // art, so a visitor's save looks like a designed Pin, not a screenshot.
    (function () {
      var b = document.getElementById('pin-save');
      if (!b) return;
      b.addEventListener('click', function () {
        var u = 'https://www.pinterest.com/pin/create/button/'
          + '?url=' + encodeURIComponent(b.dataset.pinUrl)
          + '&media=' + encodeURIComponent(b.dataset.pinMedia)
          + '&description=' + encodeURIComponent(b.dataset.pinDesc);
        window.open(u, 'pinterest', 'width=760,height=680,scrollbars=yes');
        try { if (window.dccAction) window.dccAction('pin_save', b.dataset.pinUrl); } catch (e) {}
      });
    })();

    // ── Review submission ───────────────────────────────────────────
    (function () {
      var form = document.getElementById('review-form');
      if (!form) return;
      var msg = document.getElementById('review-msg');
      var pid = document.getElementById('reviews').dataset.productId;
      function readFile(file) {
        return new Promise(function (resolve, reject) {
          if (!file) return resolve(null);
          if (file.size > 5 * 1024 * 1024) return reject(new Error('Photo is over 5MB — please choose a smaller one.'));
          var fr = new FileReader();
          fr.onload = function () { resolve(fr.result); };
          fr.onerror = function () { reject(new Error('Could not read the photo.')); };
          fr.readAsDataURL(file);
        });
      }
      form.addEventListener('submit', async function (e) {
        e.preventDefault();
        var btn = form.querySelector('button[type="submit"]');
        msg.textContent = 'Sending…'; msg.className = 'text-xs text-ink-700/60'; btn.disabled = true;
        try {
          var fd = new FormData(form);
          var photo = await readFile(fd.get('photo'));
          var res = await fetch('/api/reviews/submit', {
            method: 'POST', headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ product_id: pid, name: fd.get('name'), email: fd.get('email'), rating: Number(fd.get('rating')), title: fd.get('title'), text: fd.get('text'), photo: photo }),
          });
          var data = await res.json();
          if (!res.ok || data.error) throw new Error(data.error || 'Could not submit.');
          form.reset();
          msg.textContent = '✓ Thank you! Your review will appear after a quick check.'; msg.className = 'text-xs text-green-700';
        } catch (err) {
          msg.textContent = '✕ ' + (err.message || 'Something went wrong.'); msg.className = 'text-xs text-red-600';
        } finally { btn.disabled = false; }
      });
    })();

    document.querySelectorAll('.thumb').forEach((t) => {
      t.addEventListener('click', () => {
        const main = document.getElementById('main-img');
        if (main) main.src = t.dataset.src;
        document.querySelectorAll('.thumb').forEach((x) => x.classList.remove('border-bronze-600'));
        t.classList.add('border-bronze-600');
      });
    });
  </script>
</Shell>
