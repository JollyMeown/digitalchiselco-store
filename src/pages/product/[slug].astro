---
import Shell from '../../layouts/Shell.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ProductCard from '../../components/ProductCard.astro';
import { getProductBySlug, getRelatedProducts, getSettings } from '../../lib/queries';
import { pricing, money } from '../../lib/pricing';
import { jsonLd } from '../../lib/jsonld';

const { slug } = Astro.params;
const p = await getProductBySlug(slug!);
if (!p) return Astro.redirect('/catalog');

const settings = await getSettings();
const { price, original, percent } = pricing(p.price_usd, settings.discount_percent);
const cats = (p.product_categories ?? []).map((pc: any) => pc.categories).filter(Boolean);
const cat = cats[0];
const cleanTitle = p.title.split('|')[0].trim();
const gallery: string[] = (Array.isArray(p.gallery) && p.gallery.length ? p.gallery : [p.image_url]).filter(Boolean);
const related = await getRelatedProducts(p.id, 5);

// Social proof: two CURATED reviews (generic=true — English, 5★, never naming a
// specific design so they read true under any product), rotated per product via
// slug hash. Count badge still reflects ALL active 5★ reviews.
let reviews: { name: string; text: string; rating: number }[] = [];
let reviewCount = 0;
// Active shop-wide sale → ticking countdown near the price (the product page
// hides the site banner, so it carries its own clock like the big stores do).
let sale: { name: string; percent_off: number; expires_at: string } | null = null;
try {
  const { supabaseAdmin } = await import('../../lib/supabase');
  const nowIso = new Date().toISOString();
  const [{ data: revs }, { count }, { data: saleRows }] = await Promise.all([
    supabaseAdmin().from('reviews').select('name, text, rating')
      .eq('active', true).eq('generic', true).order('sort_order').limit(60),
    supabaseAdmin().from('reviews').select('id', { count: 'exact', head: true })
      .eq('active', true).eq('rating', 5),
    supabaseAdmin().from('sales').select('name, percent_off, expires_at')
      .eq('active', true).eq('scope', 'all').lte('starts_at', nowIso).gte('expires_at', nowIso)
      .order('percent_off', { ascending: false }).limit(1),
  ]);
  reviewCount = count || 0;
  sale = (saleRows?.[0] as any) ?? null;
  if (revs?.length) {
    // two independent hashes → wider pair spread across products
    let h1 = 0, h2 = 5381;
    for (const ch of p.slug) { h1 = (h1 * 31 + ch.charCodeAt(0)) >>> 0; h2 = ((h2 * 33) ^ ch.charCodeAt(0)) >>> 0; }
    const i = h1 % revs.length;
    let j = h2 % revs.length;
    if (j === i) j = (j + 1) % revs.length;
    reviews = revs.length > 1 ? [revs[i], revs[j]] : [revs[i]];
  }
} catch { /* reviews + sale are optional */ }
// "Verified Buyer" is the imported-name placeholder — don't print it twice.
const reviewerLabel = (name: string) =>
  /^\s*verified\s*buyer\s*$/i.test(name || '') ? 'Verified buyer' : `${name}, verified buyer`;

const desc = p.description || `${cleanTitle} is a high-detail 3D relief STL designed for clean carving on CNC routers, laser engravers and 3D printers. After checkout you'll receive an instant download link by email and in your account.`;

const pageTitle = p.seo_title || `${cleanTitle.slice(0, 60)} · DigitalChiselCo`;
const pageDesc = (p.seo_description || desc).slice(0, 160);
const mainAlt = p.image_alt || `${cleanTitle} bas-relief STL`;

const jsonld = {
  '@context': 'https://schema.org', '@type': 'Product',
  name: cleanTitle, description: (p.seo_description || desc).slice(0, 300),
  image: gallery.length ? gallery : undefined,
  sku: p.etsy_listing_id, brand: { '@type': 'Brand', name: 'DigitalChiselCo' },
  offers: { '@type': 'Offer', price, priceCurrency: 'USD', availability: 'https://schema.org/InStock', url: Astro.url.href },
};
---
<Shell title={pageTitle} description={pageDesc} image={gallery[0]} hideBanner={true} ogType="product" price={price} currency="USD" availability="in stock">
  <Breadcrumbs crumbs={[cat ? { label: cat.name, href: `/collections/${cat.slug}` } : { label: 'Catalog', href: '/catalog' }, { label: cleanTitle }]} />

  <div class="grid md:grid-cols-2 gap-8 lg:gap-12">
    <!-- gallery -->
    <div>
      <div class="aspect-square bg-cream rounded-lg overflow-hidden">
        {gallery[0]
          ? <img id="main-img" src={gallery[0]} alt={mainAlt} width="800" height="800" class="w-full h-full object-cover" />
          : <div class="w-full h-full flex items-center justify-center text-bronze-600/40 p-6 text-center font-serif">{cleanTitle}</div>}
      </div>
      {gallery.length > 1 && (
        <div class="mt-3 grid grid-cols-3 sm:grid-cols-4 md:grid-cols-5 gap-2">
          {gallery.slice(0, 10).map((g, i) => (
            <button class="thumb aspect-square bg-cream rounded overflow-hidden border-2 border-transparent" data-src={g} aria-label={`View image ${i + 1}`}>
              <img src={g} alt={`${cleanTitle} view ${i + 1}`} loading="lazy" class="w-full h-full object-cover" />
            </button>
          ))}
        </div>
      )}
    </div>

    <!-- details -->
    <div>
      {cat && <a href={`/collections/${cat.slug}`} class="text-xs text-ink-700/60">{cat.name}</a>}
      <h1 class="text-2xl md:text-3xl leading-snug mt-1">{cleanTitle}</h1>

      <div class="mt-3 flex items-center gap-3 flex-wrap">
        <span class="text-2xl text-bronze-600 font-medium">{money(price)}</span>
        <span class="text-ink-700/40 line-through">{money(original)}</span>
        <span class="text-xs bg-green-100 text-green-800 px-2 py-0.5 rounded">{percent}% off</span>
      </div>

      {sale && (
        <div class="mt-3 flex items-center gap-2.5 bg-[#5E380A] text-[#F5EFE3] rounded-md px-3 py-2.5 text-sm">
          <span aria-hidden="true">🔥</span>
          <span><strong>{sale.name}</strong> — extra {sale.percent_off}% off at checkout</span>
          <span class="ml-auto font-mono font-medium whitespace-nowrap" id="dcc-p-sale-cd" data-ends={sale.expires_at}>…</span>
        </div>
      )}
      {sale && (
        <script is:inline>
          (function () {
            var el = document.getElementById('dcc-p-sale-cd');
            if (!el) return;
            var end = new Date(el.dataset.ends).getTime();
            function tick() {
              var ms = end - Date.now();
              if (ms <= 0) { el.textContent = 'ended'; return; }
              var d = Math.floor(ms / 86400000), h = Math.floor(ms / 3600000) % 24,
                  m = Math.floor(ms / 60000) % 60, s = Math.floor(ms / 1000) % 60;
              el.textContent = (d > 0 ? d + 'd ' : '') + h + 'h ' + m + 'm ' + s + 's';
              setTimeout(tick, 1000);
            }
            tick();
          })();
        </script>
      )}

      <button class="add-to-cart mt-5 w-full bg-bronze-600 text-cream py-3 rounded-md hover:bg-bronze-700 transition"
        data-id={p.id} data-slug={p.slug} data-title={cleanTitle} data-price={price} data-img={gallery[0] || ''}>
        Add to cart
      </button>
      <a href="/cart" class="mt-2 block text-center text-sm text-bronze-600">View cart →</a>

      <ul class="mt-6 text-sm text-ink-700 space-y-1.5">
        <li>📦 Instant digital download (STL file)</li>
        <li>🛠️ Tested in Aspire, VCarve Pro, Carveco, ArtCAM, Fusion 360</li>
        <li>♾ Unlimited re-downloads</li>
        <li>✅ Personal &amp; commercial-use license</li>
      </ul>

      {reviews.length > 0 && (
        <div class="mt-6 border-t border-black/10 pt-4">
          <div class="flex items-center gap-2 mb-2">
            <span class="text-yellow-500 text-sm" aria-hidden="true">★★★★★</span>
            <span class="text-xs text-ink-700/70">{reviewCount} five-star reviews from carvers</span>
          </div>
          {reviews.map((r) => (
            <blockquote class="text-sm text-ink-700/90 bg-cream/40 border-l-2 border-bronze-600/40 pl-3 py-2 rounded-r mb-2">
              "{r.text.length > 180 ? r.text.slice(0, 178) + '…' : r.text}"
              <footer class="text-xs text-ink-700/50 mt-1">— {reviewerLabel(r.name)}</footer>
            </blockquote>
          ))}
        </div>
      )}

      <div class="mt-6 border-t border-black/10 pt-4">
        <h2 class="text-sm font-medium mb-2">About this design</h2>
        <div class="text-sm text-ink-700/90 leading-relaxed whitespace-pre-line">{desc}</div>
      </div>
    </div>
  </div>

  {related.length > 0 && (
    <section class="mt-14">
      <h2 class="text-xl mb-1">Complete the set</h2>
      <p class="text-sm text-ink-700/70 mb-4">
        From the same collection — <span class="font-medium text-bronze-700">buy any 2+ designs and save an extra 10%</span> (code <code class="font-mono text-xs bg-cream border border-bronze-600/20 rounded px-1.5 py-0.5">SET10</code>, shown in your cart).
      </p>
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-4">
        {related.map((r) => <ProductCard product={r} discount={settings.discount_percent} />)}
      </div>
    </section>
  )}

  <script type="application/ld+json" set:html={jsonLd(jsonld)} />
  <script is:inline>
    document.querySelectorAll('.thumb').forEach((t) => {
      t.addEventListener('click', () => {
        const main = document.getElementById('main-img');
        if (main) main.src = t.dataset.src;
        document.querySelectorAll('.thumb').forEach((x) => x.classList.remove('border-bronze-600'));
        t.classList.add('border-bronze-600');
      });
    });
  </script>
</Shell>
