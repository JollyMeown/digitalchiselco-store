---
import { img } from '../../lib/img';
import Shell from '../../layouts/Shell.astro';
import { getCategories } from '../../lib/queries';
import { supabaseAdmin } from '../../lib/supabase';
const categories = await getCategories();
// Live seasonal collections (active + inside their date window) — featured on top.
let seasonal: any[] = [];
try {
  const nowIso = new Date().toISOString();
  const { data } = await supabaseAdmin().from('seasonal_collections')
    .select('slug, title, subtitle, hero_image_url, starts_at, ends_at')
    .eq('active', true).order('sort_order');
  seasonal = (data || []).filter((s: any) => (!s.starts_at || s.starts_at <= nowIso) && (!s.ends_at || s.ends_at >= nowIso));
} catch { /* optional */ }
import { designCountLabel } from '../../lib/queries';
const DESIGNS = await designCountLabel();
const site = 'https://digitalchiselco.com';
// The collection hubs as one list (2026-10-01): each collection page already
// carries CollectionPage + ItemList + FAQ; this index had no structured data at all.
const listLd = {
  '@context': 'https://schema.org', '@type': 'CollectionPage', name: 'Bas-relief STL collections', url: `${site}/collections`,
  description: `${DESIGNS} bas-relief STL files for CNC routers and 3D printers, and laser engraving via a depth map, grouped into ${categories.length} themed collections.`,
  isPartOf: { '@type': 'WebSite', url: site, name: 'DigitalChiselCo' },
  mainEntity: { '@type': 'ItemList', numberOfItems: categories.length,
    itemListElement: categories.map((c: any, i: number) => ({ '@type': 'ListItem', position: i + 1, name: c.name, url: `${site}/collections/${c.slug}` })) },
};
---
<Shell title="Bas-Relief STL Collections: Wildlife, Religious, Western and More | DigitalChiselCo"
  description={`Browse ${DESIGNS} bas-relief STL files by theme: wildlife, religious and Christian, western, hunting lodge, Norse, Tree of Life, Christmas, Halloween and more. Ready for CNC and 3D printing, and laser engraving via a depth map.`}
  scrollPastBanner={true}>
  {seasonal.length > 0 && (
    <section class="mb-8">
      <h2 class="text-xl mb-3">✨ Seasonal right now</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        {seasonal.map((s) => (
          <a href={`/seasonal/${s.slug}`} class="block rounded-lg overflow-hidden border border-[#FAC775]/40 bg-gradient-to-br from-[#FAEEDA] to-[#FAC775]/30 hover:shadow-md transition p-5">
            <div class="font-serif text-xl text-bronze-800">{s.title}</div>
            {s.subtitle && <p class="text-sm text-ink-700/70 mt-1">{s.subtitle}</p>}
            <span class="inline-block mt-2 text-sm text-bronze-700 font-medium">Explore →</span>
          </a>
        ))}
      </div>
    </section>
  )}
  <h1 class="text-3xl mb-2">Shop by collection</h1>
  <p class="text-ink-700/75 text-sm mb-6 max-w-3xl">{DESIGNS} bas-relief STL files for CNC routers and 3D printers, and laser engraving via a depth map, in {categories.length} themed collections. Every file is an instant download with commercial use of what you carve, and opens in Aspire, VCarve Pro, Carveco, ArtCAM and Fusion 360.</p>
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
    {categories.map((c) => (
      <a href={`/collections/${c.slug}`} class="block border border-black/10 rounded-lg overflow-hidden hover:shadow-md transition group">
        <div class="aspect-[16/9] bg-cream overflow-hidden">
          {c.image_url
            ? <img src={img(c.image_url, { w: 600, q: 78 })} alt={c.name} loading="lazy" class="w-full h-full object-cover group-hover:scale-[1.03] transition" />
            : <div class="w-full h-full flex items-center justify-center text-bronze-600/50 font-serif text-lg px-4 text-center">{c.name}</div>}
        </div>
        {!c.image_url && <div class="p-3 text-sm">{c.name}</div>}
      </a>
    ))}
  </div>
  <script type="application/ld+json" set:html={JSON.stringify(listLd)} />
</Shell>
