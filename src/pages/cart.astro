<style is:global>
  .cart-page { max-width: 72rem; margin: 0 auto; padding: 1.5rem 1rem 2.5rem; min-height: 40vh; }
  @media (min-width: 640px) { .cart-page { padding-left: 1.5rem; padding-right: 1.5rem; } }
  .cart-head { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; flex-wrap: wrap; margin-bottom: 1.25rem; }
  .cart-count-label { font-family: inherit; font-size: .95rem; color: rgba(43,33,24,.55); font-weight: 400; }
  .cart-continue { font-size: .85rem; color: #854F0B; text-decoration: underline; text-underline-offset: 3px; }
  .cart-grid { display: grid; grid-template-columns: 1fr; gap: 1.5rem; align-items: start; }
  @media (min-width: 1024px) { .cart-grid { grid-template-columns: minmax(0, 1fr) 360px; gap: 2.5rem; } }
  .cart-empty { text-align: center; background: #fff; border: 1px solid rgba(0,0,0,.08); border-radius: .75rem; padding: 2.5rem 1rem; max-width: 34rem; margin: 1rem auto; }
  .cart-btn-primary { background: #854F0B; color: #FAEEDA; padding: .6rem 1.1rem; border-radius: .5rem; font-size: .9rem; }
