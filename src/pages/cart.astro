---
// Cart deliberately does NOT use the Shell (no left menu) — focused checkout view.
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { pricing } from '../lib/pricing';
import { getSettings } from '../lib/queries';
const settings = await getSettings();
const { percent } = pricing(1, settings.discount_percent);
const showCartPromos = (settings as any).cart_promos_active !== false;
// Order-bump REMOVED 2026-08-06 (owner: the catalogue is outdated — don't offer
// it at checkout). The catalogue product itself stays purchasable standalone.
const bump: { id: string; title: string; price: number } | null = null;
// Free-gift threshold: "spend $X, unlock a free surprise design". The gift is
// auto-picked + granted server-side by the webhook off the real paid total, so
// the bar is purely motivational (no browser trust, no fixed product).
let freeGift: { threshold: number } | null = null;
{
  const threshold = Number((settings as any).free_gift_threshold) || 0;
  if (threshold > 0) freeGift = { threshold };
}
// PADDLE_ENV is a non-PUBLIC var, so it is NOT exposed on import.meta.env (that
// resolves to undefined -> always 'sandbox'). Read process.env at SSR runtime
// first, matching the server helper in src/lib/paddle.ts.
const paddleEnv = ((process.env.PADDLE_ENV ?? import.meta.env.PADDLE_ENV) === 'production' ? 'production' : 'sandbox');
const paddleToken = import.meta.env.PUBLIC_PADDLE_CLIENT_TOKEN || '';
const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL || '';
const supabaseAnonKey = import.meta.env.PUBLIC_SUPABASE_ANON_KEY || '';
---
<Base title="Cart | DigitalChiselCo">
  <Header />
  <!-- Cart, redesigned 2026-09-25 (owner: "not cluttered, simple and
       professionally appealing"). On phones only 18% of carts reached
       checkout against 52% on desktop: the button sat below nine boxes.
       Now: designs on the left, one order-summary card on the right (sticky
       on desktop), and on phones a bottom bar with the total + Checkout.
       Every id the script below uses is unchanged. -->
  <main class="cart-page">
    <div class="cart-head">
      <h1 class="font-serif text-2xl sm:text-3xl text-bronze-800">Your cart <span id="cart-count" class="cart-count-label"></span></h1>
      <a href="/catalog" class="cart-continue">Continue shopping</a>
    </div>

    <div id="empty" class="hidden cart-empty">
      <p class="font-serif text-xl text-bronze-800">Your cart is empty</p>
      <p class="text-sm text-ink-700/70 mt-1">Find a design to carve, or start with five free files.</p>
      <div class="mt-4 flex flex-wrap gap-2 justify-center">
        <a href="/search" class="cart-btn-primary">Search designs</a>
        <a href="/free" class="cart-btn-ghost">Get 5 free STL files</a>
      </div>
    </div>

    <div class="cart-grid">
      <section aria-label="Designs in your cart" class="min-w-0">
        <div id="items" class="cart-items"></div>
        <p id="tier-hint" class="hidden cart-hint"><span id="tier-hint-text"></span> <a href="/catalog">Add designs</a></p>
      </section>

      <aside id="summary" class="hidden cart-summary" aria-label="Order summary">
        <h2 class="cart-sum-title">Order summary</h2>
        <dl class="cart-lines">
          <div><dt>Subtotal</dt><dd id="subtotal">$0.00</dd></div>
          <div class="is-save"><dt>Sale ({percent}% off)</dt><dd id="savings">$0.00</dd></div>
          <div id="promo-row" class="hidden is-save"><dt id="promo-label">Promo</dt><dd id="promo-amount">$0.00</dd></div>
          <div class="is-total"><dt>Total</dt><dd id="total">$0.00</dd></div>
        </dl>

        {freeGift && (
          <div id="free-gift-bar" class="cart-gift-bar" data-threshold={freeGift.threshold}>
            <p id="free-gift-text">Spend ${freeGift.threshold.toFixed(0)} and get a <strong>free surprise design</strong>.</p>
            <div class="cart-gift-track"><div id="free-gift-fill" style="width:0%"></div></div>
          </div>
        )}

        <details class="cart-promo">
          <summary>Have a promo code?</summary>
          <div class="mt-2 flex gap-2">
            <input id="promo-code" type="text" autocapitalize="characters" placeholder="Code" aria-label="Promo code"
              class="flex-1 min-w-0 px-3 py-2 text-sm border border-black/15 rounded-md font-mono uppercase tracking-wider focus:outline-none focus:border-bronze-600" />
            <button id="promo-apply" type="button" class="px-4 py-2 text-sm border border-bronze-600 text-bronze-700 rounded-md hover:bg-bronze-600 hover:text-cream transition">Apply</button>
            <button id="promo-remove" type="button" class="hidden px-3 py-2 text-sm border border-black/15 rounded-md hover:bg-cream">Remove</button>
          </div>
          <p id="promo-msg" class="mt-2 text-xs"></p>
        </details>

        <div class="cart-field">
          <label for="buyer-email">Email for your download links</label>
          <input id="buyer-email" type="email" inputmode="email" autocomplete="email" required placeholder="you@email.com" />
          <p id="buyer-email-msg" class="mt-1 text-xs text-red-600 hidden"></p>
          <p class="cart-help">Your files and receipt arrive here the moment payment goes through.</p>
        </div>

        <div class="cart-gift">
          <label class="flex items-center gap-2 cursor-pointer select-none">
            <input id="gift-check" type="checkbox" class="accent-[#854F0B]" />
            <span>Sending this as a gift?</span>
          </label>
          <div id="gift-fields" class="hidden mt-2 space-y-2">
            <div>
              <label for="gift-to" class="block text-[11px] text-ink-700/70 mb-0.5">Their email <span class="text-red-600">*</span></label>
              <input id="gift-to" type="email" inputmode="email" placeholder="friend@email.com" class="w-full px-3 py-2 text-sm border border-black/15 rounded-md focus:outline-none focus:border-bronze-600 bg-white" />
            </div>
            <div>
              <label for="gift-from" class="block text-[11px] text-ink-700/70 mb-0.5">Your name</label>
              <input id="gift-from" type="text" maxlength="80" placeholder="e.g. Sarah" class="w-full px-3 py-2 text-sm border border-black/15 rounded-md focus:outline-none focus:border-bronze-600 bg-white" />
            </div>
            <div>
              <label for="gift-note" class="block text-[11px] text-ink-700/70 mb-0.5">Note (optional)</label>
              <textarea id="gift-note" rows="2" maxlength="300" placeholder="Happy birthday! Carve something amazing." class="w-full px-3 py-2 text-sm border border-black/15 rounded-md focus:outline-none focus:border-bronze-600 bg-white"></textarea>
            </div>
            <p class="text-[11px] text-ink-700/60">They get the files and your note. You get the receipt.</p>
          </div>
        </div>

        {bump && (
          <label class="mt-3 flex items-start gap-2.5 text-sm cursor-pointer select-none">
            <input id="bump-check" type="checkbox" class="mt-0.5 accent-[#854F0B]" data-bump-id={bump.id} data-bump-price={bump.price} />
            <span>Add the {bump.title} <span class="whitespace-nowrap font-medium">+ ${bump.price.toFixed(2)}</span></span>
          </label>
        )}

        <button id="checkout" class="cart-checkout">Checkout</button>

        <div id="owned-panel" hidden class="mt-3 rounded-md border border-amber-400 bg-amber-50 p-3 text-sm text-amber-950">
          <p class="font-medium">You already own <span id="owned-count">this design</span>:</p>
          <ul id="owned-list" class="mt-1 list-disc pl-5 text-[13px]"></ul>
          <p class="mt-2 text-[12px] text-amber-900/80">Your files are waiting in your account, no need to pay again.</p>
          <div class="mt-2.5 flex flex-wrap gap-2">
            <button id="owned-remove" type="button" class="bg-bronze-600 text-cream text-xs font-medium px-3 py-2 rounded-md hover:bg-bronze-700">Remove and continue</button>
            <a id="owned-download" href="/resend-downloads" class="text-xs px-3 py-2 rounded-md border border-bronze-600 text-bronze-700 hover:bg-white">Send me my downloads</a>
            <button id="owned-anyway" type="button" class="text-xs underline text-ink-700/70 px-1">Buy again anyway</button>
          </div>
        </div>

        <div class="cart-secure">
          <p><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><rect x="4" y="11" width="16" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg> Secure checkout · instant download</p>
          {/* Spelled out in full: Google's StoreBot reads the checkout page to
              detect e-wallets for the Store quality scorecard. */}
          <p class="cart-pay">Card · PayPal · Apple Pay · Google Pay</p>
          <p class="cart-mor"><a href="/faq" class="hover:underline">Paddle</a> processes payment as our merchant of record.</p>
        </div>
      </aside>
    </div>
  </main>

  <!-- Phones: total + Checkout always within reach. Hidden while the real
       button is on screen, and during payment. -->
  <div id="cart-sticky" class="cart-sticky" hidden>
    <div class="min-w-0"><span class="block text-[11px] text-ink-700/60 leading-none">Total</span><strong id="cart-sticky-total" class="text-lg">$0.00</strong></div>
    <button type="button" id="cart-sticky-btn" class="cart-sticky-btn">Checkout</button>
  </div>

  <!-- Inline Paddle checkout, embedded on-site (dashboard Inline theme) -->
  <section id="dcc-checkout-section" class="hidden cart-pay-section">
    <button id="dcc-checkout-back" type="button" class="text-sm text-bronze-700 hover:underline mb-4">&larr; Back to cart</button>
    <!-- Exit-save: shown once when the buyer backs out of payment -->
    <div id="dcc-exit-save" class="hidden mb-4 bg-[#FAEEDA] border border-bronze-600/40 rounded-lg px-4 py-3">
      <p class="text-sm text-bronze-800 font-medium">Not ready right now? No problem.</p>
      <p class="text-xs text-ink-700/70 mt-0.5">We can email you your cart so you can finish in one click later. Nothing is lost either way.</p>
      <div class="mt-2 flex flex-wrap gap-2">
        <button id="dcc-exit-save-yes" type="button" class="text-xs px-3 py-2 rounded-md bg-bronze-600 text-cream hover:bg-bronze-700 transition">Email me my cart</button>
        <button id="dcc-exit-save-no" type="button" class="text-xs px-3 py-2 rounded-md border border-black/15 hover:bg-white transition">Just take me back</button>
      </div>
      <p id="dcc-exit-save-msg" class="text-xs mt-2 hidden"></p>
    </div>
    <h1 class="font-serif text-2xl sm:text-3xl text-bronze-800">Payment</h1>
    <p id="pay-summary" class="text-sm text-ink-700/70 mt-1 mb-4">Your files are emailed the moment payment goes through.</p>
    <div class="dcc-inline-frame rounded-xl border border-bronze-600/15 bg-white p-2 sm:p-4 min-h-[420px]"></div>
  </section>

  <!-- Relevant-to-cart upsell (filled by JS using /api/related) -->
  <section id="upsell-wrap" class="cart-upsell hidden">
    <h2 id="upsell-title" class="font-serif text-xl text-bronze-800 mb-3">Complete your collection</h2>
    <div id="upsell" class="grid grid-cols-2 sm:grid-cols-4 gap-4"></div>
  </section>

  <Footer />
  <!-- Paddle.js — overlay checkout -->
  <script src="https://cdn.paddle.com/paddle/v2/paddle.js"></script>
  <script is:inline define:vars={{ DISCOUNT: percent, SHOW_PROMOS: showCartPromos, PADDLE_TOKEN: paddleToken, PADDLE_ENV: paddleEnv, SUPABASE_URL: supabaseUrl, SUPABASE_ANON_KEY: supabaseAnonKey }}>
    const fmt = (n) => '$' + Number(n).toFixed(2);
    const itemsEl = document.getElementById('items');
    const escAttr = (s) => String(s ?? '').replace(/"/g, '&quot;').replace(/</g, '&lt;');
    // a 76px thumbnail, not the full product image (same transform as lib/img.ts)
    const thumb = (u) => String(u || '').includes('/storage/v1/object/public/')
      ? String(u).replace('/storage/v1/object/public/', '/storage/v1/render/image/public/') + '?width=160&height=160&resize=cover&quality=70'
      : u;

    // Customization fields keyed by product_id, fetched once per render
    let customFieldsByProduct = {};

    function renderCart() {
      const c = JSON.parse(localStorage.getItem('cart') || '[]');
      document.getElementById('empty').classList.toggle('hidden', c.length > 0);
      document.getElementById('summary').classList.toggle('hidden', c.length === 0);
      const lsCross = document.getElementById('ls-cross');
      if (lsCross) lsCross.hidden = !c.some((x) => !String(x.id).includes(':') && x.id !== lsCross.dataset.swId)
        || c.some((x) => x.id === lsCross.dataset.swId);
      itemsEl.innerHTML = c.map((x, idx) => {
        const fields = customFieldsByProduct[x.id] || [];
        const fieldsHtml = fields.length ? renderCustomFieldsBlock(x, fields, idx) : '';
        const id = String(x.id || '');
        const sub = id.startsWith('membership:') ? 'Membership' : id.startsWith('bundle5:') ? 'Pick-any-5 bundle'
          : String(x.slug || '').startsWith('software-') ? 'Windows software · download link by email' : 'STL file · instant download';
        const href = id.startsWith('membership:') ? '/membership' : '/product/' + escAttr(x.slug);
        return `
        <div class="cart-item-wrap">
          <div class="cart-item">
            <a href="${href}" class="cart-thumb" tabindex="-1" aria-hidden="true">${x.img ? `<img src="${escAttr(thumb(x.img))}" alt="" width="76" height="76">` : ''}</a>
            <div class="cart-info">
              <a href="${href}" class="cart-title">${escAttr(x.title)}</a>
              <span class="cart-sub">${sub}</span>
              <button type="button" data-id="${escAttr(x.id)}" class="rm cart-rm" aria-label="Remove ${escAttr(x.title)}">Remove</button>
            </div>
            <div class="cart-price" data-usd="${Number(x.price) || 0}">${fmt(x.price)}</div>
          </div>
          ${fieldsHtml}
        </div>`;
      }).join('');
      wireCustomFieldInputs();
      const subtotalRaw = c.reduce((s, x) => s + Number(x.price), 0);
      // The store-wide discount is baked in: shown price IS the discounted price.
      // So the "original" total = price / (1 - d/100); savings = original − total.
      const original = subtotalRaw / (1 - DISCOUNT / 100);
      const savings = original - subtotalRaw;
      document.getElementById('subtotal').textContent = fmt(original);
      document.getElementById('savings').textContent = '−' + fmt(savings);
      const promo = JSON.parse(localStorage.getItem('promo') || 'null');
      const promoOff = promo?.discount_amount ? Math.min(subtotalRaw, Number(promo.discount_amount)) : 0;
      const payable = Math.max(0, subtotalRaw - promoOff);
      document.getElementById('total').textContent = fmt(payable);
      const cnt = document.getElementById('cart-count');
      if (cnt) cnt.textContent = c.length ? '(' + c.length + (c.length === 1 ? ' design)' : ' designs)') : '';
      const st = document.getElementById('cart-sticky-total'); if (st) st.textContent = fmt(payable);
      if (window.__dccSticky) window.__dccSticky();

      // Free-gift progress bar (matches the webhook's paid-subtotal check).
      const fgBar = document.getElementById('free-gift-bar');
      if (fgBar) {
        const thr = Number(fgBar.dataset.threshold) || 0;
        const fill = document.getElementById('free-gift-fill');
        const txt = document.getElementById('free-gift-text');
        const pct = thr > 0 ? Math.min(100, Math.round((payable / thr) * 100)) : 0;
        if (fill) fill.style.width = pct + '%';
        if (txt && payable >= thr && thr > 0) {
          txt.innerHTML = '<strong>Free design unlocked.</strong> It arrives with your downloads.';
        } else if (txt && thr > 0) {
          txt.innerHTML = 'Add <strong>' + fmt(thr - payable) + '</strong> more to get a <strong>free surprise design</strong>.';
        }
      }
      const promoRow = document.getElementById('promo-row');
      const promoLabel = document.getElementById('promo-label');
      const promoAmount = document.getElementById('promo-amount');
      const promoRemove = document.getElementById('promo-remove');
      if (promo?.code && promoOff > 0) {
        promoRow.classList.remove('hidden');
        promoLabel.textContent = 'Promo (' + promo.code + ')';
        promoAmount.textContent = '−' + fmt(promoOff);
        promoRemove?.classList.remove('hidden');
      } else {
        promoRow.classList.add('hidden');
        promoRemove?.classList.add('hidden');
      }

      // Re-validate the applied promo against the live cart on every change.
      // Without this, removing items below a tier's minimum (e.g. 6 items for
      // 2026OFF15) would leave the discount applied stale. Debounced via a
      // simple in-flight flag so rapid cart edits collapse into one round-trip.
      revalidatePromoSoon(c, promo);

      // ── Bulk-discount upsell hint ─────────────────────────────────
      // Tiers must mirror seed_bulk_promos.mjs. Find the next tier the
      // cart hasn't reached and tell the customer how to unlock it.
      const tiers = [
        { items: 2,  percent: 10, code: 'SET10' },
        { items: 6,  percent: 15, code: '2026OFF15' },
        { items: 10, percent: 20, code: '2026OFF20' },
        { items: 25, percent: 35, code: '2026OFF35' },
      ];
      // bundle + membership lines never count toward the bulk-promo tiers
      const itemCount = c.filter((x) => !String(x.id).startsWith('bundle5:') && !String(x.id).startsWith('membership:')).length;
      const hintBox = document.getElementById('tier-hint');
      const hintText = document.getElementById('tier-hint-text');
      const next = tiers.find((t) => t.items > itemCount);
      if (!SHOW_PROMOS) {
        hintBox.classList.add('hidden');
      } else if (next && itemCount > 0) {
        const diff = next.items - itemCount;
        hintText.innerHTML = 'Add ' + diff + ' more design' + (diff === 1 ? '' : 's') + ' for <strong>' + next.percent + '% off</strong> with code <code class="font-mono">' + next.code + '</code>.';
        hintBox.classList.remove('hidden');
      } else if (itemCount > 0 && tiers.length) {
        const reached = tiers.filter((t) => t.items <= itemCount).pop();
        if (reached && (!promo || promo.code !== reached.code)) {
          hintText.innerHTML = 'You qualify for <strong>' + reached.percent + '% off</strong>. <button type="button" class="cart-apply-code" data-code="' + reached.code + '">Apply ' + reached.code + '</button>';
          hintBox.classList.remove('hidden');
        } else {
          hintBox.classList.add('hidden');
        }
      } else {
        hintBox.classList.add('hidden');
      }
      document.querySelectorAll('.rm').forEach((b) => b.addEventListener('click', () => {
        const next = JSON.parse(localStorage.getItem('cart') || '[]').filter((y) => y.id !== b.dataset.id);
        localStorage.setItem('cart', JSON.stringify(next)); window.dispatchEvent(new Event('cart-changed'));
        renderCart(); loadUpsell();
      }));
    }

    function cardHtml(p) {
      const original = (Number(p.price_usd) / (1 - DISCOUNT / 100)).toFixed(2);
      return `
        <div class="border border-black/10 rounded-md overflow-hidden hover:shadow transition flex flex-col">
          <a href="/product/${escAttr(p.slug)}" class="block aspect-square bg-cream overflow-hidden">
            ${p.image_url ? `<img src="${escAttr(p.image_url)}" alt="${escAttr(p.title)}" loading="lazy" class="w-full h-full object-cover">` : ''}
          </a>
          <div class="p-3 flex flex-col flex-1">
            <a href="/product/${escAttr(p.slug)}" class="text-sm leading-snug text-ink-800 line-clamp-2 min-h-[2.5em]">${escAttr(p.title.split('|')[0].trim())}</a>
            <div class="mt-1 flex items-center gap-2">
              <span class="text-bronze-600 text-sm font-medium">${fmt(p.price_usd)}</span>
              <span class="text-ink-700/40 text-xs line-through">$${original}</span>
            </div>
            <button class="add-to-cart mt-2 w-full text-xs border border-bronze-600 text-bronze-700 py-1.5 rounded hover:bg-bronze-600 hover:text-cream transition"
              data-id="${escAttr(p.id)}" data-slug="${escAttr(p.slug)}" data-title="${escAttr(p.title.split('|')[0].trim())}" data-price="${Number(p.price_usd)}" data-img="${escAttr(p.image_url || '')}">Add to cart</button>
          </div>
        </div>`;
    }

    async function loadUpsell() {
      const c = JSON.parse(localStorage.getItem('cart') || '[]');
      const ids = c.map((x) => x.id).filter((id) => !String(id).startsWith('membership:') && !String(id).startsWith('bundle5:'));
      try {
        const res = await fetch('/api/related', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ ids }) });
        const data = await res.json();
        const wrap = document.getElementById('upsell-wrap');
        const grid = document.getElementById('upsell');
        const title = document.getElementById('upsell-title');
        if (!data.products?.length) { wrap.classList.add('hidden'); return; }
        title.textContent = ids.length ? 'Complete your collection' : 'Popular designs';
        grid.innerHTML = data.products.slice(0, 4).map(cardHtml).join('');
        wrap.classList.remove('hidden');
        window.dccSyncCartButtons?.(); // reflect in-cart state on upsell cards
      } catch (e) { console.error('upsell load failed', e); }
    }

    // Tiny debouncing wrapper used by renderCart() to re-check the applied
    // promo against the live cart whenever items change.
    let revalTimer = null;
    let revalInFlight = false;
    let lastCartHash = '';
    async function revalidatePromoSoon(c, promo) {
      if (!promo?.code) { lastCartHash = JSON.stringify(c.map((x) => x.id).sort()); return; }
      const hash = JSON.stringify(c.map((x) => x.id).sort());
      if (hash === lastCartHash && !revalInFlight) return; // nothing to do
      lastCartHash = hash;
      clearTimeout(revalTimer);
      revalTimer = setTimeout(() => doRevalidate(promo.code), 200);
    }
    async function doRevalidate(code) {
      if (revalInFlight) return;
      revalInFlight = true;
      try {
        const cart = JSON.parse(localStorage.getItem('cart') || '[]')
          .filter((c) => !String(c.id).startsWith('membership:') && !String(c.id).startsWith('bundle5:'))
          .map((c) => ({ id: c.id, price: Number(c.price), qty: 1, title: c.title }));
        if (cart.length === 0) {
          localStorage.removeItem('promo');
          renderCart();
          return;
        }
        const res = await fetch('/api/coupons/validate', {
          method: 'POST', headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ code, items: cart }),
        });
        const data = await res.json();
        if (res.ok && data.ok) {
          // Update the stored discount so the next renderCart() uses the fresh number.
          localStorage.setItem('promo', JSON.stringify({
            code: data.code, description: data.description,
            discount_amount: data.discount_amount, percent_off: data.percent_off,
          }));
          const promoMsg = document.getElementById('promo-msg');
          if (promoMsg && promoMsg.textContent.startsWith('✕')) promoMsg.textContent = '';
          renderCart();
        } else {
          // Promo no longer eligible — drop it and tell the user gently.
          localStorage.removeItem('promo');
          const promoMsg = document.getElementById('promo-msg');
          if (promoMsg) {
            promoMsg.textContent = 'Promo "' + code + '" removed: ' + (data.error || 'it no longer applies to this cart.');
            promoMsg.className = 'mt-2 text-xs text-amber-700';
          }
          renderCart();
        }
      } catch (e) {
        // Network blip — leave the promo in place; we'll re-check on next change.
      } finally {
        revalInFlight = false;
      }
    }

    // ── Customization fields fetcher ─────────────────────────────────
    // Public-read RLS allows direct Supabase REST query for the field definitions.
    async function loadCustomFields() {
      const c = JSON.parse(localStorage.getItem('cart') || '[]');
      const ids = [...new Set(c.map((x) => x.id).filter((id) => id && !String(id).startsWith('membership:') && !String(id).startsWith('bundle5:')))];
      if (!ids.length) { customFieldsByProduct = {}; return; }
      try {
        const url = SUPABASE_URL + '/rest/v1/product_custom_fields?select=*&product_id=in.(' + ids.join(',') + ')&order=sort_order';
        const res = await fetch(url, { headers: { apikey: SUPABASE_ANON_KEY, Authorization: 'Bearer ' + SUPABASE_ANON_KEY } });
        if (!res.ok) { customFieldsByProduct = {}; return; }
        const data = await res.json();
        const grouped = {};
        for (const f of data) { (grouped[f.product_id] = grouped[f.product_id] || []).push(f); }
        customFieldsByProduct = grouped;
      } catch (e) { console.error('loadCustomFields failed', e); customFieldsByProduct = {}; }
    }

    function renderCustomFieldsBlock(cartItem, fields, idx) {
      const stored = cartItem.customizations || {};
      const inputs = fields.map((f) => {
        const v = stored[f.field_key] ?? '';
        const ml = f.max_length ? ' maxlength="' + f.max_length + '"' : '';
        const req = f.required ? ' required' : '';
        const ph = f.placeholder ? ' placeholder="' + escAttr(f.placeholder) + '"' : '';
        const help = f.help_text ? '<p class="text-[11px] text-ink-700/50 mt-0.5">' + escAttr(f.help_text) + '</p>' : '';
        const req_mark = f.required ? '<span class="text-red-600">*</span>' : '';
        const cls = 'cf-input w-full px-2.5 py-1.5 text-sm border border-black/15 rounded focus:outline-none focus:border-bronze-600';
        let input;
        if (f.field_type === 'textarea') {
          input = '<textarea data-cart-idx="' + idx + '" data-key="' + escAttr(f.field_key) + '" rows="2" class="' + cls + '"' + ph + req + ml + '>' + escAttr(v) + '</textarea>';
        } else {
          const type = f.field_type === 'file_url' ? 'url' : f.field_type === 'phone' ? 'tel' : f.field_type;
          input = '<input data-cart-idx="' + idx + '" data-key="' + escAttr(f.field_key) + '" type="' + type + '" class="' + cls + '" value="' + escAttr(v) + '"' + ph + req + ml + '/>';
        }
        return '<label class="block"><span class="text-[11px] text-ink-700/70 block mb-0.5">' + escAttr(f.label) + ' ' + req_mark + '</span>' + input + help + '</label>';
      }).join('');
      return '<div class="mt-3 ml-20 p-3 rounded-md bg-bronze-50/40 border border-bronze-600/20 space-y-2"><div class="text-[11px] tracking-wider uppercase text-bronze-700/80 font-medium mb-1">✎ Personalize this item</div>' + inputs + '</div>';
    }

    function wireCustomFieldInputs() {
      document.querySelectorAll('[data-cart-idx]').forEach((el) => {
        el.addEventListener('input', () => {
          const idx = Number(el.dataset.cartIdx);
          const key = el.dataset.key;
          const c = JSON.parse(localStorage.getItem('cart') || '[]');
          if (!c[idx]) return;
          c[idx].customizations = c[idx].customizations || {};
          c[idx].customizations[key] = el.value;
          localStorage.setItem('cart', JSON.stringify(c));
        });
      });
    }

    async function refreshAll() {
      await loadCustomFields();
      renderCart();
    }

    refreshAll();
    loadUpsell();
    window.addEventListener('cart-changed', () => { refreshAll(); loadUpsell(); });

    // ── Buyer email persistence ───────────────────────────────────────
    // Remember the last email between visits so the field is pre-filled.
    const emailInput = document.getElementById('buyer-email');
    const emailMsg = document.getElementById('buyer-email-msg');
    try {
      const saved = localStorage.getItem('buyer_email');
      if (saved && emailInput) emailInput.value = saved;
    } catch {}
    emailInput?.addEventListener('input', () => {
      emailMsg.classList.add('hidden');
      try { localStorage.setItem('buyer_email', emailInput.value.trim()); } catch {}
    });
    // Abandoned-cart capture: once a valid email is typed, snapshot the cart
    // server-side so we can send ONE gentle reminder if checkout never completes.
    let cartNoteT = null;
    emailInput?.addEventListener('input', () => {
      clearTimeout(cartNoteT);
      cartNoteT = setTimeout(() => {
        const em = (emailInput.value || '').trim().toLowerCase();
        if (!/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(em)) return;
        const c = JSON.parse(localStorage.getItem('cart') || '[]');
        if (!c.length) return;
        try {
          fetch('/api/cart-note', { method: 'POST', headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ email: em, items: c.map((x) => ({ id: x.id, title: x.title, price: x.price, qty: x.qty || 1 })) }), keepalive: true });
        } catch (_) {}
      }, 1200);
    });

    // ── Promo code ────────────────────────────────────────────────────
    const promoMsg = document.getElementById('promo-msg');
    const promoCodeInput = document.getElementById('promo-code');
    // Pre-fill if already applied
    {
      const existing = JSON.parse(localStorage.getItem('promo') || 'null');
      if (existing?.code) { promoCodeInput.value = existing.code; promoMsg.textContent = '✓ ' + (existing.description || existing.code) + ' applied.'; promoMsg.className = 'mt-2 text-xs text-green-700'; }
      else {
        // Auto-apply a referral code captured from a shared ?ref= link (one-shot).
        try {
          const ref = localStorage.getItem('dcc_ref');
          const cartNow = JSON.parse(localStorage.getItem('cart') || '[]');
          if (ref && cartNow.length) {
            localStorage.removeItem('dcc_ref');
            promoCodeInput.value = ref;
            setTimeout(() => document.getElementById('promo-apply')?.click(), 300);
          }
        } catch (_) {}
      }
    }
    document.getElementById('promo-apply')?.addEventListener('click', async () => {
      const code = (promoCodeInput.value || '').trim().toUpperCase();
      if (!code) { promoMsg.textContent = 'Enter a code.'; promoMsg.className = 'mt-2 text-xs text-red-600'; return; }
      const cart = JSON.parse(localStorage.getItem('cart') || '[]')
        .filter((c) => !String(c.id).startsWith('membership:') && !String(c.id).startsWith('bundle5:'))
        .map((c) => ({ id: c.id, price: Number(c.price), qty: 1, title: c.title }));
      promoMsg.textContent = 'Checking…'; promoMsg.className = 'mt-2 text-xs text-ink-700/60';
      try {
        const res = await fetch('/api/coupons/validate', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ code, items: cart }) });
        const data = await res.json();
        if (!res.ok || !data.ok) { promoMsg.textContent = '✕ ' + (data.error || 'Code not valid.'); promoMsg.className = 'mt-2 text-xs text-red-600'; return; }
        localStorage.setItem('promo', JSON.stringify({ code: data.code, description: data.description, discount_amount: data.discount_amount, percent_off: data.percent_off }));
        promoMsg.textContent = '✓ ' + (data.description || data.code) + ' applied. You save ' + fmt(data.discount_amount) + '.';
        promoMsg.className = 'mt-2 text-xs text-green-700';
        // Pretend the cart "changed" so the revalidator's hash is up to date
        lastCartHash = JSON.stringify(JSON.parse(localStorage.getItem('cart') || '[]').map((x) => x.id).sort());
        renderCart();
      } catch (e) {
        promoMsg.textContent = 'Network error. Please try again.'; promoMsg.className = 'mt-2 text-xs text-red-600';
      }
    });
    document.getElementById('promo-remove')?.addEventListener('click', () => {
      localStorage.removeItem('promo'); promoCodeInput.value = ''; promoMsg.textContent = ''; renderCart();
    });

    // ── Paddle.js setup ────────────────────────────────────────────────
    function setupPaddle() {
      if (typeof Paddle === 'undefined' || !PADDLE_TOKEN) return false;
      try {
        if (PADDLE_ENV === 'sandbox') Paddle.Environment.set('sandbox');
        Paddle.Initialize({
          token: PADDLE_TOKEN,
          eventCallback: (e) => {
            if (e.name === 'checkout.completed') {
              const txnId = e.data?.transaction_id || e.data?.id;
              // Pinterest conversion (no-op unless the tag is configured)
              try {
                if (window.pintrk) {
                  const c = JSON.parse(localStorage.getItem('cart') || '[]');
                  window.pintrk('track', 'checkout', {
                    value: Number(e.data?.totals?.total ?? e.data?.totals?.grand_total ?? 0) || undefined,
                    currency: e.data?.currency_code || 'USD',
                    order_quantity: c.length || 1,
                    order_id: txnId || undefined,
                    line_items: c.map((x) => ({ product_id: x.id, product_name: x.title, product_price: Number(x.price) || 0, product_quantity: 1 })),
                  });
                }
              } catch (_) {}
              // tell the saved-cart record this cart was BOUGHT, before it empties
              try { if (window.dccCartSnapshot) { localStorage.setItem('cart', '[]'); window.dccCartSnapshot({ converted: true, txn: txnId || '' }); } } catch (_) {}
              localStorage.setItem('cart', '[]');
              window.dispatchEvent(new Event('cart-changed'));
              window.location.href = '/checkout/success' + (txnId ? '?txn=' + encodeURIComponent(txnId) : '');
            } else if (e.name === 'checkout.error') {
              console.error('Paddle checkout error:', e);
            }
          },
        });
      } catch (err) {
        console.error('Paddle setup failed:', err);
        return false;
      }
      return true;
    }

    // Wait for Paddle.js to attach
    function whenPaddleReady(cb) {
      if (typeof Paddle !== 'undefined') return cb();
      let tries = 0;
      const t = setInterval(() => {
        if (typeof Paddle !== 'undefined') { clearInterval(t); cb(); }
        else if (++tries > 50) { clearInterval(t); console.error('Paddle.js failed to load.'); }
      }, 100);
    }

    whenPaddleReady(setupPaddle);

    document.getElementById('checkout')?.addEventListener('click', async (e) => {
      const btn = e.currentTarget;
      const cart = JSON.parse(localStorage.getItem('cart') || '[]');
      if (!cart.length) return;
      if (!PADDLE_TOKEN) { alert('Checkout is not yet configured. Please contact support.'); return; }

      // Require + validate email before opening Paddle, so the receipt and
      // download links land exactly where the buyer expects.
      const buyerEmail = (emailInput?.value || '').trim().toLowerCase();
      if (!/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(buyerEmail)) {
        emailMsg.textContent = 'Please enter a valid email. Your downloads are sent there.';
        emailMsg.classList.remove('hidden');
        emailInput?.focus();
        return;
      }
      try { localStorage.setItem('buyer_email', buyerEmail); } catch {}

      // Validate any required customization fields on customizable items.
      // Walks the rendered inputs (which the user has been editing) and uses
      // native form validity so empty required fields, bad emails, bad URLs etc.
      // all surface with the browser's own error UI.
      const cfInputs = Array.from(document.querySelectorAll('[data-cart-idx]'));
      for (const el of cfInputs) {
        if (!el.checkValidity()) {
          el.reportValidity();
          el.focus();
          return;
        }
      }
      // Stamp final customizations into cart from inputs (in case any input event hadn't fired)
      cfInputs.forEach((el) => {
        const idx = Number(el.dataset.cartIdx);
        const key = el.dataset.key;
        if (!cart[idx]) return;
        cart[idx].customizations = cart[idx].customizations || {};
        cart[idx].customizations[key] = el.value;
      });
      localStorage.setItem('cart', JSON.stringify(cart));

      // Build a customization payload keyed by cart-line index, preserving
      // label/type so the order display survives admin field edits later.
      const customizationsPayload = cart.map((it) => {
        const fields = customFieldsByProduct[it.id] || [];
        if (!fields.length) return null;
        const vals = it.customizations || {};
        return fields.map((f) => ({ key: f.field_key, label: f.label, type: f.field_type, value: vals[f.field_key] || '' }));
      });

      btn.disabled = true; btn.textContent = 'Starting checkout…';
      // funnel event: checkout started
      try { navigator.sendBeacon('/api/track', new Blob([JSON.stringify({ p: '/cart', t: 'checkout_start' })], { type: 'application/json' })); } catch (_) {}
      try {
        const promo = JSON.parse(localStorage.getItem('promo') || 'null');
        // Order-bump: append the catalogue as a one-time extra line (price is
        // server-verified by checkout-init from the DB, never trusted from here).
        const itemsForCheckout = cart.slice();
        const bumpEl = document.getElementById('bump-check');
        if (bumpEl?.checked && bumpEl.dataset.bumpId && !cart.some((x) => x.id === bumpEl.dataset.bumpId)) {
          itemsForCheckout.push({ id: bumpEl.dataset.bumpId, title: 'Complete Catalogue', price: Number(bumpEl.dataset.bumpPrice) || 0, qty: 1 });
          customizationsPayload.push(null);
        }
        // Gift order fields (validated lightly here, strictly server-side)
        let gift = null;
        if (document.getElementById('gift-check')?.checked) {
          const gTo = (document.getElementById('gift-to')?.value || '').trim().toLowerCase();
          if (!/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(gTo)) {
            alert("Please enter your friend's email for the gift, or untick the gift option.");
            document.getElementById('gift-to')?.focus();
            btn.disabled = false; btn.textContent = 'Checkout';
            return;
          }
          gift = { to: gTo, from: (document.getElementById('gift-from')?.value || '').trim(), note: (document.getElementById('gift-note')?.value || '').trim() };
        }
        const res = await fetch('/api/checkout-init', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({
            items: itemsForCheckout, email: buyerEmail, discount_percent: DISCOUNT,
            allow_owned: window.__dccAllowOwned === true,
            coupon_code: promo?.code || null, customizations: customizationsPayload,
            currency: (window.dccChosenCcy ? window.dccChosenCcy() : 'USD'),
            gift,
            // the ad click that brought them, if there was one and it is still
            // inside Google's own 90-day claim window
            ...(function () {
              try {
                var g = JSON.parse(localStorage.getItem('dcc_gclid') || 'null');
                if (g && g.id && Date.now() - Number(g.at || 0) < 90 * 86400000) return { gclid: g.id, ad_click_source: g.src || 'gclid' };
              } catch (_) {}
              return {};
            })(),
          }),
        });
        const data = await res.json();
        if (res.status === 409 && data.code === 'already_owned') {
          showOwned(data.owned || []);
          btn.disabled = false; btn.textContent = 'Checkout';
          return;
        }
        document.getElementById('owned-panel').hidden = true;
        if (!res.ok || !data.transaction_id) throw new Error(data.error || 'Could not start checkout.');
        // Reveal our on-site inline checkout and render Paddle INSIDE it — fully
        // branded via the dashboard Inline settings — instead of the popup overlay.
        // Passing customer.email pre-fills + locks the email to what we captured.
        document.querySelector('main')?.classList.add('hidden');
        document.getElementById('upsell-wrap')?.classList.add('hidden');
        const lsc = document.getElementById('ls-cross'); if (lsc) lsc.hidden = true;
        document.getElementById('dcc-checkout-section')?.classList.remove('hidden');
        window.__dccPaying = true; if (window.__dccSticky) window.__dccSticky();
        try {
          const n = itemsForCheckout.length, tot = document.getElementById('total')?.textContent || '';
          document.getElementById('pay-summary').textContent = n + (n === 1 ? ' design' : ' designs') + ' · ' + tot + ' · files emailed to ' + buyerEmail + ' the moment payment goes through.';
        } catch (_) {}
        window.scrollTo({ top: 0, behavior: 'smooth' });
        Paddle.Checkout.open({
          transactionId: data.transaction_id,
          customer: { email: buyerEmail },
          settings: {
            displayMode: 'inline',
            frameTarget: 'dcc-inline-frame',
            frameInitialHeight: 480,
            frameStyle: 'width:100%; min-width:312px; background-color: transparent; border: none;',
          },
        });
        btn.disabled = false; btn.textContent = 'Checkout';
      } catch (err) {
        console.error(err);
        alert(err.message || 'Checkout failed. Please try again.');
        btn.disabled = false; btn.textContent = 'Checkout';
      }
    });

    // "You already own this": checkout-init paused because the buyer's email
    // already has some of these designs. Offer to drop them, fetch the files,
    // or buy again on purpose (a spare copy for a friend, say).
    function showOwned(owned) {
      const panel = document.getElementById('owned-panel');
      const list = document.getElementById('owned-list');
      list.innerHTML = '';
      owned.forEach((o) => {
        const li = document.createElement('li');
        const a = document.createElement('a');
        a.href = '/product/' + o.slug; a.textContent = o.title; a.className = 'underline';
        li.appendChild(a); list.appendChild(li);
      });
      document.getElementById('owned-count').textContent = owned.length === 1 ? 'this design' : owned.length + ' of these designs';
      panel.dataset.ids = JSON.stringify(owned.map((o) => o.id));
      const em = (document.getElementById('buyer-email')?.value || '').trim();
      if (em) document.getElementById('owned-download').href = '/resend-downloads?email=' + encodeURIComponent(em);
      panel.hidden = false;
      panel.scrollIntoView({ behavior: 'smooth', block: 'center' });
      try { navigator.sendBeacon('/api/track', new Blob([JSON.stringify({ p: '/cart', t: 'already_owned' })], { type: 'application/json' })); } catch (_) {}
    }
    document.getElementById('owned-remove')?.addEventListener('click', () => {
      const ids = JSON.parse(document.getElementById('owned-panel').dataset.ids || '[]');
      try {
        const c = JSON.parse(localStorage.getItem('cart') || '[]').filter((x) => !ids.includes(String(x.id)));
        localStorage.setItem('cart', JSON.stringify(c));
        window.dispatchEvent(new Event('cart-changed'));
      } catch (_) {}
      location.reload();
    });
    document.getElementById('owned-anyway')?.addEventListener('click', () => {
      window.__dccAllowOwned = true;
      document.getElementById('owned-panel').hidden = true;
      document.getElementById('checkout')?.click();
    });

    // Gift option: reveal the recipient fields when ticked.
    document.getElementById('gift-check')?.addEventListener('change', (e) => {
      document.getElementById('gift-fields')?.classList.toggle('hidden', !e.target.checked);
      if (e.target.checked) setTimeout(() => document.getElementById('gift-to')?.focus(), 50);
    });
    // Came from "Give it as a gift" on the membership page: open the gift fields.
    try {
      if (localStorage.getItem('dcc_gift_intent') === '1') {
        localStorage.removeItem('dcc_gift_intent');
        const gc = document.getElementById('gift-check');
        if (gc && !gc.checked) { gc.checked = true; gc.dispatchEvent(new Event('change')); }
      }
    } catch (_) {}

    // Back to cart from the inline checkout. FIRST click offers to email the
    // cart (we know exactly this is where sales die — the funnel's
    // "Reached payment → Paid" gap); second click or "just take me back"
    // reloads as before. Offer shows once per checkout open.
    let exitOffered = false;
    document.getElementById('dcc-checkout-back')?.addEventListener('click', () => {
      const offer = document.getElementById('dcc-exit-save');
      const em = (emailInput?.value || localStorage.getItem('buyer_email') || '').trim().toLowerCase();
      const items = JSON.parse(localStorage.getItem('cart') || '[]');
      if (!exitOffered && offer && /^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(em) && items.length) {
        exitOffered = true;
        offer.classList.remove('hidden');
        offer.scrollIntoView({ behavior: 'smooth', block: 'center' });
        return;
      }
      window.location.reload();
    });
    document.getElementById('dcc-exit-save-no')?.addEventListener('click', () => window.location.reload());
    document.getElementById('dcc-exit-save-yes')?.addEventListener('click', async () => {
      const msg = document.getElementById('dcc-exit-save-msg');
      const em = (emailInput?.value || localStorage.getItem('buyer_email') || '').trim().toLowerCase();
      const items = JSON.parse(localStorage.getItem('cart') || '[]').map((x) => ({ title: x.title, price: Number(x.price) || 0 }));
      msg.textContent = 'Sending…'; msg.className = 'text-xs mt-2 text-ink-700/60';
      try {
        const r = await fetch('/api/save-cart-email', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ email: em, items }) });
        const d = await r.json();
        msg.textContent = d.message || d.error || 'Done.';
        msg.className = 'text-xs mt-2 ' + (r.ok && d.ok ? 'text-green-700' : 'text-red-600');
        if (r.ok && d.ok) setTimeout(() => window.location.reload(), 1800);
      } catch {
        msg.textContent = 'Network error, going back to your cart.'; msg.className = 'text-xs mt-2 text-red-600';
        setTimeout(() => window.location.reload(), 1500);
      }
    });

    // ── One-tap discount code from the hint ──────────────────────────
    document.addEventListener('click', (e) => {
      const b = e.target.closest && e.target.closest('.cart-apply-code');
      if (!b) return;
      const box = document.querySelector('.cart-promo'); if (box) box.open = true;
      promoCodeInput.value = b.dataset.code || '';
      document.getElementById('promo-apply')?.click();
    });

    // ── Phone bottom bar: total + Checkout, while the real button is off screen ──
    (function () {
      const bar = document.getElementById('cart-sticky');
      const btn = document.getElementById('checkout');
      if (!bar || !btn) return;
      let btnVisible = false;
      const update = () => {
        const c = JSON.parse(localStorage.getItem('cart') || '[]');
        const phone = window.matchMedia('(max-width: 1023px)').matches;
        bar.hidden = !(phone && c.length && !btnVisible && !window.__dccPaying);
      };
      window.__dccSticky = update;
      if ('IntersectionObserver' in window) {
        new IntersectionObserver((entries) => { btnVisible = entries[0].isIntersecting; update(); }).observe(btn);
      }
      window.addEventListener('resize', update);
      update();
      document.getElementById('cart-sticky-btn')?.addEventListener('click', () => {
        const em = (emailInput?.value || '').trim();
        if (!/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(em)) {
          emailInput?.scrollIntoView({ behavior: 'smooth', block: 'center' });
          setTimeout(() => emailInput?.focus(), 350);
          return;
        }
        btn.click();
      });
    })();

    // ── Express fast-track ─────────────────────────────────────────────
    // A "Buy it now" click lands here with ?express=1. If we already know a
    // valid email (returning buyer) and nothing needs personalizing, open the
    // checkout in one step. Otherwise focus the one field we still need.
    (function () {
      if (new URLSearchParams(location.search).get('express') !== '1') return;
      const cart = JSON.parse(localStorage.getItem('cart') || '[]');
      if (!cart.length) return;
      setTimeout(() => {
        const email = (emailInput?.value || '').trim().toLowerCase();
        const emailOk = /^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(email);
        const hasRequired = !!document.querySelector('[data-cart-idx][required]');
        if (emailOk && !hasRequired) {
          whenPaddleReady(() => document.getElementById('checkout')?.click());
        } else {
          const target = emailOk ? document.getElementById('checkout') : emailInput;
          target?.scrollIntoView({ behavior: 'smooth', block: 'center' });
          if (!emailOk) setTimeout(() => emailInput?.focus(), 300);
        }
      }, 450);
    })();
  </script>
