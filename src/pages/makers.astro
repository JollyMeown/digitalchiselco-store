---
// Public Cut Local maker directory + animated map. Gated/noindex until launch
// (flip growth_settings.marketplace_enabled to feature it in nav).
//
// Built to scale (owner, 2026-09-20: "this will be a hub of 1000s of makers"):
// the first page is rendered on the server, the rest arrives on demand from
// /api/mp/makers-list, thumbnails are cut to card size by the transformer, and
// the whole page is edge cached for 5 minutes.
import Shell from '../layouts/Shell.astro';
import MakerMap from '../components/MakerMap.tsx';
import { makerPage, PAGE } from './api/mp/makers-list';
let gallery: any[] = [];
let total = 0;
try {
  const first = await makerPage({ limit: PAGE });
  gallery = first.makers;
  total = first.total;
} catch {}
const stars = (n: number) => '★★★★★'.slice(0, Math.round(n || 0)) + '☆☆☆☆☆'.slice(0, 5 - Math.round(n || 0));
const MACHINE: Record<string, string> = { cnc_router: 'CNC router', cnc_mill: 'CNC mill', laser: 'Laser', fdm: '3D print', resin: 'Resin print' };
---
<Shell title="Find a Maker · Cut Local" description="Meet the CNC, laser and 3D-print makers ready to turn our designs into real pieces — near you." noindex={true}>
  <main class="max-w-5xl mx-auto px-4 sm:px-6 pb-24">
    <header class="text-center pt-6 pb-7">
      <p class="text-xs tracking-[0.2em] uppercase text-bronze-600 mb-3">Cut Local · the maker network</p>
      <h1 class="font-serif text-4xl sm:text-5xl text-bronze-800 leading-tight">Made by a maker near you</h1>
      <p class="mt-4 text-ink-700/80 max-w-xl mx-auto">Every glowing dot is a real workshop ready to build. Find any design you love, request it, and let a trusted local maker bring it to life.</p>
    </header>

    <div class="rounded-2xl overflow-hidden border border-bronze-600/25 shadow-lg" style="background:#0e0a04">
      <MakerMap client:load />
    </div>

    <div class="grid sm:grid-cols-3 gap-4 mt-8 text-center">
      <div class="bg-cream/50 border border-bronze-600/15 rounded-xl p-5">
        <div class="text-2xl mb-1">🔎</div><div class="font-serif text-lg text-bronze-800">Find a design</div>
        <p class="text-sm text-ink-700/70 mt-1">Browse 1,500+ designs and pick the one you want made.</p>
      </div>
      <div class="bg-cream/50 border border-bronze-600/15 rounded-xl p-5">
        <div class="text-2xl mb-1">💬</div><div class="font-serif text-lg text-bronze-800">Get local quotes</div>
        <p class="text-sm text-ink-700/70 mt-1">Makers near you quote and chat. Compare price, speed and star ratings.</p>
      </div>
      <div class="bg-cream/50 border border-bronze-600/15 rounded-xl p-5">
        <div class="text-2xl mb-1">🪵</div><div class="font-serif text-lg text-bronze-800">Hold it in your hands</div>
        <p class="text-sm text-ink-700/70 mt-1">Pick a maker, they build it, you get a real piece — often local pickup.</p>
      </div>
    </div>

    {gallery.length > 0 && (
      <section class="mt-10" id="makers">
        <h2 class="font-serif text-2xl sm:text-3xl text-bronze-800 text-center">Meet the makers</h2>
        <p class="text-sm text-ink-700/65 text-center mt-1.5 max-w-lg mx-auto">Real workshops, real work. Open a profile, see every job they have delivered and what customers said, then hire them directly.</p>

        <div class="mt-5 flex flex-wrap gap-2 justify-center items-center">
          <input id="mk-q" type="search" placeholder="Search by name, town or country" autocomplete="off"
                 class="w-full sm:w-72 px-3 py-2 text-sm border border-black/15 rounded-lg bg-white focus:outline-none focus:border-bronze-600" />
          <select id="mk-machine" class="px-3 py-2 text-sm border border-black/15 rounded-lg bg-white">
            <option value="">Any machine</option>
            <option value="cnc_router">CNC router</option>
            <option value="cnc_mill">CNC mill</option>
            <option value="laser">Laser</option>
            <option value="fdm">3D print</option>
            <option value="resin">Resin print</option>
          </select>
          <span id="mk-count" class="text-xs text-ink-700/60" data-total={total}>{total} maker{total === 1 ? '' : 's'}</span>
        </div>

        <div id="mk-grid" class="grid sm:grid-cols-2 gap-5 mt-6">
          {gallery.map((m) => (
            <a href={`/m/${m.id}`} class="group block bg-white border border-black/10 rounded-2xl overflow-hidden hover:shadow-lg hover:border-bronze-600/40 transition">
              {m.thumbs.length > 0 && (
                <div class="grid grid-cols-3 gap-0.5 h-36 overflow-hidden">
                  {m.thumbs.map((u: string) => (
                    <img src={u} width="400" height="288" loading="lazy" decoding="async"
                         class="w-full h-36 object-cover group-hover:scale-105 transition-transform duration-500" alt="" />
                  ))}
                </div>
              )}
              <div class="p-4">
                <div class="flex items-center gap-2 flex-wrap">
                  <span class="font-serif text-lg text-bronze-800">{m.name}</span>
                  <span class="text-[10px] px-2 py-0.5 rounded-full bg-green-100 text-green-800 font-medium">✓ Verified</span>
                </div>
                <div class="text-xs text-ink-700/60 mt-1">
                  {m.reviews > 0
                    ? <span><span class="text-bronze-600">{stars(m.rating)}</span> {m.rating.toFixed(1)} · {m.jobs} job{m.jobs === 1 ? '' : 's'} delivered</span>
                    : <span>New maker · founding member</span>}
                  {m.place ? ' · ' + m.place : ''}
                </div>
                <div class="flex flex-wrap gap-1.5 mt-2.5">
                  {m.machines.map((t: string) => <span class="text-[11px] px-2 py-0.5 rounded-full bg-[#2c6a67]/10 text-[#1c4a48] font-medium">{MACHINE[t] || t}</span>)}
                  {m.materials.map((t: string) => <span class="text-[11px] px-2 py-0.5 rounded-full border border-black/10 text-ink-700/60">{t}</span>)}
                </div>
                <div class="text-xs font-bold text-bronze-600 mt-3 group-hover:translate-x-0.5 transition-transform">View profile &amp; hire →</div>
              </div>
            </a>
          ))}
        </div>

        <p id="mk-empty" class="hidden text-center text-sm text-ink-700/60 py-8">No maker matches that yet. Try a different town, or clear the search.</p>
        <div class="text-center mt-6">
          <button id="mk-more" class={total > gallery.length ? 'border border-bronze-600 text-bronze-700 px-6 py-2.5 rounded-lg text-sm hover:bg-bronze-600/10 transition' : 'hidden'}>
            Show more makers
          </button>
        </div>
      </section>
    )}

    <div class="mt-8 bg-[#2c6a67]/8 border border-[#2c6a67]/25 rounded-2xl p-5 sm:p-6 max-w-2xl mx-auto">
      <div class="flex items-start gap-3">
        <div class="text-2xl">🤝</div>
        <div>
          <div class="font-serif text-lg text-bronze-800">How paying works (the simple, safe way)</div>
          <p class="text-sm text-ink-700/75 mt-1.5 leading-relaxed">
            We are the introduction, not the middleman. Requesting quotes is <b>completely free</b>, and you
            <b> pay your chosen maker directly</b>, card, PayPal, or cash on pickup, whatever you two agree in chat.
            Your money never sits with us. What we do is vet every maker, verify their workshop, and keep
            them accountable with public star ratings on every completed job, so you always know exactly who
            you are dealing with.
          </p>
        </div>
      </div>
    </div>

    <div class="text-center mt-10">
      <a href="/catalog" class="inline-block bg-bronze-600 text-cream px-8 py-3.5 rounded-lg font-medium hover:bg-bronze-700 transition">Find a design to get made →</a>
      <p class="text-xs text-ink-700/50 mt-3">Are you a maker? <a href="/become-a-maker" class="text-bronze-600 underline">Join Cut Local →</a> · Already approved? <a href="/maker" class="text-bronze-600 underline">Sign in to your dashboard</a></p>
    </div>
  </main>

<script is:inline>
  (function () {
    var grid = document.getElementById('mk-grid');
    if (!grid) return;
    var more = document.getElementById('mk-more'), countEl = document.getElementById('mk-count');
    var empty = document.getElementById('mk-empty'), qEl = document.getElementById('mk-q'), mEl = document.getElementById('mk-machine');
    var PAGE = 24, offset = grid.children.length, total = Number(countEl.dataset.total || 0), busy = false, timer = null;
    var MACHINE = { cnc_router: 'CNC router', cnc_mill: 'CNC mill', laser: 'Laser', fdm: '3D print', resin: 'Resin print' };
    var esc = function (t) { return String(t == null ? '' : t).replace(/[&<>"]/g, function (c) { return ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]; }); };
    function stars(n) { n = Math.round(n || 0); return '★★★★★'.slice(0, n) + '☆☆☆☆☆'.slice(0, 5 - n); }
    function card(m) {
      var pics = (m.thumbs || []).map(function (u) {
        return '<img src="' + esc(u) + '" width="400" height="288" loading="lazy" decoding="async" class="w-full h-36 object-cover group-hover:scale-105 transition-transform duration-500" alt="">';
      }).join('');
      var tags = (m.machines || []).map(function (t) {
        return '<span class="text-[11px] px-2 py-0.5 rounded-full bg-[#2c6a67]/10 text-[#1c4a48] font-medium">' + esc(MACHINE[t] || t) + '</span>';
      }).concat((m.materials || []).map(function (t) {
        return '<span class="text-[11px] px-2 py-0.5 rounded-full border border-black/10 text-ink-700/60">' + esc(t) + '</span>';
      })).join('');
      var line = m.reviews > 0
        ? '<span class="text-bronze-600">' + stars(m.rating) + '</span> ' + Number(m.rating).toFixed(1) + ' · ' + m.jobs + ' job' + (m.jobs === 1 ? '' : 's') + ' delivered'
        : 'New maker · founding member';
      return '<a href="/m/' + esc(m.id) + '" class="group block bg-white border border-black/10 rounded-2xl overflow-hidden hover:shadow-lg hover:border-bronze-600/40 transition">'
        + (pics ? '<div class="grid grid-cols-3 gap-0.5 h-36 overflow-hidden">' + pics + '</div>' : '')
        + '<div class="p-4"><div class="flex items-center gap-2 flex-wrap"><span class="font-serif text-lg text-bronze-800">' + esc(m.name) + '</span>'
        + '<span class="text-[10px] px-2 py-0.5 rounded-full bg-green-100 text-green-800 font-medium">✓ Verified</span></div>'
        + '<div class="text-xs text-ink-700/60 mt-1">' + line + (m.place ? ' · ' + esc(m.place) : '') + '</div>'
        + '<div class="flex flex-wrap gap-1.5 mt-2.5">' + tags + '</div>'
        + '<div class="text-xs font-bold text-bronze-600 mt-3 group-hover:translate-x-0.5 transition-transform">View profile &amp; hire →</div></div></a>';
    }
    function load(reset) {
      if (busy) return;
      busy = true; more.textContent = 'Loading…';
      var url = '/api/mp/makers-list?offset=' + (reset ? 0 : offset) + '&limit=' + PAGE
        + '&q=' + encodeURIComponent(qEl.value.trim()) + '&machine=' + encodeURIComponent(mEl.value);
      fetch(url).then(function (r) { return r.json(); }).then(function (j) {
        var list = j.makers || [];
        if (reset) { grid.innerHTML = ''; offset = 0; total = j.total || 0; }
        grid.insertAdjacentHTML('beforeend', list.map(card).join(''));
        offset += list.length;
        countEl.textContent = total + ' maker' + (total === 1 ? '' : 's');
        empty.classList.toggle('hidden', total > 0);
        more.className = offset < total ? 'border border-bronze-600 text-bronze-700 px-6 py-2.5 rounded-lg text-sm hover:bg-bronze-600/10 transition' : 'hidden';
        more.textContent = 'Show more makers';
      }).catch(function () { more.textContent = 'Could not load more. Try again.'; })
        .finally(function () { busy = false; });
    }
    more.addEventListener('click', function () { load(false); });
    qEl.addEventListener('input', function () { clearTimeout(timer); timer = setTimeout(function () { load(true); }, 350); });
    mEl.addEventListener('change', function () { load(true); });
  })();
</script>
</Shell>
