---
// "Will it cut?" — drop an STL, find out whether your machine can make it.
//
// This is a traffic asset, not a sales page. Makers link to tools and bookmark
// them; nobody bookmarks a product page. So it is ungated, free, has no signup
// and works on a file the visitor already owns, whoever they bought it from.
//
// The whole analysis runs in the browser. Nothing is uploaded, which is both a
// real privacy guarantee and the reason this costs nothing to run at any volume.
//
// Every term a beginner would not know carries a tooltip. That is deliberate:
// the intermediate crowd already has answers, and the beginner is the one who
// searches, gets stuck, and remembers where the help came from.
import Shell from '../../layouts/Shell.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { MACHINES, CLASSES } from '../../lib/stl-analyse';
import { jsonLd } from '../../lib/jsonld';
import ProductCard from '../../components/ProductCard.astro';
import { getProducts } from '../../lib/queries';

// Somebody who has just dropped an STL in here owns a machine and is deciding
// what to cut this weekend. That is the warmest audience the site gets, and
// until now the page sent them away with nothing to look at. Bestsellers
// rather than newest: a visitor with no history is best served by what most
// other makers actually bought.
let picks: any[] = [];
try { picks = (await getProducts(1, 8, 'best'))?.products ?? []; } catch {}

const ld = jsonLd({
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'Will it cut? STL checker for CNC',
  applicationCategory: 'DesignApplication',
  operatingSystem: 'Any browser',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  description: 'Check any STL against your CNC machine: size, relief depth, detail loss by bit size, estimated cut time and file health. Runs entirely in your browser.',
});
---
<Shell
  title="Will it cut? Free STL checker for CNC routers · DigitalChiselCo"
  description="Drop in any STL and find out if your CNC can cut it: fit against your work area, relief depth, how much detail your bit will lose, estimated cut time and file health. Free, no signup, and your file never leaves your computer."
  fullWidth={true}
>
  <script type="application/ld+json" set:html={ld} />

  <div class="wic">
    <div class="wic-wrap">
      <Breadcrumbs crumbs={[{ label: 'Tools', href: '/tools' }, { label: 'Will it cut?' }]} />

      <header class="wic-hero">
        <h1>Will it cut?</h1>
        <p class="lede">
          Drop in any STL file and find out whether your machine can actually make it, before you
          clamp down a board. Works on any file from anywhere, not just ours.
        </p>
        <p class="privacy">
          <strong>Your file never leaves your computer.</strong> There is no upload. The whole thing runs
          inside this page, which you can verify by turning off your wifi and using it anyway.
        </p>
      </header>

      <!-- ── drop zone ─────────────────────────────────────────────────── -->
      <div id="drop" class="drop" tabindex="0" role="button" aria-label="Choose an STL file or drop one here">
        <input id="file" type="file" accept=".stl,model/stl" hidden />
        <div class="drop-in">
          <svg viewBox="0 0 24 24" width="34" height="34" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M12 16V4m0 0L7.5 8.5M12 4l4.5 4.5" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M4 15v3a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-3" stroke-linecap="round"/>
          </svg>
          <p class="drop-t">Drop an STL here, or click to choose</p>
          <p class="drop-s">Binary or ASCII. Large files are fine.</p>
        </div>
      </div>
      <div id="progress" class="progress" hidden><div id="bar"></div><span id="ptext">Reading…</span></div>
      <p id="err" class="err" hidden></p>

      <!-- ── results ───────────────────────────────────────────────────── -->
      <div id="out" hidden>
        <div class="grid2">
          <figure class="preview">
            <canvas id="pv" width="520" height="520" aria-label="Shaded preview of the model seen from above"></canvas>
            <figcaption>What the cutter sees, looking straight down. This is generated from your file.</figcaption>
          </figure>

          <div class="verdict" id="verdict"></div>
        </div>

        <!-- setup -->
        <section class="panel">
          <h2>Your setup</h2>
          <div class="fields">
            <label class="f">
              <span>Machine
                <button class="tip" type="button" data-tip="Pick the closest match. These are real cutting areas, which are always a little smaller than the size printed on the box once the gantry and your clamps are in the way.">?</button>
              </span>
              <select id="machine">
                {MACHINES.map((m, i) => <option value={i}>{m.name} ({m.x} x {m.y} mm)</option>)}
                <option value="custom">Custom size…</option>
              </select>
            </label>
            <div class="f two" id="customWrap" hidden>
              <label><span>Width mm</span><input id="cw" type="number" value="600" min="20" /></label>
              <label><span>Depth mm</span><input id="cd" type="number" value="400" min="20" /></label>
            </div>
            <label class="f">
              <span>Machine class
                <button class="tip" type="button" data-tip="How rigid your machine is. A belt-driven hobby machine has to take lighter cuts than a ball-screw machine, so the same job takes it much longer. If you are unsure, pick the slower one: the estimate will be pessimistic rather than a nasty surprise.">?</button>
              </span>
              <select id="cls">{CLASSES.map((c, i) => <option value={i} selected={i === 1}>{c.name}</option>)}</select>
            </label>
            <label class="f">
              <span>Finishing bit
                <button class="tip" type="button" data-tip="A ball nose is a round-tipped cutter. It is what carves the 3D detail, because a flat cutter cannot follow a curved surface. The number is the full width of the cutter, so a 3 mm ball nose has a 1.5 mm radius tip.">?</button>
              </span>
              <select id="ball">
                <option value="1.5">1.5 mm ball nose</option>
                <option value="3" selected>3 mm ball nose (1/8 inch)</option>
                <option value="6">6 mm ball nose (1/4 inch)</option>
              </select>
            </label>
            <label class="f">
              <span>Stepover <output id="soOut">10%</output>
                <button class="tip" type="button" data-tip="How far the cutter moves sideways between passes, as a percentage of its width. Smaller means smoother and much slower. Around 10% is the usual choice for a finishing pass. Going below about 8% mostly buys you extra hours, not extra detail.">?</button>
              </span>
              <input id="so" type="range" min="5" max="30" value="10" step="1" />
            </label>
            <label class="f">
              <span>Scale <output id="scOut">100%</output>
                <button class="tip" type="button" data-tip="Resize the whole model. Careful: scaling a relief changes its DEPTH by the same amount, so a model scaled to half size is also half as deep and will look flat. Watch the depth figure as you drag this.">?</button>
              </span>
              <input id="sc" type="range" min="25" max="300" value="100" step="5" />
            </label>
          </div>
        </section>

        <!-- numbers -->
        <section class="panel">
          <h2>What is in the file</h2>
          <div id="facts" class="facts"></div>
        </section>

        <section class="panel">
          <h2>What each pass will actually leave
            <button class="tip" type="button" data-tip="These are not photographs and they are not stock pictures. Each one is your file with the cutter you picked applied to it: the flat cutter cannot reach into corners and leaves layers, the ball nose reaches further and leaves fine ridges between passes. Change the bit or the stepover and watch them change.">?</button>
          </h2>
          <div class="sims">
            <figure><canvas id="sim0" width="420" height="420"></canvas><figcaption><b>The model</b><span id="sim0n"></span></figcaption></figure>
            <figure><canvas id="sim1" width="420" height="420"></canvas><figcaption><b>After roughing</b><span id="sim1n"></span></figcaption></figure>
            <figure><canvas id="sim2" width="420" height="420"></canvas><figcaption><b>After finishing</b><span id="sim2n"></span></figcaption></figure>
          </div>
          <p class="note" id="simNote"></p>
          <p class="note small">This simulates the surface your cutter can reach, which is the part that decides how the carving looks. It is not a full toolpath verification: it does not model your holder colliding with a tall wall, ramping, climb versus conventional, or deflection on a long thin bit.</p>
        </section>

        <section class="panel">
          <h2>How much detail your bit will lose
            <button class="tip" type="button" data-tip="A round cutter cannot reach into a corner tighter than its own tip. This works out, for your actual file, how deep the detail is that each bit would smooth over. It is the same maths the cutter performs on the wood.">?</button>
          </h2>
          <div id="detail" class="bars"></div>
          <p class="note" id="detailNote"></p>
        </section>

        <section class="panel">
          <h2>Roughly how long it will take
            <button class="tip" type="button" data-tip="An estimate, not a quote. It assumes a 6 mm cutter for roughing and your chosen ball nose for finishing, with no tool changes and no dawdling. Your own CAM software is the real answer. Treat this as the difference between an afternoon and a weekend.">?</button>
          </h2>
          <div id="time" class="times"></div>
        </section>

        <section class="panel share">
          <h2>Share the result</h2>
          <p>Stuck on something, or want a second opinion? Take the card and post it wherever you are asking.</p>
          <div class="share-row">
            <button id="dl" class="btn" type="button">Download result card</button>
            <button id="cp" class="btn ghost" type="button">Copy summary as text</button>
          </div>
          <p class="note" id="shareNote" hidden></p>
        </section>
      </div>

      <section class="panel faq">
        <h2>Questions people ask</h2>
        <details><summary>Is my file really not uploaded?</summary><p>Really. Everything happens in the page. Disconnect from the internet after this page loads and the tool still works, which is the easiest way to prove it to yourself.</p></details>
        <details><summary>My file is in inches, not millimetres</summary><p>STL files carry no units at all, which is the single most common cause of a model arriving 25 times too big or too small. This tool assumes millimetres. If the dimensions look about 25 times too small, your file is in inches, so use the scale slider at 2540%.</p></details>
        <details><summary>It says my model needs rotating</summary><p>Reliefs are often exported lying on their side or upside down, usually because the modelling software and the CAM software disagree about which axis is up. We test all six directions, and if one of them has the flat back the model needs, we tell you which way to turn it. Every number on the page then assumes you have.</p></details>
        <details><summary>It says my model is a full 3D model</summary><p>That means there is no flat face in any of the six directions, so no amount of rotating will let a router reach the whole shape from one side. Cut it as two halves and glue them, use a 4th axis, or 3D print it.</p></details>
        <details><summary>What is an open edge?</summary><p>A hole in the mesh. A watertight model has every edge shared by exactly two triangles. A few open edges usually cut fine. Thousands mean the file is damaged and your software may refuse it or produce strange toolpaths.</p></details>
        <details><summary>Can I trust the time estimate?</summary><p>As a rough order of magnitude, yes. It is deliberately simple and does not know about your ramping, your lead-ins or your tool changes. If it says four hours, expect somewhere between three and six.</p></details>
      </section>

      {picks.length > 0 && (
        <section class="shop">
          <div class="shop-head">
            <h2>Something to cut this weekend</h2>
            <p>Every design here is a single STL with the relief already modelled, so your only job is the toolpaths. Run any of them back through the checker above before you buy.</p>
          </div>
          <div class="shop-grid">
            {picks.map((p: any) => <ProductCard product={p} />)}
          </div>
          <div class="shop-more">
            <a class="btn" href="/catalog">Browse all designs</a>
            <a class="btn ghost" href="/collections">Browse by collection</a>
            <a class="btn ghost" href="/free">Free files</a>
          </div>
        </section>
      )}

      <p class="foot">
        Built by <a href="/">DigitalChiselCo</a>. If it gets something wrong on your file,
        <a href="/contact">tell us</a> and we will fix it. More on the numbers behind this in the
        <a href="/blog/cnc-valet-tray-and-serving-tray">tray guide</a> and
        <a href="/blog/how-to-scale-stl-files-for-cnc-routers">scaling STL files</a>.
      </p>
    </div>
  </div>

  <div id="tipbox" class="tipbox" hidden role="tooltip"></div>
</Shell>

<script>
  import { parseSTL, analyse, cutTime, fmtTime, simulate, MACHINES, CLASSES, type Analysis } from '../../lib/stl-analyse';

  const $ = (id: string) => document.getElementById(id)!;
  let A: Analysis | null = null;
  let fileName = '';

  // ── tooltips ──────────────────────────────────────────────────────────
  const tipbox = $('tipbox');
  let openTip: HTMLElement | null = null;
  const closeTip = () => { tipbox.hidden = true; openTip?.setAttribute('aria-expanded', 'false'); openTip = null; };
  document.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest('.tip') as HTMLElement | null;
    if (!b) { if (!tipbox.contains(e.target as Node)) closeTip(); return; }
    e.preventDefault();
    if (openTip === b) return closeTip();
    tipbox.textContent = b.dataset.tip || '';
    tipbox.hidden = false;
    const r = b.getBoundingClientRect();
    const w = Math.min(320, window.innerWidth - 24);
    tipbox.style.width = w + 'px';
    tipbox.style.left = Math.max(12, Math.min(window.innerWidth - w - 12, r.left + r.width / 2 - w / 2)) + 'px';
    tipbox.style.top = (window.scrollY + r.bottom + 8) + 'px';
    b.setAttribute('aria-expanded', 'true');
    openTip = b;
  });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeTip(); });

  // ── file intake ───────────────────────────────────────────────────────
  const drop = $('drop'), input = $('file') as HTMLInputElement;
  drop.addEventListener('click', () => input.click());
  drop.addEventListener('keydown', (e: any) => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); input.click(); } });
  drop.addEventListener('dragover', (e) => { e.preventDefault(); drop.classList.add('over'); });
  drop.addEventListener('dragleave', () => drop.classList.remove('over'));
  drop.addEventListener('drop', (e: any) => {
    e.preventDefault(); drop.classList.remove('over');
    if (e.dataTransfer?.files?.[0]) load(e.dataTransfer.files[0]);
  });
  input.addEventListener('change', () => { if (input.files?.[0]) load(input.files[0]); });

  function setProgress(p: number, label?: string) {
    $('progress').hidden = false;
    ($('bar') as HTMLElement).style.width = Math.round(p * 100) + '%';
    if (label) $('ptext').textContent = label;
  }

  async function load(file: File) {
    $('err').hidden = true;
    $('out').hidden = true;
    fileName = file.name;
    setProgress(0.05, `Reading ${file.name}…`);
    try {
      const buf = await file.arrayBuffer();
      setProgress(0.12, 'Parsing triangles…');
      await new Promise((r) => setTimeout(r, 16));        // let the bar paint
      const pos = parseSTL(buf);
      if (pos.length < 9) throw new Error('No triangles found in this file.');
      setProgress(0.2, 'Measuring…');
      await new Promise((r) => setTimeout(r, 16));
      A = analyse(pos, (p) => setProgress(0.2 + p * 0.78));
      setProgress(1, 'Done');
      $('progress').hidden = true;
      $('out').hidden = false;
      drawPreview();
      render();
      drawSims();
      $('out').scrollIntoView({ behavior: 'smooth', block: 'start' });
    } catch (e: any) {
      $('progress').hidden = true;
      $('err').hidden = false;
      $('err').textContent = e?.message || 'Could not read that file.';
    }
  }

  // ── shading: one routine, so the model and both simulated surfaces are
  // lit identically and any difference you see is the cutter, not the render ─
  function shade(cv: HTMLCanvasElement, H: Float32Array, w: number, h: number, cell: number,
                 lo?: number, hi?: number) {
    const ctx = cv.getContext('2d')!;
    if (lo === undefined || hi === undefined) {
      lo = Infinity; hi = -Infinity;
      for (let i = 0; i < H.length; i++) { const v = H[i]; if (Number.isNaN(v)) continue; if (v < lo) lo = v; if (v > hi) hi = v; }
    }
    const span = (hi as number) - (lo as number) || 1;
    const img = ctx.createImageData(w, h);
    const LX = -0.55, LY = -0.55, LZ = 0.63;
    for (let y = 0; y < h; y++) {
      for (let x = 0; x < w; x++) {
        const i = y * w + x, o = i * 4;
        const z = H[i];
        if (Number.isNaN(z)) { img.data[o] = 250; img.data[o + 1] = 247; img.data[o + 2] = 240; img.data[o + 3] = 255; continue; }
        const zx = (H[i + (x < w - 1 ? 1 : 0)] - H[i - (x > 0 ? 1 : 0)]);
        const zy = (H[i + (y < h - 1 ? w : 0)] - H[i - (y > 0 ? w : 0)]);
        const sx = Number.isNaN(zx) ? 0 : zx, sy = Number.isNaN(zy) ? 0 : zy;
        const k = 2.2 / (cell || 1);
        let nx = -sx * k, ny = -sy * k, nz = 1;
        const len = Math.hypot(nx, ny, nz); nx /= len; ny /= len; nz /= len;
        const lam = Math.max(0, nx * LX + ny * LY + nz * LZ);
        const amb = 0.36 + 0.24 * ((z - (lo as number)) / span);
        const v = Math.min(1, amb + 0.72 * lam);
        img.data[o] = Math.round(196 * v + 24);
        img.data[o + 1] = Math.round(152 * v + 18);
        img.data[o + 2] = Math.round(96 * v + 12);
        img.data[o + 3] = 255;
      }
    }
    const tmp = document.createElement('canvas'); tmp.width = w; tmp.height = h;
    tmp.getContext('2d')!.putImageData(img, 0, 0);
    const sc = Math.min(cv.width / w, cv.height / h);
    ctx.fillStyle = '#FAF7F0'; ctx.fillRect(0, 0, cv.width, cv.height);
    ctx.imageSmoothingQuality = 'high';
    ctx.drawImage(tmp, (cv.width - w * sc) / 2, (cv.height - h * sc) / 2, w * sc, h * sc);
  }

  // The three simulated panels share ONE height range, taken from the model,
  // so a surface that sits higher after roughing actually looks higher rather
  // than being renormalised back to the same picture.
  let simTimer: any;
  function drawSims() {
    if (!A) return;
    const ball = +($('ball') as HTMLSelectElement).value;
    const so = +($('so') as HTMLInputElement).value;
    const cls = CLASSES[+($('cls') as HTMLSelectElement).value];
    const sim = simulate(A, { roughDia: 6, stepdown: cls.doc, ballDia: ball, stepoverPct: so });

    let lo = Infinity, hi = -Infinity;
    for (const arr of [A.height, sim.rough.z, sim.finish.z]) {
      for (let i = 0; i < arr.length; i++) { const v = arr[i]; if (Number.isNaN(v)) continue; if (v < lo) lo = v; if (v > hi) hi = v; }
    }
    shade($('sim0') as HTMLCanvasElement, A.height, A.grid.w, A.grid.h, A.grid.cell, lo, hi);
    shade($('sim1') as HTMLCanvasElement, sim.rough.z, sim.rough.w, sim.rough.h, sim.rough.cell, lo, hi);
    shade($('sim2') as HTMLCanvasElement, sim.finish.z, sim.finish.w, sim.finish.h, sim.finish.cell, lo, hi);

    $('sim0n').textContent = 'what you bought';
    $('sim1n').textContent = `6 mm flat cutter, ${cls.doc} mm per pass, ${sim.layers} layers`;
    $('sim2n').textContent = `${ball} mm ball nose at ${so}% stepover`;
    $('simNote').innerHTML = sim.scallop >= 0.02
      ? `At ${so}% stepover your ${ball} mm ball nose leaves ridges <strong>${sim.scallop.toFixed(3)} mm</strong> high between passes. Sanding removes that. Drop the stepover and the ridges shrink, but the pass gets longer in direct proportion.`
      : `At ${so}% stepover the ridges between passes are under a hundredth of a millimetre, which you will never see or feel. Going finer buys nothing but hours.`;
  }
  const drawSimsSoon = () => { clearTimeout(simTimer); simTimer = setTimeout(drawSims, 90); };

  // ── preview: shade the height grid so it looks like the real thing ────
  function drawPreview() {
    if (!A) return;
    const cv = $('pv') as HTMLCanvasElement, ctx = cv.getContext('2d')!;
    const { w, h } = A.grid, H = A.height;
    let lo = Infinity, hi = -Infinity;
    for (let i = 0; i < H.length; i++) { const v = H[i]; if (Number.isNaN(v)) continue; if (v < lo) lo = v; if (v > hi) hi = v; }
    const span = hi - lo || 1;
    const img = ctx.createImageData(w, h);
    // light from the upper left, the same direction the article photographs use
    const LX = -0.55, LY = -0.55, LZ = 0.63;
    for (let y = 0; y < h; y++) {
      for (let x = 0; x < w; x++) {
        const i = y * w + x, o = i * 4;
        const z = H[i];
        if (Number.isNaN(z)) { img.data[o] = 250; img.data[o + 1] = 247; img.data[o + 2] = 240; img.data[o + 3] = 255; continue; }
        const zx = (H[i + (x < w - 1 ? 1 : 0)] - H[i - (x > 0 ? 1 : 0)]);
        const zy = (H[i + (y < h - 1 ? w : 0)] - H[i - (y > 0 ? w : 0)]);
        const sx = Number.isNaN(zx) ? 0 : zx, sy = Number.isNaN(zy) ? 0 : zy;
        const k = 2.2 / (A.grid.cell || 1);
        let nx = -sx * k, ny = -sy * k, nz = 1;
        const len = Math.hypot(nx, ny, nz); nx /= len; ny /= len; nz /= len;
        const lam = Math.max(0, nx * LX + ny * LY + nz * LZ);
        const amb = 0.36 + 0.24 * ((z - lo) / span);
        const v = Math.min(1, amb + 0.72 * lam);
        img.data[o] = Math.round(196 * v + 24);
        img.data[o + 1] = Math.round(152 * v + 18);
        img.data[o + 2] = Math.round(96 * v + 12);
        img.data[o + 3] = 255;
      }
    }
    const tmp = document.createElement('canvas'); tmp.width = w; tmp.height = h;
    tmp.getContext('2d')!.putImageData(img, 0, 0);
    const s = Math.min(cv.width / w, cv.height / h);
    ctx.fillStyle = '#FAF7F0'; ctx.fillRect(0, 0, cv.width, cv.height);
    ctx.imageSmoothingQuality = 'high';
    ctx.drawImage(tmp, (cv.width - w * s) / 2, (cv.height - h * s) / 2, w * s, h * s);
  }

  // ── render ────────────────────────────────────────────────────────────
  const mm = (v: number) => `${v.toFixed(1)} mm`;
  const inch = (v: number) => `${(v / 25.4).toFixed(2)}"`;
  const both = (v: number) => `${mm(v)} <span class="alt">(${inch(v)})</span>`;

  function machine() {
    const sel = ($('machine') as HTMLSelectElement).value;
    if (sel === 'custom') return { name: 'Your machine', x: +($('cw') as HTMLInputElement).value, y: +($('cd') as HTMLInputElement).value, z: 100 };
    return MACHINES[+sel];
  }
  const scale = () => +($('sc') as HTMLInputElement).value / 100;

  function render() {
    if (!A) return;
    const s = scale(), M = machine();
    const O = A.orientation;
    // When the model is lying on its side, every number the maker cares about
    // belongs to the ROTATED model, not the one in the file. Measuring the file
    // as supplied would tell them a 200 mm tray is 25 mm wide and 200 mm deep.
    const eff = O.verdict === 'on-its-side' ? O.rotatedSize : A.size;
    const effDepth = O.verdict === 'on-its-side'
      ? Math.min(O.rotatedSize.x, O.rotatedSize.y, O.rotatedSize.z)
      : A.reliefDepth;
    const sx = eff.x * s, sy = eff.y * s, depth = effDepth * s;
    ($('scOut') as HTMLOutputElement).value = Math.round(s * 100) + '%';
    ($('soOut') as HTMLOutputElement).value = ($('so') as HTMLInputElement).value + '%';

    // fits either way round, because you can turn the board
    const fitsA = sx <= M.x && sy <= M.y, fitsB = sy <= M.x && sx <= M.y;
    const fits = fitsA || fitsB;
    const maxFit = Math.min(M.x / A.size.x, M.y / A.size.y, M.y / A.size.x === Infinity ? Infinity : Math.max(M.x / A.size.y, M.y / A.size.x));
    const fitPct = Math.floor(Math.min(M.x / A.size.x, M.y / A.size.y) * 100);

    const orientCard = O.verdict === 'ok' ? '' : O.verdict === 'not-a-relief'
      ? `<div class="v no"><div class="v-h">This is a full 3D model, not a relief</div>
         <p>There is no flat face anywhere on it, in any orientation, so a router cannot reach the whole
         shape from one side however you turn it. Your options are to cut it in two halves and glue them,
         use a 4th axis, or 3D print it instead. The numbers below still describe the file, but treat the
         cut time as meaningless for this one.</p></div>`
      : `<div class="v turn"><div class="v-h">${O.verdict === 'upside-down' ? 'It is upside down' : 'It is lying the wrong way up'}</div>
         <p>${O.fix} ${O.verdict === 'on-its-side'
            ? `Rotated, it is <strong>${mm(O.rotatedSize.x)} by ${mm(O.rotatedSize.y)}</strong> and
               <strong>${mm(Math.min(O.rotatedSize.x, O.rotatedSize.y, O.rotatedSize.z))}</strong> thick,
               and every figure below already assumes you have done that.`
            : 'Everything below assumes the flat face ends up on the bed.'}</p></div>`;

    $('verdict').innerHTML = orientCard + (fits
      ? `<div class="v ok"><div class="v-h">Yes, this fits</div>
         <p>At ${Math.round(s * 100)}% it is ${mm(sx)} by ${mm(sy)}, and your ${M.name} has ${M.x} by ${M.y} mm of travel.
         ${!fitsA && fitsB ? '<strong>Turn the board 90 degrees</strong> and it fits.' : ''}</p></div>`
      : `<div class="v no"><div class="v-h">Not at this size</div>
         <p>It is ${mm(sx)} by ${mm(sy)} and your ${M.name} gives you ${M.x} by ${M.y} mm.
         Scale to about <strong>${fitPct}%</strong> and it will fit, but read the depth warning below before you do.</p></div>`);

    // facts
    const openPct = A.triangles ? (A.openEdges / (A.triangles * 3)) * 100 : 0;
    const flat = A.flatBack > 0.8;
    const stock = depth + 8;
    // openEdges is -1 when the check was skipped, which only happens on very
    // large meshes. Saying so is better than implying a clean bill of health.
    const meshText = A.openEdges < 0
      ? 'Not checked, this mesh is very large'
      : A.openEdges === 0
        ? 'Watertight, no holes'
        : `${A.openEdges.toLocaleString()} open edges${openPct < 1 ? ', probably fine' : ', this file is damaged'}`;
    const meshTone = A.openEdges < 0 ? '' : A.openEdges === 0 ? 'good' : openPct < 1 ? '' : 'warn';
    $('facts').innerHTML = `
      <div class="fact"><div class="fk">Size</div><div class="fv">${both(sx)} <span class="x">×</span> ${both(sy)}</div></div>
      <div class="fact"><div class="fk">Carved depth <button class="tip" type="button" data-tip="How far the deepest cut goes below the highest point. This is the number that decides how thick your board has to be, and it changes when you scale the model.">?</button></div>
        <div class="fv">${both(depth)}</div></div>
      <div class="fact"><div class="fk">Board thickness you need <button class="tip" type="button" data-tip="The carved depth plus about 8 mm of material left underneath. Any less and the panel will cup as the wood moves, or break while you are handling it.">?</button></div>
        <div class="fv">${both(stock)} <span class="alt">or more</span></div></div>
      <div class="fact"><div class="fk">Triangles</div><div class="fv">${A.triangles.toLocaleString()}</div></div>
      <div class="fact"><div class="fk">Which way up <button class="tip" type="button" data-tip="A relief needs one big flat face to lie on the machine bed so it can be cut from above. We test all six directions to see whether this model has one, and if it does but it is pointing the wrong way, we say which way to turn it.">?</button></div>
        <div class="fv ${O.verdict === 'ok' ? 'good' : O.verdict === 'not-a-relief' ? 'warn' : 'turn'}">${
          O.verdict === 'ok' ? 'Correct, flat side down'
          : O.verdict === 'upside-down' ? 'Upside down, flip it'
          : O.verdict === 'on-its-side' ? 'On its side, rotate it'
          : 'No flat face in any direction'}</div></div>
      <div class="fact"><div class="fk">Mesh health <button class="tip" type="button" data-tip="Open edges are holes in the mesh. A perfect model has none. A handful will cut fine. Thousands mean a damaged file.">?</button></div>
        <div class="fv ${meshTone}">${meshText}</div></div>`;

    // detail loss
    const ok = A.detailLoss.filter((d) => d.measurable);
    const maxLoss = Math.max(...ok.map((d) => d.max * s), 0.001);
    $('detail').innerHTML = A.detailLoss.map((d) => {
      if (!d.measurable) {
        return `<div class="row">
          <div class="row-l">${d.radius} mm ball nose</div>
          <div class="row-track"><span class="row-v muted">too small to measure on a part this size</span></div>
          <div class="row-n"></div></div>`;
      }
      const lost = d.max * s;
      const tone = lost < 0.3 ? 'good' : lost < 1 ? '' : 'warn';
      return `<div class="row">
        <div class="row-l">${d.radius} mm ball nose</div>
        <div class="row-track"><div class="row-bar ${tone}" style="width:${Math.max(2, 86 * lost / maxLoss)}%"></div>
        <span class="row-v">${lost.toFixed(2)} mm lost</span></div>
        <div class="row-n">${d.areaAffected}% of the surface</div></div>`;
    }).join('');

    if (!ok.length) {
      $('detailNote').innerHTML = `This model is large enough that every bit here is finer than the tool can resolve, which is itself the answer: at this size, bit choice is not what limits your detail.`;
    } else {
      const best = ok[0], worst = ok[ok.length - 1];
      const unmeasured = A.detailLoss.length - ok.length;
      const tail = unmeasured ? ` The smaller bits are finer than this tool can resolve on a part this size, so they are not shown.` : '';
      $('detailNote').innerHTML = (worst.max * s > 0.8
        ? `A ${worst.radius} mm bit would smooth over up to ${(worst.max * s).toFixed(2)} mm of this carving across ${worst.areaAffected}% of its surface, which you would see. ${best !== worst ? `The ${best.radius} mm bit loses ${(best.max * s).toFixed(2)} mm.` : ''} On a face, fur or lettering, use the smallest bit you have and accept the longer pass.`
        : `This model is forgiving. Even the ${worst.radius} mm bit only loses ${(worst.max * s).toFixed(2)} mm, so you can cut it with a larger tool and save hours.`) + tail;
    }

    // time
    const cls = CLASSES[+($('cls') as HTMLSelectElement).value];
    const ball = +($('ball') as HTMLSelectElement).value;
    const so = +($('so') as HTMLInputElement).value;
    const t = cutTime(A, cls, ball, so, s);
    $('time').innerHTML = `
      <div class="t"><div class="tk">Roughing</div><div class="tv">${fmtTime(t.roughMin)}</div><div class="tn">clearing waste with a flat cutter</div></div>
      <div class="t"><div class="tk">Finishing</div><div class="tv">${fmtTime(t.finishMin)}</div><div class="tn">${t.passes.toLocaleString()} passes with the ${ball} mm ball nose</div></div>
      <div class="t big"><div class="tk">Total, roughly</div><div class="tv">${fmtTime(t.totalMin * 0.8)} to ${fmtTime(t.totalMin * 1.5)}</div><div class="tn">machine time, not counting setup</div></div>`;
  }

  for (const id of ['machine', 'cls', 'ball', 'so', 'sc', 'cw', 'cd']) {
    $(id).addEventListener('input', () => {
      $('customWrap').hidden = ($('machine') as HTMLSelectElement).value !== 'custom';
      render();
      if (id === 'ball' || id === 'so' || id === 'cls') drawSimsSoon();
    });
  }

  // ── share ─────────────────────────────────────────────────────────────
  function summary() {
    if (!A) return '';
    const s = scale(), M = machine();
    const cls = CLASSES[+($('cls') as HTMLSelectElement).value];
    const ball = +($('ball') as HTMLSelectElement).value;
    const t = cutTime(A, cls, ball, +($('so') as HTMLInputElement).value, s);
    return [
      `${fileName} — checked with Will it cut? (digitalchiselco.com/tools/will-it-cut)`,
      `Size: ${mm(A.size.x * s)} x ${mm(A.size.y * s)}, carved depth ${mm(A.reliefDepth * s)}`,
      `Board needed: ${mm(A.reliefDepth * s + 8)} thick or more`,
      `Machine: ${M.name} (${M.x} x ${M.y} mm) — ${A.size.x * s <= M.x && A.size.y * s <= M.y ? 'fits' : 'does NOT fit at this size'}`,
      `Orientation: ${A.orientation.verdict === 'ok' ? 'correct as supplied' : A.orientation.verdict === 'not-a-relief' ? 'full 3D model, not cuttable from one side' : A.orientation.fix}`,
      `Mesh: ${A.triangles.toLocaleString()} triangles, ${A.openEdges < 0 ? 'mesh check skipped (very large)' : A.openEdges === 0 ? 'watertight' : A.openEdges + ' open edges'}, ${A.flatBack > 0.8 ? 'flat backed' : 'not flat backed'}`,
      `Detail lost: ${A.detailLoss.map((d) => `${d.radius}mm bit ${(d.max * s).toFixed(2)}mm`).join(', ')}`,
      `Estimated cut: ${fmtTime(t.totalMin * 0.8)} to ${fmtTime(t.totalMin * 1.5)} on a ${cls.name} machine`,
    ].join('\n');
  }

  $('cp').addEventListener('click', async () => {
    try { await navigator.clipboard.writeText(summary()); note('Copied. Paste it wherever you are asking.'); }
    catch { note('Could not reach the clipboard. Select the text and copy it by hand.'); }
  });
  function note(t: string) { const n = $('shareNote'); n.hidden = false; n.textContent = t; }

  // ── the result card ───────────────────────────────────────────────────
  //
  // This is the artefact that leaves the site. It gets pasted into forum
  // threads and emailed to whoever sold the file, so it has to stand on its
  // own: every number, the settings that produced them, and the caveats. A
  // card that says "4 hours" without saying which machine and which cutter is
  // worse than no card, because somebody will argue with it.
  //
  // The logo is DRAWN, not loaded. Pulling the PNG off storage would taint the
  // canvas under CORS and make toDataURL throw, which would break the download
  // on exactly the machines where it matters. Path2D takes the same path data
  // the site emblem uses, so it is the real mark either way.
  const CARD = {
    bronze: '#854F0B', bronzeD: '#633806', ink: '#24180d', ink2: '#5c4a38',
    ink3: '#8a7864', cream: '#FBF4E8', surface: '#FFFDF8', card: '#ffffff',
    rule: 'rgba(36,24,13,.16)', good: '#2f7d32', warn: '#b4530f', alt: '#1c5cab',
  };

  function drawEmblem(c, x, y, size) {
    c.save();
    c.translate(x, y); c.scale(size / 48, size / 48);
    c.fillStyle = CARD.bronze;
    c.beginPath(); c.roundRect(0, 0, 48, 48, 10); c.fill();
    c.fillStyle = '#FAEEDA';
    c.fillRect(8, 13, 5, 5);
    c.globalAlpha = 0.7; c.fillRect(8, 21, 5, 5); c.globalAlpha = 1;
    c.fillRect(14, 17, 5, 5);
    c.strokeStyle = '#FAEEDA'; c.lineWidth = 3.6;
    c.stroke(new Path2D('M19 13 H28 a11 11 0 0 1 0 22 H19 Z'));
    c.fillStyle = '#FAEEDA';
    c.beginPath(); c.roundRect(34.5, 12, 4, 18, 2); c.fill();
    c.fill(new Path2D('M34.5 30 h4 l-2 5 z'));
    c.restore();
  }

  $('dl').addEventListener('click', async () => {
    if (!A) return;
    try { await document.fonts?.ready; } catch {}

    const s = scale(), M = machine(), O = A.orientation;
    const cls = CLASSES[+($('cls') as HTMLSelectElement).value];
    const ball = +($('ball') as HTMLSelectElement).value;
    const so = +($('so') as HTMLInputElement).value;
    const eff = O.verdict === 'on-its-side' ? O.rotatedSize : A.size;
    const effDepth = O.verdict === 'on-its-side'
      ? Math.min(O.rotatedSize.x, O.rotatedSize.y, O.rotatedSize.z) : A.reliefDepth;
    const t = cutTime(A, cls, ball, so, s);
    const sx = eff.x * s, sy = eff.y * s, depth = effDepth * s;
    const fits = (sx <= M.x && sy <= M.y) || (sy <= M.x && sx <= M.y);
    // the on-page panels are already drawn with these settings; take their
    // numbers from the same call rather than recomputing and risking a drift
    const simNow = simulate(A, { roughDia: 6, stepdown: cls.doc, ballDia: ball, stepoverPct: so });
    const simScallop = simNow.scallop, simLayers = simNow.layers;

    // The sheet is drawn onto an over-tall canvas and then cropped to whatever
    // the content actually needed. A fixed height left 700px of white below a
    // short model's results, which reads as a broken export rather than a
    // deliberate margin.
    const W = 1200, MAXH = 2400;
    const cv = document.createElement('canvas'); cv.width = W; cv.height = MAXH;
    const c = cv.getContext('2d')!;
    const SERIF = 'Fraunces, Georgia, serif';
    const SANS = '"Instrument Sans", system-ui, -apple-system, sans-serif';

    const text = (str: string, x: number, y: number, font: string, fill: string, align: CanvasTextAlign = 'left') => {
      c.font = font; c.fillStyle = fill; c.textAlign = align; c.fillText(str, x, y); c.textAlign = 'left';
    };
    const wrap = (str: string, x: number, y: number, maxW: number, lh: number, font: string, fill: string) => {
      c.font = font; c.fillStyle = fill;
      const words = str.split(' '); let line = '', yy = y;
      for (const w of words) {
        const test = line ? line + ' ' + w : w;
        if (c.measureText(test).width > maxW && line) { c.fillText(line, x, yy); yy += lh; line = w; }
        else line = test;
      }
      if (line) c.fillText(line, x, yy);
      return yy + lh;
    };
    const heading = (label: string, y: number) => {
      text(label, 56, y, '600 15px ' + SANS, CARD.bronze);
      const w = c.measureText(label).width;
      c.strokeStyle = CARD.rule; c.lineWidth = 1;
      c.beginPath(); c.moveTo(56 + w + 14, y - 5.5); c.lineTo(W - 56, y - 5.5); c.stroke();
      return y + 30;
    };
    const stat = (label: string, value: string, x: number, y: number, sub?: string, tone?: string) => {
      text(label.toUpperCase(), x, y, '500 13px ' + SANS, CARD.ink3);
      text(value, x, y + 30, '600 25px ' + SANS, tone || CARD.ink);
      if (sub) text(sub, x, y + 50, '400 13px ' + SANS, CARD.ink3);
    };

    // background + header band
    c.fillStyle = CARD.surface; c.fillRect(0, 0, W, MAXH);
    c.fillStyle = CARD.cream; c.fillRect(0, 0, W, 112);
    c.fillStyle = CARD.bronze; c.fillRect(0, 112, W, 3);
    drawEmblem(c, 56, 30, 52);
    text('DigitalChiselCo', 124, 60, '600 27px ' + SERIF, CARD.bronzeD);
    text('Free STL checker for CNC', 124, 84, '400 14px ' + SANS, CARD.ink2);
    text('STL MACHINING CHECK', W - 56, 52, '600 15px ' + SANS, CARD.bronze, 'right');
    text(new Date().toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' }),
      W - 56, 78, '400 14px ' + SANS, CARD.ink3, 'right');

    // file name
    let name = fileName || 'model.stl';
    c.font = '600 34px ' + SERIF;
    while (c.measureText(name).width > W - 112 && name.length > 12) name = name.slice(0, -5) + '…';
    text(name, 56, 168, '600 34px ' + SERIF, CARD.ink);
    text(A.triangles.toLocaleString() + ' triangles' + (s !== 1 ? '  ·  shown at ' + Math.round(s * 100) + '% scale' : ''),
      56, 194, '400 15px ' + SANS, CARD.ink3);

    // preview + verdict column
    // The preview box matches the model's own proportions. A fixed square left
    // a letterboxed band inside a bordered box, which looked like a bug.
    const PV = 470, py = 224;
    const aspect = Math.min(1.35, Math.max(0.62, A.grid.h / A.grid.w));
    const PVH = Math.round(PV * aspect);
    const src = $('pv') as HTMLCanvasElement;
    c.fillStyle = CARD.card; c.strokeStyle = CARD.rule; c.lineWidth = 1;
    c.beginPath(); c.roundRect(56, py, PV, PVH, 10); c.fill(); c.stroke();
    c.save();
    c.beginPath(); c.roundRect(62, py + 6, PV - 12, PVH - 12, 7); c.clip();
    // crop the source canvas to its drawn area, which is centred inside it
    const sAsp = A.grid.w / A.grid.h;
    const drawnW = sAsp >= 1 ? src.width : src.width * sAsp;
    const drawnH = sAsp >= 1 ? src.height / sAsp : src.height;
    c.drawImage(src, (src.width - drawnW) / 2, (src.height - drawnH) / 2, drawnW, drawnH,
      62, py + 6, PV - 12, PVH - 12);
    c.restore();

    const RX = 56 + PV + 34;
    let ry = py + 4;
    const badge = (label: string, tone: string, bg: string) => {
      c.font = '600 15px ' + SANS;
      const w = c.measureText(label).width + 30;
      c.fillStyle = bg; c.beginPath(); c.roundRect(RX, ry, w, 34, 17); c.fill();
      text(label, RX + 15, ry + 23, '600 15px ' + SANS, tone);
      ry += 48;
    };
    badge(fits ? 'FITS YOUR MACHINE' : 'TOO BIG AT THIS SIZE',
      fits ? CARD.good : CARD.warn, fits ? '#EAF3EA' : '#FBEFE6');
    if (O.verdict !== 'ok') {
      badge(O.verdict === 'not-a-relief' ? 'NOT A RELIEF' : O.verdict === 'upside-down' ? 'UPSIDE DOWN' : 'NEEDS ROTATING',
        O.verdict === 'not-a-relief' ? CARD.warn : CARD.alt,
        O.verdict === 'not-a-relief' ? '#FBEFE6' : '#EAF0FA');
    }
    ry += 4;
    stat('Size', sx.toFixed(0) + ' × ' + sy.toFixed(0) + ' mm', RX, ry,
      (sx / 25.4).toFixed(2) + '" × ' + (sy / 25.4).toFixed(2) + '"');
    stat('Carved depth', depth.toFixed(1) + ' mm', RX + 230, ry, (depth / 25.4).toFixed(2) + '"');
    ry += 92;
    stat('Board needed', (depth + 8).toFixed(0) + ' mm+', RX, ry, 'depth plus 8 mm floor');
    stat('Machine', M.x + ' × ' + M.y, RX + 230, ry, M.name.slice(0, 22));
    ry += 96;

    // orientation
    let y = Math.max(py + PVH + 46, ry);
    y = heading('ORIENTATION', y);
    const oText = O.verdict === 'ok'
      ? 'Correct as supplied. The flat back is face down, so the whole carving can be reached from above in one setup.'
      : O.verdict === 'not-a-relief'
        ? 'No flat face in any of the six directions, so a router cannot reach the whole shape from one side however it is turned. Cut it as two halves and glue them, use a 4th axis, or 3D print it instead.'
        : O.fix + (O.verdict === 'on-its-side' ? ' Every figure on this sheet already assumes that rotation.' : '');
    y = wrap(oText, 56, y, W - 112, 25, '400 17px ' + SANS, CARD.ink2) + 12;

    // what each pass leaves: the simulated surfaces, drawn from the panels
    // already on the page so the card and the screen can never disagree
    y = heading('WHAT EACH PASS LEAVES', y);
    const panels: [string, string, string][] = [
      ['sim0', 'The model', 'what you bought'],
      ['sim1', 'After roughing', '6 mm flat cutter, ' + cls.doc + ' mm per pass'],
      ['sim2', 'After finishing', ball + ' mm ball nose at ' + so + '% stepover'],
    ];
    const pw = Math.floor((W - 112 - 32) / 3);
    const ph = Math.round(pw * Math.min(1.25, Math.max(0.58, A.grid.h / A.grid.w)));
    const sAsp2 = A.grid.w / A.grid.h;
    panels.forEach(([id, title, sub], i) => {
      const px = 56 + i * (pw + 16);
      const el = $(id) as HTMLCanvasElement;
      c.fillStyle = CARD.card; c.strokeStyle = CARD.rule; c.lineWidth = 1;
      c.beginPath(); c.roundRect(px, y, pw, ph, 8); c.fill(); c.stroke();
      c.save();
      c.beginPath(); c.roundRect(px + 4, y + 4, pw - 8, ph - 8, 5); c.clip();
      const dW = sAsp2 >= 1 ? el.width : el.width * sAsp2;
      const dH = sAsp2 >= 1 ? el.height / sAsp2 : el.height;
      c.drawImage(el, (el.width - dW) / 2, (el.height - dH) / 2, dW, dH, px + 4, y + 4, pw - 8, ph - 8);
      c.restore();
      text(title, px, y + ph + 24, '600 16px ' + SANS, CARD.ink);
      wrap(sub, px, y + ph + 44, pw, 18, '400 13px ' + SANS, CARD.ink3);
    });
    y += ph + 76;
    y = wrap(simScallop >= 0.02
      ? 'Simulated from this file with these cutters. The roughing pass cannot reach the fine detail and leaves ' + simLayers + ' layers; the ball nose restores it and leaves ridges ' + simScallop.toFixed(3) + ' mm high between passes.'
      : 'Simulated from this file with these cutters. The roughing pass cannot reach the fine detail and leaves ' + simLayers + ' layers; the ball nose restores it, and at this stepover the ridges between passes are too small to see.',
      56, y, W - 112, 22, '400 14px ' + SANS, CARD.ink3) + 14;

    // detail loss
    y = heading('DETAIL LOST TO THE CUTTER', y);
    const okLoss = A.detailLoss.filter((d) => d.measurable);
    const maxLoss = Math.max(...okLoss.map((d) => d.max * s), 0.001);
    for (const d of A.detailLoss) {
      text(d.radius + ' mm ball nose', 56, y + 16, '400 17px ' + SANS, CARD.ink);
      if (!d.measurable) {
        text('finer than this model can be measured at', 300, y + 16, 'italic 400 15px ' + SANS, CARD.ink3);
      } else {
        const lost = d.max * s;
        const bw = Math.max(4, 470 * lost / maxLoss);
        const tone = lost < 0.3 ? CARD.good : lost < 1 ? CARD.bronze : CARD.warn;
        c.fillStyle = '#EFE7DA';
        c.beginPath(); c.roundRect(300, y + 4, 470, 15, 4); c.fill();
        c.fillStyle = tone;
        c.beginPath(); c.roundRect(300, y + 4, bw, 15, 4); c.fill();
        text(lost.toFixed(2) + ' mm', 790, y + 16, '600 16px ' + SANS, CARD.ink);
        text('over ' + d.areaAffected + '% of the surface', 880, y + 16, '400 15px ' + SANS, CARD.ink3);
      }
      y += 34;
    }
    y += 6;
    const noLoss = okLoss.length > 0 && okLoss.every((d) => d.max * s < 0.005);
    y = wrap(noLoss
      ? 'This model has no detail finer than any of these cutters, so every one of them reproduces it faithfully. Pick the largest and save the hours.'
      : 'Measured by closing the surface with each cutter, which is what the cutter itself does to the wood. Lower is better.',
      56, y, W - 112, 22, '400 14px ' + SANS, CARD.ink3) + 10;

    // cut time
    y = heading('ESTIMATED CUT TIME', y);
    stat('Roughing', fmtTime(t.roughMin), 56, y, '6 mm flat cutter');
    stat('Finishing', fmtTime(t.finishMin), 356, y, t.passes.toLocaleString() + ' passes');
    stat('Total', fmtTime(t.totalMin * 0.8) + ' – ' + fmtTime(t.totalMin * 1.5), 656, y, 'machine time only', CARD.bronze);
    y += 86;
    y = wrap('Settings used: ' + cls.name + ', ' + cls.rpm.toLocaleString() + ' rpm, ' + cls.feed.toLocaleString() +
      ' mm/min, ' + cls.doc + ' mm depth of cut, ' + ball + ' mm ball nose at ' + so +
      '% stepover. An estimate, not a quote: it does not model ramping, lead-ins or tool changes.',
      56, y, W - 112, 22, '400 14px ' + SANS, CARD.ink3) + 12;

    // file health
    y = heading('FILE HEALTH', y);
    const meshTxt = A.openEdges < 0 ? 'Not checked' : A.openEdges === 0 ? 'Watertight' : A.openEdges.toLocaleString() + ' open edges';
    const meshTone = A.openEdges < 0 ? CARD.ink2 : A.openEdges === 0 ? CARD.good
      : (A.openEdges / (A.triangles * 3)) * 100 < 1 ? CARD.bronze : CARD.warn;
    stat('Mesh', meshTxt, 56, y,
      A.openEdges < 0 ? 'too large to check' : A.openEdges === 0 ? 'no holes' : 'holes in the surface', meshTone);
    stat('Triangles', A.triangles.toLocaleString(), 356, y, 'in the file');
    stat('Degenerate faces', A.degenerate.toLocaleString(), 656, y, A.degenerate ? 'zero-area triangles' : 'none');

    // crop to the content, then put the footer on the bottom of the real sheet
    const contentEnd = Math.min(MAXH - 120, y + 74);
    const H = contentEnd + 104;
    const out = document.createElement('canvas'); out.width = W; out.height = H;
    const o = out.getContext('2d')!;
    o.fillStyle = CARD.surface; o.fillRect(0, 0, W, H);
    o.drawImage(cv, 0, 0, W, contentEnd, 0, 0, W, contentEnd);

    const fy = H - 46;
    o.strokeStyle = CARD.rule; o.lineWidth = 1;
    o.beginPath(); o.moveTo(56, fy - 25.5); o.lineTo(W - 56, fy - 25.5); o.stroke();
    drawEmblem(o, 56, fy - 17, 34);
    o.font = '600 17px ' + SANS; o.fillStyle = CARD.bronze; o.textAlign = 'left';
    o.fillText('digitalchiselco.com/tools/will-it-cut', 102, fy + 1);
    o.font = '400 14px ' + SANS; o.fillStyle = CARD.ink3; o.textAlign = 'right';
    o.fillText('Generated in the browser. This file was never uploaded anywhere.', W - 56, fy + 1);
    o.textAlign = 'left';

    const a = document.createElement('a');
    a.download = (fileName.replace(/\.stl$/i, '') || 'will-it-cut') + '-check.png';
    a.href = out.toDataURL('image/png');
    a.click();
    note('Card saved. Every number on it, and the settings behind them.');
  });
</script>

