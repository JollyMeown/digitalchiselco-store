---
// The tools hub. It exists for three reasons: the breadcrumb on every tool
// points here, a hub gives the free tools somewhere to accumulate, and "free
// CNC tools" is a search anyone building a catalogue of them should own.
//
// Only genuinely free, genuinely useful things belong on this page. The moment
// it becomes a list of teasers for paid software it stops being a reason to
// link here, which is the entire point of having it.
import Shell from '../../layouts/Shell.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';

const TOOLS = [
  {
    href: '/tools/will-it-cut',
    name: 'Will it cut?',
    blurb: 'Drop in any STL and find out whether your machine can make it: size against your work area, carved depth, the board thickness you need, how much detail each bit would smooth away, and roughly how long it will take.',
    tag: 'Free, no signup',
    note: 'Runs in your browser. Your file is never uploaded.',
  },
  {
    href: '/lamp-studio',
    name: 'Lampshade Studio',
    blurb: 'Design a one-piece printable lampshade in the browser, change the profile and the weave live, and download the STL. There is a free demo and a standalone Windows desktop version.',
    tag: 'Free demo',
    note: 'Prints in vase mode with no seam.',
  },
];
---
<Shell
  title="Free CNC and 3D printing tools · DigitalChiselCo"
  description="Free browser tools for CNC routers and 3D printing: check whether an STL will cut on your machine, and design a printable lampshade. No signup, and nothing is uploaded."
>
  <Breadcrumbs crumbs={[{ label: 'Tools' }]} />
  <div class="max-w-3xl">
    <h1 class="font-serif text-3xl md:text-4xl text-bronze-800 leading-tight mt-2">Free tools</h1>
    <p class="mt-3 text-ink-700 leading-relaxed">
      Things we built because we needed them ourselves. They are free, they need no account, and they
      work on any file, not only the ones you bought here.
    </p>

    <div class="mt-8 grid gap-4">
      {TOOLS.map((t) => (
        <a href={t.href} class="block rounded-lg border border-black/10 bg-white p-5 hover:shadow-md hover:border-bronze-600/40 transition no-underline">
          <div class="flex items-baseline justify-between gap-3">
            <h2 class="font-serif text-xl text-bronze-800">{t.name}</h2>
            <span class="text-[11px] uppercase tracking-wider text-bronze-700 bg-cream rounded-full px-2.5 py-1 whitespace-nowrap">{t.tag}</span>
          </div>
          <p class="mt-2 text-sm text-ink-700 leading-relaxed">{t.blurb}</p>
          <p class="mt-2 text-xs text-ink-700/60">{t.note}</p>
        </a>
      ))}
    </div>

    <p class="mt-8 text-sm text-ink-700/70">
      Something you keep doing by hand that a tool could do for you?
      <a href="/contact" class="text-bronze-700 underline">Tell us</a> and it might end up on this page.
    </p>
  </div>
</Shell>
