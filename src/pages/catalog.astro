---
import Shell from '../layouts/Shell.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import ProductCard from '../components/ProductCard.astro';
import Pick5Strip from '../components/Pick5Strip.astro';
import { getProducts, getSettings } from '../lib/queries';

const page = Math.max(1, Number(Astro.url.searchParams.get('page') || '1'));
const sort = Astro.url.searchParams.get('sort') === 'newest' ? 'newest' : 'title';
const { products, total, perPage } = await getProducts(page, 48, sort);
const settings = await getSettings();
const pages = Math.ceil(total / perPage);
const around = Array.from({ length: pages }, (_, i) => i + 1)
  .filter((p) => p === 1 || p === pages || Math.abs(p - page) <= 2);
const qs = (p: number) => `/catalog?${sort === 'newest' ? 'sort=newest&' : ''}page=${p}`;
---
<Shell title="Catalog — All STL Files | DigitalChiselCo" scrollPastBanner={true}>
  <Breadcrumbs crumbs={[{ label: 'Catalog' }]} />
  <h1 class="text-3xl mb-1">Every design, in one place</h1>
  <div class="flex items-center justify-between gap-3 flex-wrap mb-6">
    <p class="text-ink-700/70 text-sm">{total.toLocaleString()} premium bas-relief STL files · ready for CNC, 3D print &amp; laser.</p>
    <!-- Newest-first exists because alphabetical was the only order, which
         buried every new upload wherever its first letter fell. -->
    <div class="inline-flex rounded-lg border border-black/10 overflow-hidden text-sm" role="group" aria-label="Sort">
      <a href="/catalog" class={`px-3 py-1.5 ${sort === 'title' ? 'bg-bronze-600 text-cream' : 'text-ink-700 hover:bg-cream'}`} aria-current={sort === 'title' ? 'true' : undefined}>A to Z</a>
      <a href="/catalog?sort=newest" class={`px-3 py-1.5 border-l border-black/10 ${sort === 'newest' ? 'bg-bronze-600 text-cream' : 'text-ink-700 hover:bg-cream'}`} aria-current={sort === 'newest' ? 'true' : undefined}>Newest</a>
    </div>
  </div>

  <Pick5Strip where="catalog" />

  <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4">
    {products.map((p, i) => <ProductCard product={p} discount={settings.discount_percent} eager={i < 4} />)}
  </div>

  {pages > 1 && (
    <nav class="flex justify-center items-center gap-2 mt-10 text-sm">
      {page > 1 && <a href={qs(page - 1)} class="px-3 py-1.5 border border-black/10 rounded">←</a>}
      {around.map((p, i) => (
        <Fragment>
          {i > 0 && p - around[i - 1] > 1 && <span class="px-1 text-ink-700/40">…</span>}
          <a href={qs(p)} class={`px-3 py-1.5 border rounded ${p === page ? 'bg-bronze-600 text-cream border-bronze-600' : 'border-black/10'}`}>{p}</a>
        </Fragment>
      ))}
      {page < pages && <a href={qs(page + 1)} class="px-3 py-1.5 border border-black/10 rounded">→</a>}
    </nav>
  )}
</Shell>
