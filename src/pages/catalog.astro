---
import Shell from '../layouts/Shell.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import ProductCard from '../components/ProductCard.astro';
import { getProducts, getSettings } from '../lib/queries';

const page = Math.max(1, Number(Astro.url.searchParams.get('page') || '1'));
// ?yt=1 = the main-menu "YouTube films" switch: only designs with a public Short
const ytOnly = Astro.url.searchParams.get('yt') === '1';
const { products, total, perPage } = await getProducts(page, 48, ytOnly);
const settings = await getSettings();
const pages = Math.ceil(total / perPage);
const around = Array.from({ length: pages }, (_, i) => i + 1)
  .filter((p) => p === 1 || p === pages || Math.abs(p - page) <= 2);
const qs = (p: number) => `/catalog?page=${p}${ytOnly ? '&yt=1' : ''}`;
---
<Shell title={ytOnly ? 'Designs with a YouTube film | DigitalChiselCo' : 'Catalog — All STL Files | DigitalChiselCo'} scrollPastBanner={true}>
  <Breadcrumbs crumbs={ytOnly ? [{ label: 'Catalog', href: '/catalog' }, { label: 'With a YouTube film' }] : [{ label: 'Catalog' }]} />
  <h1 class="text-3xl mb-1">{ytOnly ? 'Designs with a film on YouTube' : 'Every design, in one place'}</h1>
  <p class="text-ink-700/70 text-sm mb-6">
    {ytOnly
      ? <>{total.toLocaleString()} designs you can watch first on our channel · <a href="/catalog" class="text-bronze-700 underline">show every design</a></>
      : <>{total.toLocaleString()} premium bas-relief STL files · ready for CNC, 3D print &amp; laser.</>}
  </p>

  <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4">
    {products.map((p) => <ProductCard product={p} discount={settings.discount_percent} />)}
  </div>

  {pages > 1 && (
    <nav class="flex justify-center items-center gap-2 mt-10 text-sm">
      {page > 1 && <a href={qs(page - 1)} class="px-3 py-1.5 border border-black/10 rounded">←</a>}
      {around.map((p, i) => (
        <Fragment>
          {i > 0 && p - around[i - 1] > 1 && <span class="px-1 text-ink-700/40">…</span>}
          <a href={qs(p)} class={`px-3 py-1.5 border rounded ${p === page ? 'bg-bronze-600 text-cream border-bronze-600' : 'border-black/10'}`}>{p}</a>
        </Fragment>
      ))}
      {page < pages && <a href={qs(page + 1)} class="px-3 py-1.5 border border-black/10 rounded">→</a>}
    </nav>
  )}
</Shell>
